+// Framebuffers and eDRAM
+
+int GfxRenderingAPIXenos::CreateFramebuffer() {
+    XenosFramebuffer fb;
+    fb.textureId = NewTexture();
+    mFramebuffers.push_back(fb);
+    return (int)mFramebuffers.size() - 1;
+}
+
+void GfxRenderingAPIXenos::UpdateFramebufferParameters(int fb_id, uint32_t width, uint32_t height,
+                                                       uint32_t msaa_level, bool opengl_invertY, bool render_target,
+                                                       bool has_depth_buffer, bool can_extract_depth) {
+    if (fb_id < 0 || fb_id >= (int)mFramebuffers.size()) {
+        return;
+    }
+    XenosFramebuffer& fb = mFramebuffers[fb_id];
+    width = std::max(width, 1u);
+    height = std::max(height, 1u);
+    if (fb.width != width || fb.height != height) {
+        if (mBoundFb == fb_id) {
+            ResolveBound(false);
+        }
+        fb.width = width;
+        fb.height = height;
+        fb.textureValid = false;
+    }
+    fb.hasDepth = has_depth_buffer;
+}
+
+void GfxRenderingAPIXenos::ResolveBound(bool keepBound) {
+    if (mBoundFb < 0) {
+        return;
+    }
+    XenosFramebuffer& fb = mFramebuffers[mBoundFb];
+    if (mBoundDirty) {
+        XenosTexture& t = Texture(fb.textureId);
+        if (!t.memory || t.width != fb.width || t.height != fb.height) {
+            CreateTextureStorage(t, XSDK_FORMAT_A8R8G8B8, fb.width, fb.height, true, 1);
+            t.linear = true;
+            t.addressU = t.addressV = XSDK_ADDRESS_CLAMP;
+            t.samplerDirty = true;
+        }
+        if (t.memory) {
+            // Keep eDRAM as it is when the framebuffer stays bound; clear it when leaving.
+            xsdk_gpu_set_resolve_clears(!keepBound, !keepBound);
+            Trace("resolve fb %d into texture %ux%u (keep %d)", mBoundFb, (unsigned)t.width, (unsigned)t.height,
+                  (int)keepBound);
+            xsdk_gpu_resolve_texture(&t.texture, 0xFF000000);
+            xsdk_gpu_set_resolve_clears(true, true);
+            fb.textureValid = true;
+            TraceSync("a framebuffer resolve");
+        }
+        mBoundDirty = false;
+    }
+    ResetDrawState();
+    if (keepBound) {
+        // A resolve takes the target away; set it again, eDRAM still holding the colour and depth.
+        xsdk_gpu_set_target(fb.width, fb.height);
+    } else {
+        mBoundFb = -1;
+    }
+}
+
+void GfxRenderingAPIXenos::BindTarget(int fbId) {
+    if (mBoundFb == fbId) {
+        return;
+    }
+    ResolveBound(false);
+    XenosFramebuffer& fb = mFramebuffers[fbId];
+    Trace("bind fb %d %ux%u (restore %d)", fbId, (unsigned)fb.width, (unsigned)fb.height, (int)fb.textureValid);
+    xsdk_gpu_set_target(fb.width, fb.height);
+    ResetDrawState();
+    mBoundFb = fbId;
+    mBoundDirty = false;
+    mTargetHeight = fb.height;
+    mNeedsRestore = fb.textureValid;
+}
+
+void GfxRenderingAPIXenos::DrawTexturedRect(const XenosTexture& tex, float u0, float v0, float u1, float v1,
+                                            float x0, float y0, float x1, float y1) {
+    // x and y in clip space, -1 to 1, y up.
+    const uint32_t white = 0xFFFFFFFF;
+    const UiVertex quad[4] = {
+        { x0, y0, u0, v1, white },
+        { x1, y0, u1, v1, white },
+        { x0, y1, u0, v0, white },
+        { x1, y1, u1, v0, white },
+    };
+    uint32_t address;
+    volatile uint32_t* mem = VertexSpace(sizeof quad, &address);
+    if (!mem) {
+        return;
+    }
+    WriteWords(mem, quad, sizeof quad);
+    xsdk_gpu_invalidate(address, sizeof quad);
+    xsdk_gpu_set_shaders(&mBlitVertex, &mBlitPixel);
+    xsdk_built_shader_set_literals(&ui_vert);
+    xsdk_built_shader_set_literals(&ui_frag);
+    const float push[8] = { 1, 1, 0, 0, 0, 0, 0, 0 };
+    xsdk_gpu_set_vertex_constants(UI_VERT_PUSH, push, UI_VERT_PUSH_REGISTERS);
+    xsdk_gpu_set_depth_stencil(&mDepthStates[0]);
+    xsdk_gpu_set_blend(&mBlendOff);
+    xsdk_gpu_set_raster(&mRasterNormal);
+    const XenosFramebuffer& fb = mFramebuffers[mBoundFb];
+    ZeldaMM_SetViewport(0, 0, (float)fb.width, (float)fb.height);
+    xsdk_gpu_set_scissor(0, 0, fb.width, fb.height);
+    xsdk_gpu_set_texture(UI_FRAG_SAMPLER_0_0, &tex.texture, &mCopySampler);
+    xsdk_gpu_set_vertices(0, address, sizeof quad);
+    Trace("textured rect %ux%u into fb %d", (unsigned)tex.width, (unsigned)tex.height, mBoundFb);
+    xsdk_gpu_draw(XSDK_PRIMITIVE_TRIANGLE_STRIP, 4);
+    ResetDrawState();
+    mBoundDirty = true;
+    TraceSync("a textured rect");
+}
+
+// zeldaMM: FXAA (xenos/fxaa.frag) over the screen's picture as the game's display list left it: eDRAM copied into the
+// screen's texture (kept bound, eDRAM as it was), then the texture drawn back through the shader over every pixel. A
+// copy of 720p and nine texture fetches a pixel; the screen's texture already exists for captures and restores. The
+// menu and the notifications draw after, untouched. gOot360.Fxaa, on unless cleared (test 1i: on by default, and run
+// where the game tags it, between the world and the overlay, Interpreter::ZeldaMM_FxaaBeforeOverlay).
+void GfxRenderingAPIXenos::PostProcessGame() {
+    if (!mFxaaLoaded || mGpuHung || mBoundFb != 0 ||
+        !Ship::Context::GetRawInstance()->GetConsoleVariables()->GetInteger("gOot360.Fxaa", 1)) {
+        return;
+    }
+    RestoreIfNeeded();
+    XenosFramebuffer& fb = mFramebuffers[0];
+    mBoundDirty = true;
+    ResolveBound(true);
+    const XenosTexture& t = Texture(fb.textureId);
+    if (!t.memory || !fb.textureValid || t.width != fb.width || t.height != fb.height) {
+        return;
+    }
+    const uint32_t white = 0xFFFFFFFF;
+    const UiVertex quad[4] = {
+        { -1, -1, 0, 1, white },
+        { 1, -1, 1, 1, white },
+        { -1, 1, 0, 0, white },
+        { 1, 1, 1, 0, white },
+    };
+    uint32_t address;
+    volatile uint32_t* mem = VertexSpace(sizeof quad, &address);
+    if (!mem) {
+        return;
+    }
+    WriteWords(mem, quad, sizeof quad);
+    xsdk_gpu_invalidate(address, sizeof quad);
+    xsdk_gpu_set_shaders(&mBlitVertex, &mFxaaPixel);
+    xsdk_built_shader_set_literals(&ui_vert);
+    xsdk_built_shader_set_literals(&fxaa_frag);
+    const float push[8] = { 1, 1, 0, 0, 0, 0, 0, 0 };
+    xsdk_gpu_set_vertex_constants(UI_VERT_PUSH, push, UI_VERT_PUSH_REGISTERS);
+    const float texel[4] = { 1.0f / (float)fb.width, 1.0f / (float)fb.height, 0.0f, 0.0f };
+    static_assert(FXAA_FRAG_PUSH_REGISTERS == 1, "fxaa.frag's Push block changed");
+    xsdk_gpu_set_pixel_constants(FXAA_FRAG_PUSH, texel, FXAA_FRAG_PUSH_REGISTERS);
+    xsdk_gpu_set_depth_stencil(&mDepthStates[0]);
+    xsdk_gpu_set_blend(&mBlendOff);
+    xsdk_gpu_set_raster(&mRasterNormal);
+    ZeldaMM_SetViewport(0, 0, (float)fb.width, (float)fb.height);
+    xsdk_gpu_set_scissor(0, 0, fb.width, fb.height);
+    xsdk_gpu_set_texture(FXAA_FRAG_SAMPLER_0_0, &t.texture, &mBlitSampler);
+    xsdk_gpu_set_vertices(0, address, sizeof quad);
+    Trace("FXAA %ux%u", (unsigned)fb.width, (unsigned)fb.height);
+    xsdk_gpu_draw(XSDK_PRIMITIVE_TRIANGLE_STRIP, 4);
+    ResetDrawState();
+    mBoundDirty = true;
+    TraceSync("the FXAA pass");
+}
+
+void GfxRenderingAPIXenos::RestoreIfNeeded() {
+    if (!mNeedsRestore) {
+        return;
+    }
+    mNeedsRestore = false;
+    const XenosFramebuffer& fb = mFramebuffers[mBoundFb];
+    const XenosTexture& t = Texture(fb.textureId);
+    if (t.memory) {
+        DrawTexturedRect(t, 0, 0, 1, 1, -1, -1, 1, 1);
+    }
+}
+
+void GfxRenderingAPIXenos::StartDrawToFramebuffer(int fbId, float noiseScale) {
+    if (fbId < 0 || fbId >= (int)mFramebuffers.size()) {
+        return;
+    }
+    if (noiseScale != 0.0f) {
+        mNoiseScale = 1.0f / noiseScale;
+    }
+    mCurrentFb = fbId;
+    BindTarget(fbId);
+}
+
+void GfxRenderingAPIXenos::ClearFramebuffer(bool color, bool depth) {
+    if (mGpuHung) {
+        return;
+    }
+    if (mBoundFb < 0) {
+        BindTarget(mCurrentFb);
+    }
+    if (color) {
+        mNeedsRestore = false;
+    } else {
+        RestoreIfNeeded();
+    }
+    const XenosFramebuffer& fb = mFramebuffers[mBoundFb];
+    // A quad at the far plane: black, depth 1, as the other backends clear.
+    const uint32_t black = 0xFF000000;
+    const UiVertex quad[4] = {
+        { -1, -1, 0, 0, black },
+        { 1, -1, 0, 0, black },
+        { -1, 1, 0, 0, black },
+        { 1, 1, 0, 0, black },
+    };
+    uint32_t address;
+    volatile uint32_t* mem = VertexSpace(sizeof quad, &address);
+    if (!mem) {
+        return;
+    }
+    WriteWords(mem, quad, sizeof quad);
+    xsdk_gpu_invalidate(address, sizeof quad);
+    static XsdkDepthStencilState depthAlways, depthNone;
+    static XsdkBlendState colorWrite, colorNone;
+    static bool made = false;
+    if (!made) {
+        made = true;
+        XsdkDepthStencil d = {};
+        d.depth_test = true;
+        d.depth_write = true;
+        d.depth_compare = XSDK_COMPARE_ALWAYS;
+        xsdk_gpu_depth_stencil_state(&depthAlways, &d);
+        d.depth_write = false;
+        d.depth_test = false;
+        xsdk_gpu_depth_stencil_state(&depthNone, &d);
+        XsdkBlend b = { XSDK_BLEND_ONE, XSDK_BLEND_ZERO, XSDK_BLEND_OP_ADD, XSDK_BLEND_ONE, XSDK_BLEND_ZERO,
+                        XSDK_BLEND_OP_ADD, XSDK_WRITE_ALL, false };
+        xsdk_gpu_blend_state(&colorWrite, &b);
+        b.write_mask = 0;
+        xsdk_gpu_blend_state(&colorNone, &b);
+    }
+    // The UI shader multiplies the vertex colour by a texel: white's, so the clear colour comes out as given.
+    const XenosTexture& any = Texture(mWhiteTexture);
+    xsdk_gpu_set_shaders(&mBlitVertex, &mBlitPixel);
+    xsdk_built_shader_set_literals(&ui_vert);
+    xsdk_built_shader_set_literals(&ui_frag);
+    const float push[8] = { 1, 1, 0, 0, 1, 0, 0, 0 };
+    xsdk_gpu_set_vertex_constants(UI_VERT_PUSH, push, UI_VERT_PUSH_REGISTERS);
+    xsdk_gpu_set_depth_stencil(depth && fb.hasDepth ? &depthAlways : &depthNone);
+    xsdk_gpu_set_blend(color ? &colorWrite : &colorNone);
+    xsdk_gpu_set_raster(&mRasterNormal);
+    ZeldaMM_SetViewport(0, 0, (float)fb.width, (float)fb.height);
+    xsdk_gpu_set_scissor(0, 0, fb.width, fb.height);
+    xsdk_gpu_set_texture(UI_FRAG_SAMPLER_0_0, &any.texture, &mBlitSampler);
+    xsdk_gpu_set_vertices(0, address, sizeof quad);
+    Trace("clear fb %d %ux%u color %d depth %d", mBoundFb, (unsigned)fb.width, (unsigned)fb.height, (int)color,
+          (int)depth);
+    xsdk_gpu_draw(XSDK_PRIMITIVE_TRIANGLE_STRIP, 4);
+    ResetDrawState();
+    mBoundDirty = true;
+    TraceSync("a clear");
+}
+
+void GfxRenderingAPIXenos::CopyFramebuffer(int fbDstId, int fbSrcId, int srcX0, int srcY0, int srcX1, int srcY1,
+                                           int dstX0, int dstY0, int dstX1, int dstY1) {
+    if (fbDstId < 0 || fbSrcId < 0 || fbDstId >= (int)mFramebuffers.size() ||
+        fbSrcId >= (int)mFramebuffers.size()) {
+        return;
+    }
+    const int previous = mCurrentFb;
+    // The source's colour must be in its texture.
+    if (mBoundFb == fbSrcId && mBoundDirty) {
+        ResolveBound(true);
+    }
+    XenosFramebuffer& src = mFramebuffers[fbSrcId];
+    const XenosTexture& st = Texture(src.textureId);
+    if (!st.memory || !src.textureValid) {
+        return;
+    }
+    BindTarget(fbDstId);
+    RestoreIfNeeded();
+    const XenosFramebuffer& dst = mFramebuffers[fbDstId];
+    // Rectangles from the top-left, as the Direct3D 11 backend takes them.
+    const float u0 = (float)srcX0 / src.width, u1 = (float)srcX1 / src.width;
+    const float v0 = (float)srcY0 / src.height, v1 = (float)srcY1 / src.height;
+    const float x0 = 2.0f * dstX0 / dst.width - 1.0f, x1 = 2.0f * dstX1 / dst.width - 1.0f;
+    const float y0 = 1.0f - 2.0f * dstY1 / dst.height, y1 = 1.0f - 2.0f * dstY0 / dst.height;
+    DrawTexturedRect(st, u0, v0, u1, v1, x0, y0, x1, y1);
+    if (previous != fbDstId) {
+        BindTarget(previous);
+    }
+}
+
+void GfxRenderingAPIXenos::ResolveMSAAColorBuffer(int fbIdTarget, int fbIdSrc) {
+    // No MSAA yet: a copy of the whole framebuffer.
+    if (fbIdTarget < 0 || fbIdSrc < 0 || fbIdTarget >= (int)mFramebuffers.size() ||
+        fbIdSrc >= (int)mFramebuffers.size()) {
+        return;
+    }
+    const XenosFramebuffer& s = mFramebuffers[fbIdSrc];
+    const XenosFramebuffer& d = mFramebuffers[fbIdTarget];
+    CopyFramebuffer(fbIdTarget, fbIdSrc, 0, 0, s.width, s.height, 0, 0, d.width, d.height);
+}
+
+void GfxRenderingAPIXenos::ReadFramebufferToCPU(int fbId, uint32_t width, uint32_t height, uint16_t* rgba16Buf) {
+    if (fbId < 0 || fbId >= (int)mFramebuffers.size()) {
+        return;
+    }
+    if (mBoundFb == fbId && mBoundDirty) {
+        ResolveBound(true);
+    }
+    const XenosFramebuffer& fb = mFramebuffers[fbId];
+    const XenosTexture& t = Texture(fb.textureId);
+    if (!t.memory || !fb.textureValid) {
+        memset(rgba16Buf, 0, width * height * 2);
+        return;
+    }
+    // Wait for the GPU to finish the resolve, then read the texture back (slow: write-combined memory).
+    if (mTimingGateClosed) {
+        mTimingValid = false;
+        TimingOpenGate();
+    }
+    xsdk_gpu_wait(xsdk_gpu_fence(), kFenceTimeoutMs);
+    std::vector<uint32_t> pixels((size_t)fb.width * fb.height);
+    xsdk_texture_download_rows(&t.texture, 0, 0, fb.height, pixels.data(), fb.width * 4);
+    for (uint32_t j = 0; j < height; j++) {
+        const uint32_t sy = j * fb.height / height;
+        for (uint32_t i = 0; i < width; i++) {
+            const uint32_t sx = i * fb.width / width;
+            const uint32_t p = pixels[(size_t)sy * fb.width + sx]; // 0xAARRGGBB
+            const uint32_t r = ((((p >> 16) & 0xFF) + 4) * 0x1F) / 0xFF;
+            const uint32_t g = ((((p >> 8) & 0xFF) + 4) * 0x1F) / 0xFF;
+            const uint32_t b = (((p & 0xFF) + 4) * 0x1F) / 0xFF;
+            const uint32_t a = (p >> 24) ? 1 : 0;
+            rgba16Buf[i + j * width] = (uint16_t)((r << 11) | (g << 6) | (b << 1) | a);
+        }
+    }
+}
+
+std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff>
+GfxRenderingAPIXenos::GetPixelDepth(int fb_id, const std::set<std::pair<float, float>>& coordinates) {
+    // Not read back yet: every point reads as far, so what the game tests for being hidden reads as visible.
+    std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff> res;
+    for (const auto& c : coordinates) {
+        res.emplace(c, (uint16_t)0xFFFC);
+    }
+    return res;
+}
+
+void* GfxRenderingAPIXenos::GetFramebufferTextureId(int fbId) {
+    if (fbId < 0 || fbId >= (int)mFramebuffers.size()) {
+        return nullptr;
+    }
+    return (void*)(uintptr_t)mFramebuffers[fbId].textureId;
+}
+
+void GfxRenderingAPIXenos::SelectTextureFb(int fbId) {
+    if (fbId < 0 || fbId >= (int)mFramebuffers.size()) {
+        return;
+    }
+    if (mBoundFb == fbId && mBoundDirty) {
+        ResolveBound(true);
+    }
+    SelectTexture(0, mFramebuffers[fbId].textureId);
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Drawing
+
+volatile uint32_t* GfxRenderingAPIXenos::VertexSpace(uint32_t bytes, uint32_t* address) {
+    bytes = (bytes + 63) & ~63u;
+    volatile uint32_t* ring = mVertexRing[mRingIndex];
+    if (!ring) {
+        return nullptr;
+    }
+    if (mVertexOffset + bytes > kVertexRingBytes) {
+        // This frame filled its part: wait for the GPU to finish what it queued, then start the part over.
+        mOverflowDraws++;
+        if (mTimingGateClosed) {
+            mTimingValid = false;
+            TimingOpenGate();
+        }
+        xsdk_gpu_wait(xsdk_gpu_fence(), kFenceTimeoutMs);
+        mVertexOffset = 0;
+    }
+    volatile uint32_t* mem = ring + mVertexOffset / 4;
+    *address = xsdk_gpu_address(mem);
+    mVertexOffset += bytes;
+    return mem;
+}
+
+void GfxRenderingAPIXenos::Trace(const char* format, ...) {
+    if (!Tracing()) {
+        return;
+    }
+    char line[256];
+    va_list args;
+    va_start(args, format);
+    vsnprintf(line, sizeof line, format, args);
+    va_end(args);
+    if (mCapture) {
+        CaptureRecord(1, line, (uint32_t)strlen(line));
+        return;
+    }
+    xsdk_log_write("xenos[f%llu]: %s", (unsigned long long)mFrame, line);
+}
+
+bool GfxRenderingAPIXenos::TraceSync(const char* step) {
+    if (mGpuHung) {
+        return false;
+    }
+    if (!Tracing()) {
+        return true;
+    }
+    if (mTimingGateClosed) {
+        mTimingValid = false;
+        TimingOpenGate();
+    }
+    const NTSTATUS s = xsdk_gpu_wait(xsdk_gpu_fence(), 1000);
+    if (!NT_SUCCESS(s)) {
+        mGpuHung = true;
+        xsdk_log_write("xenos[f%llu]: GPU HUNG after %s (0x%08X); no more GPU work this run, Back+Start quits",
+                       (unsigned long long)mFrame, step, (unsigned)s);
+        return false;
+    }
+    return true;
+}
+
+void GfxRenderingAPIXenos::DrawTriangles(float buf_vbo[], size_t buf_vbo_len, size_t buf_vbo_num_tris) {
+    if (mGpuHung) {
+        return;
+    }
+    ShaderProgram* prg = mCurrentShader;
+    if (!prg || !prg->vertex || buf_vbo_num_tris == 0) {
+        return;
+    }
+    if (mBoundFb < 0) {
+        BindTarget(mCurrentFb);
+    }
+    RestoreIfNeeded();
+
+    // Textures and the pixel shader variant they call for.
+    XenosTexture* tex[2] = { nullptr, nullptr };
+    uint32_t variant = prg->variant;
+    for (int t = 0; t < 2; t++) {
+        if (!prg->usedTextures[t]) {
+            continue;
+        }
+        XenosTexture& x = Texture(mCurrentTextureIds[t]);
+        if (!x.memory) {
+            continue;
+        }
+        ApplySampler(x);
+        tex[t] = &x;
+        if (x.threePoint) {
+            variant |= t == 0 ? XENOS_PS_TP0 : XENOS_PS_TP1;
+        }
+    }
+    // Texture 0's mask (tile 2) and blend (tile 4), as the interpreter imports them.
+    XenosTexture* mask0 = nullptr;
+    XenosTexture* blend0 = nullptr;
+    if (variant & XENOS_PS_MASK0) {
+        XenosTexture& m = Texture(mCurrentTextureIds[SHADER_FIRST_MASK_TEXTURE]);
+        XenosTexture& b = Texture(mCurrentTextureIds[SHADER_FIRST_REPLACEMENT_TEXTURE]);
+        if (m.memory && tex[0]) {
+            ApplySampler(m);
+            mask0 = &m;
+            if (b.memory) {
+                ApplySampler(b);
+                blend0 = &b;
+            }
+        } else {
+            variant &= ~XENOS_PS_MASK0;
+        }
+    }
+    const XsdkShader* pixel = &mPixelShaders[variant];
+
+    if (prg->vertex != mLastVertex || pixel != mLastPixel) {
+        xsdk_gpu_set_shaders(prg->vertex, pixel);
+        xsdk_built_shader_set_literals(&fast3d_vert);
+        xsdk_built_shader_set_literals(kPixelVariants[variant]);
+        mLastVertex = prg->vertex;
+        mLastPixel = pixel;
+    }
+
+    const int depthKey = (mCurrentDepthTest ? 4 : 0) | (mCurrentDepthMask ? 2 : 0) | (mCurrentZmodeDecal ? 1 : 0);
+    if (depthKey != mLastDepthKey) {
+        xsdk_gpu_set_depth_stencil(&mDepthStates[depthKey]);
+        mLastDepthKey = depthKey;
+    }
+    if ((int8_t)mUseAlpha != mLastBlend) {
+        xsdk_gpu_set_blend(mUseAlpha ? &mBlendAlpha : &mBlendOff);
+        mLastBlend = mUseAlpha;
+    }
+    if ((int8_t)mCurrentZmodeDecal != mLastDecal) {
+        xsdk_gpu_set_raster(mCurrentZmodeDecal ? &mRasterDecal : &mRasterNormal);
+        mLastDecal = mCurrentZmodeDecal;
+    }
+    if (mViewportDirty) {
+        // Signed: a viewport reaching above the target's top row is placed there, as Direct3D 11 does (unsigned, the
+        // top wrapped to 4 billion and the draw vanished).
+        ZeldaMM_SetViewport((float)mViewport[0], (float)((int)mTargetHeight - mViewport[1] - mViewport[3]),
+                            (float)mViewport[2], (float)mViewport[3]);
+        mViewportDirty = false;
+    }
+    if (mScissorDirty) {
+        int x = std::max(mScissor[0], 0);
+        int y = std::max((int)mTargetHeight - mScissor[1] - mScissor[3], 0);
+        int w = std::max(std::min(mScissor[0] + mScissor[2], (int)mFramebuffers[mBoundFb].width) - x, 0);
+        int h = std::max(std::min((int)mTargetHeight - mScissor[1], (int)mTargetHeight) - y, 0);
+        xsdk_gpu_set_scissor(x, y, w, h);
+        mScissorDirty = false;
+    }
+
+    // Constants: the combiner's, set once while draws keep to one program, then what this draw's textures and
+    // frame add (the first two pixel registers, the first vertex one).
+    if (prg != mConstProgram || variant != mConstVariant) {
+        xsdk_gpu_set_pixel_constants(FAST3D_V0_FRAG_PUSH + 2, prg->pixelConstants.opts0,
+                                     FAST3D_V0_FRAG_PUSH_REGISTERS - 2);
+        xsdk_gpu_set_vertex_constants(FAST3D_VERT_PUSH + 1, &prg->vertexConstants.w[0][0],
+                                      FAST3D_VERT_PUSH_REGISTERS - 1);
+        mConstProgram = prg;
+        mConstVariant = variant;
+    }
+    float perDraw[2][4];
+    for (int t = 0; t < 2; t++) {
+        perDraw[0][t * 2] = tex[t] ? (float)tex[t]->width : 1.0f;
+        perDraw[0][t * 2 + 1] = tex[t] ? (float)tex[t]->height : 1.0f;
+    }
+    perDraw[1][0] = (float)(mFrameCount % 150);
+    perDraw[1][1] = mNoiseScale;
+    perDraw[1][2] = prg->pixelConstants.misc[2];
+    perDraw[1][3] = prg->pixelConstants.misc[3];
+    xsdk_gpu_set_pixel_constants(FAST3D_V0_FRAG_PUSH, &perDraw[0][0], 2);
+    const float prim[4] = { prg->primDepth ? 1.0f : 0.0f, mCurrentPrimDepth, 0.0f, 0.0f };
+    xsdk_gpu_set_vertex_constants(FAST3D_VERT_PUSH, prim, 1);
+
+    // Each sampler gets a texture, the font's white where the combiner reads none (weighted by 0 then).
+    for (int t = 0; t < 2; t++) {
+        const XenosTexture* x = tex[t] ? tex[t] : &Texture(mWhiteTexture);
+        if (x->memory) {
+            // zeldaMM: where the shader clamps the coordinates, the base level alone (XenosTexture::samplerBase)
+            const bool clamped =
+                prg->pixelConstants.clamps[t * 2] != 0.0f || prg->pixelConstants.clamps[t * 2 + 1] != 0.0f;
+            xsdk_gpu_set_texture(t == 0 ? FAST3D_V0_FRAG_SAMPLER_0_0 : FAST3D_V0_FRAG_SAMPLER_0_1, &x->texture,
+                                 clamped && x->levels > 1 ? &x->samplerBase : &x->sampler);
+        }
+    }
+    if (mask0) {
+        // Both read at texture 0's coordinates: its clamp holds for them too.
+        const bool clamped0 = prg->pixelConstants.clamps[0] != 0.0f || prg->pixelConstants.clamps[1] != 0.0f;
+        xsdk_gpu_set_texture(FAST3D_V0_FRAG_SAMPLER_0_2, &mask0->texture,
+                             clamped0 && mask0->levels > 1 ? &mask0->samplerBase : &mask0->sampler);
+        // Without a blend the shader weighs it by 0 (opts1.w).
+        const XenosTexture* b = blend0 ? blend0 : &Texture(mWhiteTexture);
+        xsdk_gpu_set_texture(FAST3D_V0_FRAG_SAMPLER_0_3, &b->texture,
+                             clamped0 && b->levels > 1 ? &b->samplerBase : &b->sampler);
+    }
+
+    const uint32_t bytes = (uint32_t)(buf_vbo_len * sizeof(float));
+    uint32_t address;
+    volatile uint32_t* mem = VertexSpace(bytes, &address);
+    if (!mem) {
+        return;
+    }
+    WriteWords(mem, buf_vbo, bytes);
+    xsdk_gpu_invalidate(address, bytes);
+    xsdk_gpu_set_vertices(0, address, bytes);
+    Trace("draw %llu: shader %08llx:%08llx variant %u floats %u tris %u tex %ux%u %ux%u depth %d alpha %d "
+          "viewport %d,%d %dx%d scissor %d,%d %dx%d fb %d",
+          (unsigned long long)mDrawsThisFrame, (unsigned long long)(prg->shaderId0 & 0xFFFFFFFF),
+          (unsigned long long)(prg->shaderId1 & 0xFFFFFFFF), (unsigned)variant, (unsigned)prg->numFloats,
+          (unsigned)buf_vbo_num_tris, tex[0] ? tex[0]->width : 0, tex[0] ? tex[0]->height : 0,
+          tex[1] ? tex[1]->width : 0, tex[1] ? tex[1]->height : 0, depthKey, (int)mUseAlpha, mViewport[0],
+          mViewport[1], mViewport[2], mViewport[3], mScissor[0], mScissor[1], mScissor[2], mScissor[3], mBoundFb);
+    if (mCapture) {
+        struct {
+            uint32_t index, id0hi, id0lo, id1hi, id1lo, variant, numFloats, numTris, numInputs;
+            uint32_t used[2], texId[2], texW[2], texH[2], linear[2], threePoint[2], addrU[2], addrV[2];
+            int32_t depthKey, useAlpha, decal, fb, viewport[4], scissor[4];
+            uint32_t twoCycle, mayKill, vboFloats;
+        } d = {};
+        d.index = (uint32_t)mDrawsThisFrame;
+        d.id0hi = (uint32_t)(prg->shaderId0 >> 32);
+        d.id0lo = (uint32_t)prg->shaderId0;
+        d.id1hi = (uint32_t)(prg->shaderId1 >> 32);
+        d.id1lo = (uint32_t)prg->shaderId1;
+        d.variant = variant;
+        d.numFloats = prg->numFloats;
+        d.numTris = (uint32_t)buf_vbo_num_tris;
+        d.numInputs = prg->numInputs;
+        for (int t = 0; t < 2; t++) {
+            d.used[t] = prg->usedTextures[t];
+            d.texId[t] = tex[t] ? mCurrentTextureIds[t] : 0xFFFFFFFFu;
+            d.texW[t] = tex[t] ? tex[t]->width : 0;
+            d.texH[t] = tex[t] ? tex[t]->height : 0;
+            d.linear[t] = tex[t] ? tex[t]->linear : 0;
+            d.threePoint[t] = tex[t] ? tex[t]->threePoint : 0;
+            d.addrU[t] = tex[t] ? tex[t]->addressU : 0;
+            d.addrV[t] = tex[t] ? tex[t]->addressV : 0;
+            if (tex[t] && std::find(mCaptureTextures.begin(), mCaptureTextures.end(), mCurrentTextureIds[t]) ==
+                              mCaptureTextures.end()) {
+                mCaptureTextures.push_back(mCurrentTextureIds[t]);
+            }
+        }
+        d.depthKey = depthKey;
+        d.useAlpha = mUseAlpha;
+        d.decal = mCurrentZmodeDecal;
+        d.fb = mBoundFb;
+        memcpy(d.viewport, mViewport, sizeof d.viewport);
+        memcpy(d.scissor, mScissor, sizeof d.scissor);
+        d.twoCycle = prg->twoCycle;
+        d.mayKill = prg->mayKill;
+        // Up to 4096 triangles of vertices a draw.
+        d.vboFloats = (uint32_t)std::min<size_t>(buf_vbo_len, (size_t)prg->numFloats * 3 * 4096);
+        XenosPixelConstants k = prg->pixelConstants;
+        memcpy(k.sizes, perDraw[0], sizeof k.sizes);
+        memcpy(k.misc, perDraw[1], sizeof k.misc);
+        XenosVertexConstants kv = prg->vertexConstants;
+        memcpy(kv.prim, prim, sizeof kv.prim);
+        std::vector<uint8_t> rec(sizeof d + sizeof k + sizeof kv);
+        memcpy(rec.data(), &d, sizeof d);
+        memcpy(rec.data() + sizeof d, &k, sizeof k);
+        memcpy(rec.data() + sizeof d + sizeof k, &kv, sizeof kv);
+        CaptureRecord(2, rec.data(), (uint32_t)rec.size(), buf_vbo, d.vboFloats * 4);
+    }
+    xsdk_gpu_draw(XSDK_PRIMITIVE_TRIANGLE_LIST, (uint32_t)(3 * buf_vbo_num_tris));
+    mBoundDirty = true;
+    mDrawsThisFrame++;
+    TraceSync("a Fast3D draw");
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Frames
+
+void GfxRenderingAPIXenos::TimingOpenGate() {
+    if (!mTimingGateClosed) {
+        return;
+    }
+    mTimingMem[0] = mTimingTag;
+    __asm__ volatile("sync" ::: "memory");
+    mTimingGateClosed = false;
+}
+
+void GfxRenderingAPIXenos::TimingRead() {
+    if (!mTimingPending || !xsdk_gpu_fence_done(mTimingFence)) {
+        return;
+    }
+    mTimingPending = false;
+    const uint64_t start = xsdk_gpu_clock_value(mTimingMem + 4);
+    const uint64_t end = xsdk_gpu_clock_value(mTimingMem + 8);
+    if (end <= start) {
+        return;
+    }
+    const double ms = (double)(end - start) / 498.75 / 1000.0;
+    mTimingSamples++;
+    mTimingSumMs += ms;
+    mTimingMaxMs = std::max(mTimingMaxMs, ms);
+}
+
+void GfxRenderingAPIXenos::StartFrame() {
+    mFrameCount++;
+    mDrawsThisFrame = 0;
+    // Off unless gOot360.GpuTiming is set: holding the GPU back costs the timed frame its overlap with the CPU.
+    if (mTimingMem && !mTimingPending && !mTimingGateClosed && !Tracing() && mFrame % kTimingEvery == kTimingEvery / 2 &&
+        Ship::Context::GetRawInstance()->GetConsoleVariables()->GetInteger("gOot360.GpuTiming", 0)) {
+        mTimingTag++;
+        for (int i = 4; i < 12; i++) {
+            mTimingMem[i] = 0;
+        }
+        __asm__ volatile("sync" ::: "memory");
+        xsdk_gpu_wait_word(xsdk_gpu_address(mTimingMem), mTimingTag);
+        xsdk_gpu_write_clock(xsdk_gpu_address(mTimingMem + 4), false);
+        mTimingGateClosed = true;
+        mTimingValid = true;
+    }
+    // zeldaMM: no frames capture themselves (oot360 took frames 1500 and 3000, its title screen: here they fell in the
+    // intro, a 200-300 ms hitch each, test 1d); the player asks for one (L3+R3).
+    if (gXenosCaptureRequest.exchange(false) && !mCapture && !mGpuHung) {
+        char path[96];
+        snprintf(path, sizeof path, "game:\\oot360_capture_%llu.bin", (unsigned long long)mFrame);
+        mCapture = fopen(path, "wb");
+        xsdk_log_write("xenos: capturing frame %llu into %s: %s", (unsigned long long)mFrame, path,
+                       mCapture ? "open" : "could not open the file");
+        if (mCapture) {
+            static const char magic[8] = { 'O', 'O', 'T', 'C', 'A', 'P', '0', '1' };
+            fwrite(magic, 1, sizeof magic, mCapture);
+            // Version 2: a draw's pixel constants, then its vertex constants (XenosVertexConstants).
+            const uint32_t sizes[4] = { (uint32_t)sizeof(XenosPixelConstants), (uint32_t)mFrame, 2,
+                                        (uint32_t)sizeof(XenosVertexConstants) };
+            CaptureRecord(0, sizes, sizeof sizes);
+            mCaptureTextures.clear();
+        }
+    }
+}
+
+void GfxRenderingAPIXenos::CaptureRecord(uint32_t type, const void* a, uint32_t aBytes, const void* b,
+                                         uint32_t bBytes) {
+    if (!mCapture) {
+        return;
+    }
+    const uint32_t header[2] = { type, aBytes + bBytes };
+    fwrite(header, sizeof header, 1, mCapture);
+    if (aBytes) {
+        fwrite(a, 1, aBytes, mCapture);
+    }
+    if (bBytes) {
+        fwrite(b, 1, bBytes, mCapture);
+    }
+}
+
+// kind 0: a texture as uploaded (bytes R, G, B, A), 1: a framebuffer's resolve (A8R8G8B8).
+void GfxRenderingAPIXenos::CaptureTexture(uint32_t id, uint32_t kind) {
+    if (id >= mTextures.size()) {
+        return;
+    }
+    const XenosTexture& t = mTextures[id];
+    if (!t.memory || !t.width || !t.height) {
+        return;
+    }
+    std::vector<uint8_t> pixels((size_t)t.width * t.height * 4);
+    xsdk_texture_download_rows(&t.texture, 0, 0, t.height, pixels.data(), t.width * 4);
+    const uint32_t head[4] = { id, t.width, t.height, kind };
+    CaptureRecord(3, head, sizeof head, pixels.data(), (uint32_t)pixels.size());
+}
+
+void GfxRenderingAPIXenos::CaptureFinish() {
+    if (!mCapture) {
+        return;
+    }
+    xsdk_gpu_wait(xsdk_gpu_fence(), kFenceTimeoutMs);
+    for (uint32_t id : mCaptureTextures) {
+        CaptureTexture(id, 0);
+    }
+    if (!mFramebuffers.empty()) {
+        CaptureTexture(mFramebuffers[0].textureId, 1);
+    }
+    fclose(mCapture);
+    mCapture = nullptr;
+    xsdk_log_write("xenos: capture written (%u textures)", (unsigned)mCaptureTextures.size());
+}
+
+void GfxRenderingAPIXenos::EndFrame() {
+    Trace("end frame: %llu draws", (unsigned long long)mDrawsThisFrame);
+    if (mGpuHung) {
+        mFrame++;
+        return;
+    }
+    // The screen into the front buffer.
+    if (mBoundFb != 0) {
+        BindTarget(0);
+    }
+    RestoreIfNeeded();
+    if (mCapture && mBoundFb == 0) {
+        // The picture as drawn, into framebuffer 0's texture, eDRAM kept for the present.
+        mBoundDirty = true;
+        ResolveBound(true);
+    }
+    bool timed = false;
+    if (mTimingGateClosed) {
+        // Everything the frame draws is queued: the clock once the GPU has done it, then let the GPU go.
+        xsdk_gpu_write_clock(xsdk_gpu_address(mTimingMem + 8), true);
+        timed = mTimingValid;
+        mTimingDraws = (uint32_t)mDrawsThisFrame;
+        TimingOpenGate();
+    }
+    uint32_t address = 0;
+    // Waits for a front buffer to come off screen: at 60 fps, the vblank.
+    Oot360_Phase("xenos: present wait");
+    if (NT_SUCCESS(xsdk_present_begin(&address, kBeginTimeoutMs))) {
+        Trace("present into 0x%08X", (unsigned)address);
+        xsdk_gpu_resolve(address, mFramebuffers[0].width, mFramebuffers[0].height, 0xFF000000);
+        Oot360_Phase("xenos: pacing wait");
+        PaceFrame();
+        xsdk_present_end();
+        Oot360_Phase("xenos: after present");
+        TraceSync("the present resolve");
+    } else {
+        xsdk_log_write("xenos: no front buffer came free");
+        xsdk_gpu_resolve(xsdk_present_buffer_address(0), mFramebuffers[0].width, mFramebuffers[0].height,
+                         0xFF000000);
+    }
+    mBoundFb = -1;
+    mBoundDirty = false;
+    mFramebuffers[0].textureValid = false;
+    ResetDrawState();
+
+    const uint32_t fence = xsdk_gpu_fence();
+    if (timed) {
+        mTimingPending = true;
+        mTimingFence = fence;
+    }
+    TimingRead();
+    mFrameFence[mRingIndex] = fence;
+    mFenceOfFrame[mFrame] = fence;
+    mFrame++;
+    mRingIndex = (mRingIndex + 1) % kFramesInFlight;
+    // The ring part this frame takes was last used kFramesInFlight frames ago.
+    Oot360_Phase("xenos: wait for the GPU");
+    if (mFrameFence[mRingIndex]) {
+        xsdk_gpu_wait(mFrameFence[mRingIndex], kFenceTimeoutMs);
+    }
+    Oot360_Phase("xenos: frame end");
+    mVertexOffset = 0;
+    CaptureFinish();
+    GpuReclaim();
+
+    // A frame whose display list took over 25 ms, with what of it went to loading resources (a mod's XML display
+    // lists and vertices are parsed on first use) and to textures (decoding and uploading), for the hitches (test 20
+    // still had some). The first 300 only.
+    {
+        static uint64_t lastRun, lastTextures, lastLoad;
+        static uint32_t lastMisses, slowLogged;
+        const uint64_t run = gOot360Prof[0] - lastRun, textures = gOot360Prof[4] - lastTextures;
+        const uint64_t load = gOot360LoadTicks - lastLoad;
+        if (run > 25 * 49875 && slowLogged < 300) {
+            slowLogged++;
+            xsdk_log_write("xenos: slow frame %llu: display list %.1f ms, resources loaded %.1f ms (%u lookups missed), "
+                           "textures %.1f ms",
+                           (unsigned long long)mFrame, (double)run / 49875.0, (double)load / 49875.0,
+                           (unsigned)(gOot360ResourceMisses - lastMisses), (double)textures / 49875.0);
+        }
+        lastRun = gOot360Prof[0];
+        lastTextures = gOot360Prof[4];
+        lastLoad = gOot360LoadTicks;
+        lastMisses = gOot360ResourceMisses;
+        if ((mFrame % 600) == 0) {
+            // The block below starts these over.
+            lastRun = lastTextures = 0;
+            lastMisses = 0;
+        }
+    }
+
+    if ((mFrame % 600) == 0) {
+        XsdkPresentStats ps;
+        xsdk_present_stats(&ps);
+        const double now = mWindow->GetTime();
+        const double seconds = mLastLogTime > 0.0 ? now - mLastLogTime : 0.0;
+        const uint32_t vblanks = ps.vblanks - mLastStats.vblanks;
+        const uint32_t flips = ps.flips - mLastStats.flips;
+        // Busy: the time a frame took on the CPU and GPU, without the pacing wait.
+        const double busyMs = seconds > 0.0 ? (seconds * 1e6 - (double)mWaitUs) / 600.0 / 1000.0 : 0.0;
+        xsdk_log_write("xenos: frame %llu draws %llu shaders %u layouts %u pools %u overflows %u | %.1f fps "
+                       "(%u flips in %u vblanks), target %u fps, busy %.1f ms a frame, late %u",
+                       (unsigned long long)mFrame, (unsigned long long)mDrawsThisFrame, (unsigned)mShaderPool.size(),
+                       (unsigned)mVertexShaders.size(), (unsigned)mPools.size(), (unsigned)mOverflowDraws,
+                       seconds > 0.0 ? 600.0 / seconds : 0.0, (unsigned)flips, (unsigned)vblanks,
+                       (unsigned)mWindow->GetTargetFps(), busyMs, (unsigned)(ps.late - mLastStats.late));
+        // The interpreter's own split (interpreter.cpp, OOT360_PROF), ms a frame; nested slots overlap.
+        static const char* const names[7] = { "run", "vertices", "triangles", "draws", "textures", "matrices", "rects" };
+        char line[256];
+        int n = 0;
+        for (int i = 0; i < 7; i++) {
+            // zeldaMM: vertices, triangles, matrices and rectangles are timed one frame in eight (interpreter.cpp,
+            // Oot360ProfScope), the rest every frame
+            const double frames = (i == 0 || i == 3 || i == 4) ? 600.0 : 600.0 / 8.0;
+            n += snprintf(line + n, sizeof line - n, " %s %.2f", names[i], (double)gOot360Prof[i] / 49875.0 / frames);
+            gOot360Prof[i] = 0;
+        }
+        xsdk_log_write("xenos: interpreter ms a frame:%s", line);
+        // The display list opcodes that took longest, ms a frame and calls a frame.
+        {
+            int order[256];
+            for (int i = 0; i < 256; i++) {
+                order[i] = i;
+            }
+            std::sort(order, order + 256, [](int a, int b) { return gOot360OpTicks[a] > gOot360OpTicks[b]; });
+            int m = 0;
+            for (int k = 0; k < 10 && gOot360OpTicks[order[k]]; k++) {
+                const int op = order[k];
+                // zeldaMM: timed one frame in eight (interpreter.cpp, Run)
+                m += snprintf(line + m, sizeof line - m, " %02X %.2f/%u", op,
+                              (double)gOot360OpTicks[op] / 49875.0 / 75.0, (unsigned)(gOot360OpCount[op] / 75));
+            }
+            xsdk_log_write("xenos: opcodes, ms/calls a frame:%s", line);
+            static uint32_t lastGeneration;
+            const uint32_t generation = Oot360_ResourceGeneration();
+            xsdk_log_write("xenos: resource lookups missed %u, resource cache changed %u times (600 frames)",
+                           (unsigned)gOot360ResourceMisses, (unsigned)(generation - lastGeneration));
+            // How long the CPU waited for the GPU to free command stream space: the GPU behind the render thread.
+            static XsdkGpuStats lastGpu;
+            XsdkGpuStats gpu;
+            xsdk_gpu_stats(&gpu);
+            xsdk_log_write("xenos: CPU waited for the GPU %u times, %.2f ms a frame",
+                           (unsigned)(gpu.waits - lastGpu.waits),
+                           (double)(gpu.waited_us - lastGpu.waited_us) / 1000.0 / 600.0);
+            lastGpu = gpu;
+            // The VMX vertex transform: its per-call setup and its loop, and how many vertices and lights it had; and
+            // how many triangles reused the setup the one before worked out.
+            xsdk_log_write("xenos: vertices a frame %u, lights %.1f each, setup %.2f ms, loop %.2f ms (%.0f ns each); "
+                           "triangles a frame kept setup %u, full setup %u",
+                           (unsigned)(gOot360VtxCount / 600),
+                           gOot360VtxCount ? (double)gOot360VtxLightSum / gOot360VtxCount : 0.0,
+                           (double)gOot360VtxSetupTicks / 49875.0 / 600.0, (double)gOot360VtxLoopTicks / 49875.0 / 600.0,
+                           gOot360VtxCount ? (double)gOot360VtxLoopTicks * 20.05 / gOot360VtxCount : 0.0,
+                           (unsigned)(gOot360TriHits / 600), (unsigned)(gOot360TriMisses / 600));
+            {
+                // zeldaMM: why triangles went the full way, a frame, and what the plans lost were lost to (the most
+                // frequent six): the kept setup served 3% of them in test 1h, where runs of a material should keep it
+                char lost[192];
+                int ln = 0;
+                lost[0] = 0;
+                for (int k = 0; k < 6; k++) {
+                    int best = -1;
+                    for (int c = 0; c < 260; c++) {
+                        if (gOot360TriLostTo[c] != 0 && (best < 0 || gOot360TriLostTo[c] > gOot360TriLostTo[best])) {
+                            best = c;
+                        }
+                    }
+                    if (best < 0 || ln >= (int)sizeof lost - 24) {
+                        break;
+                    }
+                    if (best < 256) {
+                        ln += snprintf(lost + ln, sizeof lost - ln, " op %02X %u", (unsigned)best,
+                                       (unsigned)(gOot360TriLostTo[best] / 600));
+                    } else {
+                        ln += snprintf(lost + ln, sizeof lost - ln, " %s %u",
+                                       best == 256 ? "flush" : best == 257 ? "frame" : "?",
+                                       (unsigned)(gOot360TriLostTo[best] / 600));
+                    }
+                    gOot360TriLostTo[best] = 0;
+                }
+                xsdk_log_write("xenos: full setup a frame because: rect %u, off %u, no plan %u (culled %u, unkeepable "
+                               "%u), plan lost %u, texture 0 %u, texture 1 %u, viewport %u, check %u; lost to:%s",
+                               (unsigned)(gOot360TriWhy[0] / 600), (unsigned)(gOot360TriWhy[1] / 600),
+                               (unsigned)(gOot360TriWhy[2] / 600), (unsigned)(gOot360TriNoPlan[0] / 600),
+                               (unsigned)(gOot360TriNoPlan[1] / 600), (unsigned)(gOot360TriWhy[3] / 600),
+                               (unsigned)(gOot360TriWhy[4] / 600), (unsigned)(gOot360TriWhy[5] / 600),
+                               (unsigned)(gOot360TriWhy[6] / 600), (unsigned)(gOot360TriWhy[7] / 600), lost);
+                memset(gOot360TriWhy, 0, sizeof gOot360TriWhy);
+                memset(gOot360TriLostTo, 0, sizeof gOot360TriLostTo);
+                memset(gOot360TriNoPlan, 0, sizeof gOot360TriNoPlan);
+            }
+            // zeldaMM: the HD textures' imports and the frames' budget for them (interpreter.cpp,
+            // ZeldaMM_HdImportAllowed): held back, one waited a frame, the game's own drawn instead
+            xsdk_log_write("zeldaMM: HD textures imported %u (%.2f ms a frame, %.1f ms the most in one), held back %u "
+                           "times (600 frames)",
+                           (unsigned)gZeldaMMHdImports, (double)gZeldaMMHdImportTicks / 49875.0 / 600.0,
+                           (double)gZeldaMMHdImportFrameMost / 49875.0, (unsigned)gZeldaMMHdHeldBack);
+            gZeldaMMHdImports = gZeldaMMHdHeldBack = 0;
+            gZeldaMMHdImportTicks = gZeldaMMHdImportFrameMost = 0;
+            gOot360VtxSetupTicks = gOot360VtxLoopTicks = gOot360VtxCount = gOot360VtxLightSum = 0;
+            gOot360TriHits = gOot360TriMisses = 0;
+            gOot360ResourceMisses = 0;
+            lastGeneration = generation;
+            memset(gOot360OpTicks, 0, sizeof gOot360OpTicks);
+            memset(gOot360OpCount, 0, sizeof gOot360OpCount);
+        }
+        if (mTimingSamples) {
+            xsdk_log_write("xenos: GPU ms a frame (the GPU alone, %u frames): %.2f average, %.2f most; %u draws in the "
+                           "last one timed",
+                           (unsigned)mTimingSamples, mTimingSumMs / mTimingSamples, mTimingMaxMs,
+                           (unsigned)mTimingDraws);
+            mTimingSamples = 0;
+            mTimingSumMs = 0.0;
+            mTimingMaxMs = 0.0;
+        }
+        mLastStats = ps;
+        mLastLogTime = now;
+        mWaitUs = 0;
+    }
+}
+
+void GfxRenderingAPIXenos::PaceFrame() {
+    const uint32_t fps = mWindow->GetTargetFps();
+    // A frame shows from the vblank after xsdk_present_end for interval vblanks; 20 fps is 3, 30 is 2, 60 is 1.
+    uint32_t interval = fps > 0 ? (60 + fps / 2) / fps : 1;
+    interval = std::clamp<uint32_t>(interval, 1, 6);
+    XsdkPresentStats ps;
+    xsdk_present_stats(&ps);
+    if (mNextFlipVblank == 0 || ps.vblanks + 1 > mNextFlipVblank) {
+        // Late (or the first frame): show at the next vblank, as the N64 drops a frame when it can't keep up.
+        mNextFlipVblank = ps.vblanks + 1;
+    }
+    const auto start = std::chrono::steady_clock::now();
+    while (ps.vblanks + 1 < mNextFlipVblank) {
+        struct timespec ts = { 0, 1000000 };
+        nanosleep(&ts, nullptr);
+        xsdk_present_stats(&ps);
+    }
+    mWaitUs += (uint64_t)std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() -
+                                                                              start)
+                   .count();
+    mNextFlipVblank += interval;
+}
+
+void GfxRenderingAPIXenos::FinishRender() {
+}
