+// Dear ImGui's gamepad navigation from controller 1, read straight from XAM (the SDL2 platform backend needs a
+// window, which the console doesn't have).
+void XenosImGuiGamepad(ImGuiIO& io) {
+    INPUT_STATE st = {};
+    if (XamInputGetState(0, 0, &st) != ERROR_SUCCESS) {
+        io.BackendFlags &= ~ImGuiBackendFlags_HasGamepad;
+        return;
+    }
+    io.BackendFlags |= ImGuiBackendFlags_HasGamepad;
+    const uint16_t b = st.gamepad.buttons;
+    struct Map {
+        ImGuiKey key;
+        uint16_t mask;
+    } const maps[] = {
+        { ImGuiKey_GamepadStart, INPUT_GAMEPAD_START },     { ImGuiKey_GamepadBack, INPUT_GAMEPAD_BACK },
+        { ImGuiKey_GamepadFaceDown, INPUT_GAMEPAD_A },      { ImGuiKey_GamepadFaceRight, INPUT_GAMEPAD_B },
+        { ImGuiKey_GamepadFaceLeft, INPUT_GAMEPAD_X },      { ImGuiKey_GamepadFaceUp, INPUT_GAMEPAD_Y },
+        { ImGuiKey_GamepadDpadLeft, INPUT_GAMEPAD_DPAD_LEFT }, { ImGuiKey_GamepadDpadRight, INPUT_GAMEPAD_DPAD_RIGHT },
+        { ImGuiKey_GamepadDpadUp, INPUT_GAMEPAD_DPAD_UP },  { ImGuiKey_GamepadDpadDown, INPUT_GAMEPAD_DPAD_DOWN },
+        { ImGuiKey_GamepadL1, INPUT_GAMEPAD_LEFT_SHOULDER }, { ImGuiKey_GamepadR1, INPUT_GAMEPAD_RIGHT_SHOULDER },
+        { ImGuiKey_GamepadL3, INPUT_GAMEPAD_LEFT_THUMB },   { ImGuiKey_GamepadR3, INPUT_GAMEPAD_RIGHT_THUMB },
+    };
+    for (const Map& m : maps) {
+        io.AddKeyEvent(m.key, (b & m.mask) != 0);
+    }
+    io.AddKeyAnalogEvent(ImGuiKey_GamepadL2, st.gamepad.left_trigger > 64, st.gamepad.left_trigger / 255.0f);
+    io.AddKeyAnalogEvent(ImGuiKey_GamepadR2, st.gamepad.right_trigger > 64, st.gamepad.right_trigger / 255.0f);
+    auto axis = [&](ImGuiKey neg, ImGuiKey pos, int16_t v, bool invert) {
+        const float f = (invert ? -v : v) / 32767.0f;
+        const float dead = 0.25f;
+        io.AddKeyAnalogEvent(neg, f < -dead, f < -dead ? (-f - dead) / (1 - dead) : 0.0f);
+        io.AddKeyAnalogEvent(pos, f > dead, f > dead ? (f - dead) / (1 - dead) : 0.0f);
+    };
+    axis(ImGuiKey_GamepadLStickLeft, ImGuiKey_GamepadLStickRight, st.gamepad.thumb_lx, false);
+    axis(ImGuiKey_GamepadLStickUp, ImGuiKey_GamepadLStickDown, st.gamepad.thumb_ly, true);
+    axis(ImGuiKey_GamepadRStickLeft, ImGuiKey_GamepadRStickRight, st.gamepad.thumb_rx, false);
+    axis(ImGuiKey_GamepadRStickUp, ImGuiKey_GamepadRStickDown, st.gamepad.thumb_ry, true);
+
+    // What the menu's navigation sees, every second while a menu is open (test 11: it opened but didn't move).
+    static uint32_t frames = 0;
+    ImGuiContext* g = ImGui::GetCurrentContext();
+    if (g && (io.ConfigFlags & ImGuiConfigFlags_NavEnableGamepad) && (++frames % 60) == 0) {
+        xsdk_log_write("imgui nav: flags 0x%X backend 0x%X buttons 0x%04X lx %d ly %d window %s nav id 0x%08X "
+                       "active 0x%08X dt %.4f",
+                       (unsigned)io.ConfigFlags, (unsigned)io.BackendFlags, (unsigned)b, (int)st.gamepad.thumb_lx,
+                       (int)st.gamepad.thumb_ly, g->NavWindow ? g->NavWindow->Name : "none", (unsigned)g->NavId,
+                       (unsigned)g->ActiveId, (double)io.DeltaTime);
+    }
+}
