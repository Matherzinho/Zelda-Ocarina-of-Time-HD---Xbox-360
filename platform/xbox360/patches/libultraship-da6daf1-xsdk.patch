diff --git a/src/fast/backends/gfx_xenos.cpp b/src/fast/backends/gfx_xenos.cpp
new file mode 100644
index 0000000..6a40910
--- /dev/null
+++ b/src/fast/backends/gfx_xenos.cpp
@@ -0,0 +1,1914 @@
+#ifdef ENABLE_XENOS
+// Fast3D on the Xbox 360's Xenos GPU through xenosworks' xsdk.
+//
+// Framebuffers. Xenos draws only into eDRAM (10 MB), then resolves eDRAM into a texture or a front buffer. So one
+// Fast3D framebuffer at a time lives in eDRAM: the one bound. Switching to another resolves the bound one's colour
+// into its texture; drawing into a framebuffer again after that first draws its texture back ("restore"), unless the
+// first thing done is a colour clear. Depth survives only while the framebuffer stays bound. Framebuffer 0 is the
+// screen: EndFrame resolves it into the front buffer xsdk_present_begin gives.
+//
+// Shaders. One vertex shader for every combiner, its fetches patched per vertex layout (the interpreter packs each
+// vertex as its combiner needs); one pixel shader template in 16 variants (three-point filtering of each texture, the
+// second cycle, discard), the combiner itself in push constants (xenos/fast3d.frag).
+//
+// Coordinates follow the Direct3D 11 backend: depth 0 to 1, y up in clip space, viewports and scissors given from
+// the bottom-left and flipped here.
+
+#include "fast/backends/gfx_xenos.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdarg>
+#include <cstring>
+#include <ctime>
+
+#include <SDL2/SDL.h>
+#include <imgui.h>
+#include <spdlog/spdlog.h>
+
+extern "C" {
+#include <xsdk/kernel.h>
+#include <xsdk/log.h>
+}
+
+#include "libultraship_shaders.h" // fast3d.vert, fast3d_v0..127.frag, ui.vert, ui.frag (xsdk_add_shaders)
+
+#include "fast/interpreter.h"
+#include "libultraship/libultra/gbi.h"
+#include "ship/Context.h"
+#include "ship/config/ConsoleVariable.h"
+#include "fast/Fast3dGui.h"
+#include "fast/Fast3dWindow.h"
+
+extern "C" void Oot360_LogMemory(const char* where);
+extern "C" void Oot360_Phase(const char* phase);
+
+namespace Fast {
+
+std::atomic<bool> gXenosCaptureRequest{ false };
+} // namespace Fast
+extern "C" {
+uint64_t gOot360Prof[8];
+uint64_t gOot360OpTicks[256];
+uint32_t gOot360OpCount[256];
+extern uint32_t gOot360ResourceMisses;
+uint32_t Oot360_ResourceGeneration(void);
+}
+namespace Fast {
+
+namespace {
+
+constexpr uint32_t kBeginTimeoutMs = 5000;
+constexpr uint32_t kFenceTimeoutMs = 2000;
+constexpr uint32_t kPoolBytes = 16u << 20;
+constexpr uint32_t kTextureAlign = 4096;
+
+#define XENOS_VARIANT(n) &fast3d_v##n##_frag,
+const XsdkBuiltShader* const kPixelVariants[XENOS_PS_VARIANTS] = {
+#include "fast3d_variants.inc"
+};
+#undef XENOS_VARIANT
+
+// Every variant takes its push constants and samplers in the same registers (fast3d.frag declares them alike, and
+// xost lays out the whole block, its literals after it), so the constants a program set stay right across variants.
+#define XENOS_VARIANT(n)                                                                                             \
+    static_assert(FAST3D_V##n##_FRAG_PUSH == 0 && FAST3D_V##n##_FRAG_PUSH_REGISTERS * 16 == sizeof(XenosPixelConstants), \
+                  "fast3d.frag's Push block moved or changed");                                                      \
+    static_assert(FAST3D_V##n##_FRAG_SAMPLER_0_0 == 0 && FAST3D_V##n##_FRAG_SAMPLER_0_1 == 1 &&                 \
+                      FAST3D_V##n##_FRAG_SAMPLER_0_2 == 2 && FAST3D_V##n##_FRAG_SAMPLER_0_3 == 3,                  \
+                  "samplers moved");
+#include "fast3d_variants.inc"
+#undef XENOS_VARIANT
+static_assert(FAST3D_VERT_PUSH_REGISTERS * 16 == sizeof(XenosVertexConstants), "fast3d.vert's Push block changed");
+
+// The vertex the 2D shaders read (ui.vert): position, colour as 4 bytes, texture coordinates. ImDrawVert's layout.
+struct UiVertex {
+    float x, y;
+    float u, v;
+    uint32_t color; // IM_COL32: red in the low byte
+};
+static_assert(sizeof(UiVertex) == 20, "UiVertex must match ImDrawVert");
+
+const XsdkVertexElement kUiLayout[] = {
+    { .usage = XSDK_USAGE_POSITION, .usage_index = 0, .format = XSDK_VERTEX_FLOAT2, .stream = 0, .offset_bytes = 0 },
+    { .usage = XSDK_USAGE_TEXCOORD, .usage_index = 0, .format = XSDK_VERTEX_FLOAT2, .stream = 0, .offset_bytes = 8 },
+    { .usage = XSDK_USAGE_COLOR, .usage_index = 0, .format = XSDK_VERTEX_UBYTE4N, .stream = 0, .offset_bytes = 16 },
+};
+
+void WriteWords(volatile uint32_t* dst, const void* src, uint32_t bytes) {
+    const uint8_t* s = static_cast<const uint8_t*>(src);
+    const uint32_t words = bytes / 4;
+    for (uint32_t i = 0; i < words; i++) {
+        uint32_t w;
+        memcpy(&w, s + i * 4, 4);
+        dst[i] = w;
+    }
+}
+
+uint32_t AddressMode(uint32_t cm) {
+    switch (cm) {
+        case G_TX_NOMIRROR | G_TX_CLAMP:
+            return XSDK_ADDRESS_CLAMP;
+        case G_TX_MIRROR | G_TX_WRAP:
+            return XSDK_ADDRESS_MIRROR;
+        case G_TX_MIRROR | G_TX_CLAMP:
+            return XSDK_ADDRESS_MIRROR_ONCE;
+        case G_TX_NOMIRROR | G_TX_WRAP:
+        default:
+            return XSDK_ADDRESS_WRAP;
+    }
+}
+
+// Adds sign times the combiner source item to operand op's weights in the lanes from lane to lane + count - 1 (0-2
+// colour, 3 alpha): a source a vertex carries to the vertex shader's, one only a pixel has to the pixel shader's.
+void AddWeight(XenosVertexConstants& v, XenosPixelConstants& p, int op, int item, float sign, int lane, int count) {
+    float* w = nullptr;
+    switch (item) {
+        case SHADER_INPUT_1:
+        case SHADER_INPUT_2:
+        case SHADER_INPUT_3:
+        case SHADER_INPUT_4:
+        case SHADER_INPUT_5:
+        case SHADER_INPUT_6:
+        case SHADER_INPUT_7:
+            w = v.w[op * kXenosVertexSources + (item - SHADER_INPUT_1)];
+            break;
+        case SHADER_1:
+            w = v.w[op * kXenosVertexSources + 7];
+            break;
+        case SHADER_TEXEL0:
+            w = p.w[op * kXenosPixelSources + 0];
+            break;
+        case SHADER_TEXEL0A:
+            w = p.w[op * kXenosPixelSources + 1];
+            break;
+        case SHADER_TEXEL1:
+            w = p.w[op * kXenosPixelSources + 2];
+            break;
+        case SHADER_TEXEL1A:
+            w = p.w[op * kXenosPixelSources + 3];
+            break;
+        case SHADER_COMBINED:
+            w = p.w[op * kXenosPixelSources + 4];
+            break;
+        case SHADER_NOISE:
+            w = p.w[op * kXenosPixelSources + 5];
+            break;
+        case SHADER_0:
+        default:
+            return;
+    }
+    for (int i = lane; i < lane + count; i++) {
+        w[i] += sign;
+    }
+}
+
+// (a - b) * c + d for one channel set of one cycle: items[0..3] are a, b, c, d.
+void CycleWeights(XenosVertexConstants& v, XenosPixelConstants& p, int cycle, const int items[4], int lane,
+                  int count) {
+    AddWeight(v, p, cycle * 3 + 0, items[0], 1.0f, lane, count);
+    AddWeight(v, p, cycle * 3 + 0, items[1], -1.0f, lane, count);
+    AddWeight(v, p, cycle * 3 + 1, items[2], 1.0f, lane, count);
+    AddWeight(v, p, cycle * 3 + 2, items[3], 1.0f, lane, count);
+}
+
+uint64_t LayoutKey(const CCFeatures& cc) {
+    uint64_t k = cc.numInputs & 7;
+    k |= (uint64_t)cc.opt_alpha << 3;
+    k |= (uint64_t)cc.usedTextures[0] << 4;
+    k |= (uint64_t)cc.usedTextures[1] << 5;
+    k |= (uint64_t)cc.clamp[0][0] << 6;
+    k |= (uint64_t)cc.clamp[0][1] << 7;
+    k |= (uint64_t)cc.clamp[1][0] << 8;
+    k |= (uint64_t)cc.clamp[1][1] << 9;
+    k |= (uint64_t)cc.opt_fog << 10;
+    k |= (uint64_t)cc.opt_grayscale << 11;
+    return k;
+}
+
+} // namespace
