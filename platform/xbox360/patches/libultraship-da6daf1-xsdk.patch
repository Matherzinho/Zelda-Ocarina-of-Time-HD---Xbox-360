+bool GfxRenderingAPIXenos::CreateTextureStorage(XenosTexture& t, uint32_t format, uint32_t width, uint32_t height,
+                                                bool resolveTarget, uint32_t levels) {
+    // Memory the GPU may still read from goes back only once this frame's fence lands.
+    GpuFreeLater(t.memory, t.bytes);
+    t.memory = nullptr;
+    XsdkTexture tex = {};
+    if (!NT_SUCCESS(xsdk_texture_init(&tex, format, width, height, levels, true))) {
+        return false;
+    }
+    if (resolveTarget) {
+        // A resolve writes the base at the corner; a small texture's base would otherwise sit in the packed tail.
+        xsdk_texture_base_at_corner(&tex);
+    }
+    volatile uint32_t* mem = GpuAlloc(tex.size_bytes);
+    if (!mem) {
+        return false;
+    }
+    xsdk_texture_attach(&tex, mem);
+    t.texture = tex;
+    t.memory = mem;
+    t.bytes = tex.size_bytes;
+    t.width = (uint16_t)width;
+    t.height = (uint16_t)height;
+    t.levels = (uint8_t)levels;
+    t.samplerDirty = true;
+    return true;
+}
+
+namespace {
+// zeldaMM: 2^24 / a, rounded, for the 2x2 sums of alpha HalveRgba divides by (1 to 1020): a division a texel and
+// colour took some 1 ms a 256x256 texture on Xenon (review of test 1f's changes).
+struct HalveReciprocals {
+    uint32_t v[1021];
+    HalveReciprocals() {
+        v[0] = 0;
+        for (uint32_t a = 1; a <= 1020; a++) {
+            v[a] = ((1u << 24) + a / 2) / a;
+        }
+    }
+};
+const HalveReciprocals kHalveReciprocals;
+
+// zeldaMM: the next mip level of an RGBA8 image, each texel the average of the 2x2 above it weighted by their alpha
+// (a plain average darkens and tints a cut-out's edges with the colour of its transparent texels), an odd side's last
+// texel dropped as the GPU's level sizes halve. Four texels of one alpha (all opaque, all clear) average plainly.
+void HalveRgba(const uint8_t* src, uint32_t w, uint32_t h, uint8_t* dst, uint32_t nw, uint32_t nh) {
+    for (uint32_t y = 0; y < nh; y++) {
+        const uint32_t y0 = std::min(y * 2, h - 1), y1 = std::min(y * 2 + 1, h - 1);
+        const uint8_t* r0 = src + (size_t)y0 * w * 4;
+        const uint8_t* r1 = src + (size_t)y1 * w * 4;
+        uint8_t* q = dst + (size_t)y * nw * 4;
+        for (uint32_t x = 0; x < nw; x++, q += 4) {
+            const uint32_t x0 = std::min(x * 2, w - 1) * 4, x1 = std::min(x * 2 + 1, w - 1) * 4;
+            const uint8_t* p0 = r0 + x0;
+            const uint8_t* p1 = r0 + x1;
+            const uint8_t* p2 = r1 + x0;
+            const uint8_t* p3 = r1 + x1;
+            if (p0[3] == p1[3] && p0[3] == p2[3] && p0[3] == p3[3]) {
+                q[0] = (uint8_t)((p0[0] + p1[0] + p2[0] + p3[0] + 2) >> 2);
+                q[1] = (uint8_t)((p0[1] + p1[1] + p2[1] + p3[1] + 2) >> 2);
+                q[2] = (uint8_t)((p0[2] + p1[2] + p2[2] + p3[2] + 2) >> 2);
+                q[3] = p0[3];
+                continue;
+            }
+            const uint32_t a = p0[3] + p1[3] + p2[3] + p3[3]; // not 0: the alphas differ
+            const uint32_t r = kHalveReciprocals.v[a];
+            for (int c = 0; c < 3; c++) {
+                const uint32_t sum = p0[c] * p0[3] + p1[c] * p1[3] + p2[c] * p2[3] + p3[c] * p3[3];
+                // sum <= 255 * a, so sum * r + 2^23 stays below 2^32 (255 * 2^24 + 127.5 * a + 2^23)
+                q[c] = (uint8_t)std::min<uint32_t>((sum * r + (1u << 23)) >> 24, 255);
+            }
+            q[3] = (uint8_t)((a + 2) >> 2);
+        }
+    }
+}
+
+// zeldaMM: whether the next upload is an HD pack's texture, as the interpreter knows from its resource
+// (interpreter.cpp, ImportTexture).
+bool sNextUploadHd = false;
+} // namespace
+} // namespace Fast
+
+extern "C" void ZeldaMM_XenosNextUploadHd(bool hd) {
+    Fast::sNextUploadHd = hd;
+}
+
+extern "C" void ZeldaMM_XenosPostProcessGame(void) {
+    if (sZeldaMMXenos != nullptr) {
