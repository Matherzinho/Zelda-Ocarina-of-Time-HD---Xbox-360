+// Framebuffers and eDRAM
+
+int GfxRenderingAPIXenos::CreateFramebuffer() {
+    XenosFramebuffer fb;
+    fb.textureId = NewTexture();
+    mFramebuffers.push_back(fb);
+    return (int)mFramebuffers.size() - 1;
+}
+
+void GfxRenderingAPIXenos::UpdateFramebufferParameters(int fb_id, uint32_t width, uint32_t height,
+                                                       uint32_t msaa_level, bool opengl_invertY, bool render_target,
+                                                       bool has_depth_buffer, bool can_extract_depth) {
+    if (fb_id < 0 || fb_id >= (int)mFramebuffers.size()) {
+        return;
+    }
+    XenosFramebuffer& fb = mFramebuffers[fb_id];
+    width = std::max(width, 1u);
+    height = std::max(height, 1u);
+    if (fb.width != width || fb.height != height) {
+        if (mBoundFb == fb_id) {
+            ResolveBound(false);
+        }
+        fb.width = width;
+        fb.height = height;
+        fb.textureValid = false;
+    }
+    fb.hasDepth = has_depth_buffer;
+}
+
+void GfxRenderingAPIXenos::ResolveBound(bool keepBound) {
+    if (mBoundFb < 0) {
+        return;
+    }
+    XenosFramebuffer& fb = mFramebuffers[mBoundFb];
+    if (mBoundDirty) {
+        XenosTexture& t = Texture(fb.textureId);
+        if (!t.memory || t.width != fb.width || t.height != fb.height) {
+            CreateTextureStorage(t, XSDK_FORMAT_A8R8G8B8, fb.width, fb.height, true, 1);
+            t.linear = true;
+            t.addressU = t.addressV = XSDK_ADDRESS_CLAMP;
+            t.samplerDirty = true;
+        }
+        if (t.memory) {
+            // Keep eDRAM as it is when the framebuffer stays bound; clear it when leaving.
+            xsdk_gpu_set_resolve_clears(!keepBound, !keepBound);
+            Trace("resolve fb %d into texture %ux%u (keep %d)", mBoundFb, (unsigned)t.width, (unsigned)t.height,
+                  (int)keepBound);
+            xsdk_gpu_resolve_texture(&t.texture, 0xFF000000);
+            xsdk_gpu_set_resolve_clears(true, true);
+            fb.textureValid = true;
+            TraceSync("a framebuffer resolve");
+        }
+        mBoundDirty = false;
+    }
+    ResetDrawState();
+    if (keepBound) {
+        // A resolve takes the target away; set it again, eDRAM still holding the colour and depth.
+        xsdk_gpu_set_target(fb.width, fb.height);
+    } else {
+        mBoundFb = -1;
+    }
+}
+
+void GfxRenderingAPIXenos::BindTarget(int fbId) {
+    if (mBoundFb == fbId) {
+        return;
+    }
+    ResolveBound(false);
+    XenosFramebuffer& fb = mFramebuffers[fbId];
+    Trace("bind fb %d %ux%u (restore %d)", fbId, (unsigned)fb.width, (unsigned)fb.height, (int)fb.textureValid);
+    xsdk_gpu_set_target(fb.width, fb.height);
+    ResetDrawState();
+    mBoundFb = fbId;
+    mBoundDirty = false;
+    mTargetHeight = fb.height;
+    mNeedsRestore = fb.textureValid;
+}
+
+void GfxRenderingAPIXenos::DrawTexturedRect(const XenosTexture& tex, float u0, float v0, float u1, float v1,
+                                            float x0, float y0, float x1, float y1) {
+    // x and y in clip space, -1 to 1, y up.
+    const uint32_t white = 0xFFFFFFFF;
+    const UiVertex quad[4] = {
+        { x0, y0, u0, v1, white },
+        { x1, y0, u1, v1, white },
+        { x0, y1, u0, v0, white },
+        { x1, y1, u1, v0, white },
+    };
+    uint32_t address;
+    volatile uint32_t* mem = VertexSpace(sizeof quad, &address);
+    if (!mem) {
+        return;
+    }
+    WriteWords(mem, quad, sizeof quad);
+    xsdk_gpu_invalidate(address, sizeof quad);
+    xsdk_gpu_set_shaders(&mBlitVertex, &mBlitPixel);
+    xsdk_built_shader_set_literals(&ui_vert);
+    xsdk_built_shader_set_literals(&ui_frag);
+    const float push[8] = { 1, 1, 0, 0, 0, 0, 0, 0 };
+    xsdk_gpu_set_vertex_constants(UI_VERT_PUSH, push, UI_VERT_PUSH_REGISTERS);
+    xsdk_gpu_set_depth_stencil(&mDepthStates[0]);
+    xsdk_gpu_set_blend(&mBlendOff);
+    xsdk_gpu_set_raster(&mRasterNormal);
+    const XenosFramebuffer& fb = mFramebuffers[mBoundFb];
+    xsdk_gpu_set_viewport(0, 0, (float)fb.width, (float)fb.height, 0, 1);
+    xsdk_gpu_set_scissor(0, 0, fb.width, fb.height);
+    xsdk_gpu_set_texture(UI_FRAG_SAMPLER_0_0, &tex.texture, &mBlitSampler);
+    xsdk_gpu_set_vertices(0, address, sizeof quad);
+    Trace("textured rect %ux%u into fb %d", (unsigned)tex.width, (unsigned)tex.height, mBoundFb);
+    xsdk_gpu_draw(XSDK_PRIMITIVE_TRIANGLE_STRIP, 4);
+    ResetDrawState();
+    mBoundDirty = true;
+    TraceSync("a textured rect");
+}
+
+void GfxRenderingAPIXenos::RestoreIfNeeded() {
+    if (!mNeedsRestore) {
+        return;
+    }
+    mNeedsRestore = false;
+    const XenosFramebuffer& fb = mFramebuffers[mBoundFb];
+    const XenosTexture& t = Texture(fb.textureId);
+    if (t.memory) {
+        DrawTexturedRect(t, 0, 0, 1, 1, -1, -1, 1, 1);
+    }
+}
+
+void GfxRenderingAPIXenos::StartDrawToFramebuffer(int fbId, float noiseScale) {
+    if (fbId < 0 || fbId >= (int)mFramebuffers.size()) {
+        return;
+    }
+    if (noiseScale != 0.0f) {
+        mNoiseScale = 1.0f / noiseScale;
+    }
+    mCurrentFb = fbId;
+    BindTarget(fbId);
+}
+
+void GfxRenderingAPIXenos::ClearFramebuffer(bool color, bool depth) {
+    if (mGpuHung) {
+        return;
+    }
+    if (mBoundFb < 0) {
+        BindTarget(mCurrentFb);
+    }
+    if (color) {
+        mNeedsRestore = false;
+    } else {
+        RestoreIfNeeded();
+    }
+    const XenosFramebuffer& fb = mFramebuffers[mBoundFb];
+    // A quad at the far plane: black, depth 1, as the other backends clear.
+    const uint32_t black = 0xFF000000;
+    const UiVertex quad[4] = {
+        { -1, -1, 0, 0, black },
+        { 1, -1, 0, 0, black },
+        { -1, 1, 0, 0, black },
+        { 1, 1, 0, 0, black },
+    };
+    uint32_t address;
+    volatile uint32_t* mem = VertexSpace(sizeof quad, &address);
+    if (!mem) {
+        return;
+    }
+    WriteWords(mem, quad, sizeof quad);
+    xsdk_gpu_invalidate(address, sizeof quad);
+    static XsdkDepthStencilState depthAlways, depthNone;
+    static XsdkBlendState colorWrite, colorNone;
+    static bool made = false;
+    if (!made) {
+        made = true;
+        XsdkDepthStencil d = {};
+        d.depth_test = true;
+        d.depth_write = true;
+        d.depth_compare = XSDK_COMPARE_ALWAYS;
+        xsdk_gpu_depth_stencil_state(&depthAlways, &d);
+        d.depth_write = false;
+        d.depth_test = false;
+        xsdk_gpu_depth_stencil_state(&depthNone, &d);
+        XsdkBlend b = { XSDK_BLEND_ONE, XSDK_BLEND_ZERO, XSDK_BLEND_OP_ADD, XSDK_BLEND_ONE, XSDK_BLEND_ZERO,
+                        XSDK_BLEND_OP_ADD, XSDK_WRITE_ALL, false };
+        xsdk_gpu_blend_state(&colorWrite, &b);
+        b.write_mask = 0;
+        xsdk_gpu_blend_state(&colorNone, &b);
+    }
+    // The UI shader multiplies the vertex colour by a texel: white's, so the clear colour comes out as given.
+    const XenosTexture& any = Texture(mWhiteTexture);
+    xsdk_gpu_set_shaders(&mBlitVertex, &mBlitPixel);
+    xsdk_built_shader_set_literals(&ui_vert);
+    xsdk_built_shader_set_literals(&ui_frag);
+    const float push[8] = { 1, 1, 0, 0, 1, 0, 0, 0 };
+    xsdk_gpu_set_vertex_constants(UI_VERT_PUSH, push, UI_VERT_PUSH_REGISTERS);
+    xsdk_gpu_set_depth_stencil(depth && fb.hasDepth ? &depthAlways : &depthNone);
+    xsdk_gpu_set_blend(color ? &colorWrite : &colorNone);
+    xsdk_gpu_set_raster(&mRasterNormal);
+    xsdk_gpu_set_viewport(0, 0, (float)fb.width, (float)fb.height, 0, 1);
+    xsdk_gpu_set_scissor(0, 0, fb.width, fb.height);
+    xsdk_gpu_set_texture(UI_FRAG_SAMPLER_0_0, &any.texture, &mBlitSampler);
+    xsdk_gpu_set_vertices(0, address, sizeof quad);
+    Trace("clear fb %d %ux%u color %d depth %d", mBoundFb, (unsigned)fb.width, (unsigned)fb.height, (int)color,
+          (int)depth);
+    xsdk_gpu_draw(XSDK_PRIMITIVE_TRIANGLE_STRIP, 4);
+    ResetDrawState();
+    mBoundDirty = true;
+    TraceSync("a clear");
+}
+
+void GfxRenderingAPIXenos::CopyFramebuffer(int fbDstId, int fbSrcId, int srcX0, int srcY0, int srcX1, int srcY1,
+                                           int dstX0, int dstY0, int dstX1, int dstY1) {
+    if (fbDstId < 0 || fbSrcId < 0 || fbDstId >= (int)mFramebuffers.size() ||
+        fbSrcId >= (int)mFramebuffers.size()) {
+        return;
+    }
+    const int previous = mCurrentFb;
+    // The source's colour must be in its texture.
+    if (mBoundFb == fbSrcId && mBoundDirty) {
+        ResolveBound(true);
+    }
+    XenosFramebuffer& src = mFramebuffers[fbSrcId];
+    const XenosTexture& st = Texture(src.textureId);
+    if (!st.memory || !src.textureValid) {
+        return;
+    }
+    BindTarget(fbDstId);
+    RestoreIfNeeded();
+    const XenosFramebuffer& dst = mFramebuffers[fbDstId];
+    // Rectangles from the top-left, as the Direct3D 11 backend takes them.
+    const float u0 = (float)srcX0 / src.width, u1 = (float)srcX1 / src.width;
+    const float v0 = (float)srcY0 / src.height, v1 = (float)srcY1 / src.height;
+    const float x0 = 2.0f * dstX0 / dst.width - 1.0f, x1 = 2.0f * dstX1 / dst.width - 1.0f;
+    const float y0 = 1.0f - 2.0f * dstY1 / dst.height, y1 = 1.0f - 2.0f * dstY0 / dst.height;
+    DrawTexturedRect(st, u0, v0, u1, v1, x0, y0, x1, y1);
+    if (previous != fbDstId) {
+        BindTarget(previous);
+    }
+}
+
+void GfxRenderingAPIXenos::ResolveMSAAColorBuffer(int fbIdTarget, int fbIdSrc) {
+    // No MSAA yet: a copy of the whole framebuffer.
+    if (fbIdTarget < 0 || fbIdSrc < 0 || fbIdTarget >= (int)mFramebuffers.size() ||
+        fbIdSrc >= (int)mFramebuffers.size()) {
+        return;
+    }
+    const XenosFramebuffer& s = mFramebuffers[fbIdSrc];
+    const XenosFramebuffer& d = mFramebuffers[fbIdTarget];
+    CopyFramebuffer(fbIdTarget, fbIdSrc, 0, 0, s.width, s.height, 0, 0, d.width, d.height);
+}
+
+void GfxRenderingAPIXenos::ReadFramebufferToCPU(int fbId, uint32_t width, uint32_t height, uint16_t* rgba16Buf) {
+    if (fbId < 0 || fbId >= (int)mFramebuffers.size()) {
+        return;
+    }
+    if (mBoundFb == fbId && mBoundDirty) {
+        ResolveBound(true);
+    }
+    const XenosFramebuffer& fb = mFramebuffers[fbId];
+    const XenosTexture& t = Texture(fb.textureId);
+    if (!t.memory || !fb.textureValid) {
+        memset(rgba16Buf, 0, width * height * 2);
+        return;
+    }
+    // Wait for the GPU to finish the resolve, then read the texture back (slow: write-combined memory).
+    if (mTimingGateClosed) {
+        mTimingValid = false;
+        TimingOpenGate();
+    }
+    xsdk_gpu_wait(xsdk_gpu_fence(), kFenceTimeoutMs);
+    std::vector<uint32_t> pixels((size_t)fb.width * fb.height);
+    xsdk_texture_download_rows(&t.texture, 0, 0, fb.height, pixels.data(), fb.width * 4);
+    for (uint32_t j = 0; j < height; j++) {
+        const uint32_t sy = j * fb.height / height;
+        for (uint32_t i = 0; i < width; i++) {
+            const uint32_t sx = i * fb.width / width;
+            const uint32_t p = pixels[(size_t)sy * fb.width + sx]; // 0xAARRGGBB
+            const uint32_t r = ((((p >> 16) & 0xFF) + 4) * 0x1F) / 0xFF;
+            const uint32_t g = ((((p >> 8) & 0xFF) + 4) * 0x1F) / 0xFF;
+            const uint32_t b = (((p & 0xFF) + 4) * 0x1F) / 0xFF;
+            const uint32_t a = (p >> 24) ? 1 : 0;
+            rgba16Buf[i + j * width] = (uint16_t)((r << 11) | (g << 6) | (b << 1) | a);
+        }
+    }
+}
+
+std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff>
+GfxRenderingAPIXenos::GetPixelDepth(int fb_id, const std::set<std::pair<float, float>>& coordinates) {
+    // Not read back yet: every point reads as far, so what the game tests for being hidden reads as visible.
+    std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff> res;
+    for (const auto& c : coordinates) {
+        res.emplace(c, (uint16_t)0xFFFC);
+    }
+    return res;
+}
