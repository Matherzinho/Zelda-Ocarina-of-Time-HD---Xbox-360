new file mode 100644
index 00000000..d2d9e468
--- /dev/null
+++ b/cmake/dependencies/xsdk.cmake
@@ -0,0 +1,17 @@
+# Xbox 360 (xenosworks xsdk). SDL2 is sdl2-compat over SDL-xenon (SDL3 with renamed symbols), both static,
+# from the oot360 sysroot (platform/xbox360/deps). No OpenGL: rendering goes through the Xenos backend.
+if(NOT TARGET SDL2::SDL2)
+    add_library(SDL2::SDL2 INTERFACE IMPORTED GLOBAL)
+    set_target_properties(SDL2::SDL2 PROPERTIES
+        INTERFACE_INCLUDE_DIRECTORIES "${OOT360_SYSROOT}/include/SDL2;${OOT360_SYSROOT}/include"
+        INTERFACE_LINK_LIBRARIES "${OOT360_SYSROOT}/lib/libSDL2.a;${OOT360_SYSROOT}/lib/libSDL3X.a")
+endif()
+set(SDL2_INCLUDE_DIRS "${OOT360_SYSROOT}/include/SDL2")
+target_link_libraries(ImGui PUBLIC SDL2::SDL2)
+
+# ImGui renders through the Xenos backend; drop the OpenGL3 renderer backend common.cmake added.
+get_target_property(_imgui_sources ImGui SOURCES)
+list(FILTER _imgui_sources EXCLUDE REGEX "imgui_impl_opengl3")
+set_property(TARGET ImGui PROPERTY SOURCES ${_imgui_sources})
+# No shell to open links in (ImGui's default calls fork/execvp).
+target_compile_definitions(ImGui PRIVATE IMGUI_DISABLE_DEFAULT_SHELL_FUNCTIONS)
