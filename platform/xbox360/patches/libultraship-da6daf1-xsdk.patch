diff --git a/include/fast/backends/gfx_xenos.h b/include/fast/backends/gfx_xenos.h
new file mode 100644
index 00000000..3ed34902
--- /dev/null
+++ b/include/fast/backends/gfx_xenos.h
@@ -0,0 +1,388 @@
+#ifdef ENABLE_XENOS
+#pragma once
+
+// Fast3D on the Xbox 360's Xenos GPU through xenosworks' xsdk (homebrew, no Microsoft SDK). See
+// src/fast/backends/gfx_xenos.cpp for how framebuffers map onto eDRAM, and xenos/fast3d.frag for the combiner.
+
+#include "gfx_rendering_api.h"
+#include "gfx_window_manager_api.h"
+#include "../interpreter.h"
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <unordered_map>
+#include <vector>
+
+extern "C" {
+#include <xsdk/gpu.h>
+#include <xsdk/present.h>
+#include <xsdk/shader.h>
+#include <xsdk/texture.h>
+}
+
+struct ImDrawData;
+
+namespace Fast {
+
+// Set (by clicking both of the controller's sticks in) to have the renderer capture its next frame.
+extern std::atomic<bool> gXenosCaptureRequest;
+
+// Pixel shader variants, one bit each (gfx_xenos_shaders, built from xenos/fast3d.frag).
+enum XenosPixelVariant : uint32_t {
+    XENOS_PS_TP0 = 1,
+    XENOS_PS_TP1 = 2,
+    XENOS_PS_CYC2 = 4,
+    XENOS_PS_KILL = 8,
+    XENOS_PS_NOISE = 16,
+    XENOS_PS_T0 = 32,
+    XENOS_PS_T1 = 64,
+    XENOS_PS_MASK0 = 128,
+    XENOS_PS_VARIANTS = 256,
+};
+
+// The combiner's operands: per cycle a - b, c and d (fast3d.vert and fast3d.frag).
+constexpr int kXenosOperands = 6;
+// What the vertex shader weighs (inputs 1-7, the constant) and what the pixel shader does (texel0, texel0 alpha,
+// texel1, texel1 alpha, combined, noise).
+constexpr int kXenosVertexSources = 8;
+constexpr int kXenosPixelSources = 6;
+
+// fast3d.vert's push constants. Each weight: rgb the colour combiner's, a the alpha combiner's.
+struct XenosVertexConstants {
+    float prim[4];
+    float w[kXenosOperands * kXenosVertexSources][4];
+};
+
+// fast3d.frag's push constants; sizes and misc change a draw, the rest with the combiner.
+struct XenosPixelConstants {
+    float sizes[4];
+    float misc[4];
+    float opts0[4];
+    float opts1[4];
+    float clamps[4];
+    float w[kXenosOperands * kXenosPixelSources][4];
+};
+
+struct ShaderProgram {
+    uint64_t shaderId0;
+    uint64_t shaderId1;
+    uint8_t numInputs;
+    bool usedTextures[2];
+    uint8_t numFloats;
+    bool twoCycle;
+    bool mayKill;
+    bool primDepth;
+    XsdkShader* vertex;
+    // The variant bits the combiner decides (CYC2, KILL, NOISE, T0, T1); the textures add the filtering.
+    uint32_t variant;
+    // Everything in the constants that the combiner alone decides; per draw the backend adds prim depth, texture
+    // sizes and the frame's noise.
+    XenosVertexConstants vertexConstants;
+    XenosPixelConstants pixelConstants;
+};
+
+// A 2D texture in GPU memory, its sampler with it, as Fast3D sets filtering and wrapping per texture.
+struct XenosTexture {
+    XsdkTexture texture = {};
+    volatile uint32_t* memory = nullptr;
+    uint32_t bytes = 0;
+    uint16_t width = 0;
+    uint16_t height = 0;
+    uint8_t levels = 1; // zeldaMM: mip levels (UploadTexture)
+    bool hd = false;    // zeldaMM: an HD pack's texture (ZeldaMM_XenosNextUploadHd)
+    bool linear = false;
+    bool threePoint = false;
+    uint32_t addressU = 0;
+    uint32_t addressV = 0;
+    XsdkSamplerState sampler = {};
+    // zeldaMM: the same with the base level alone, for draws whose shader clamps the coordinates (the hardware then
+    // wraps, and a smaller level's filter would reach across to the far edge)
+    XsdkSamplerState samplerBase = {};
+    bool samplerDirty = true;
+};
+
+struct XenosFramebuffer {
+    uint32_t width = 0;
+    uint32_t height = 0;
+    bool hasDepth = false;
+    // The colour as last resolved out of eDRAM, sampled by copies, by the GUI and when the framebuffer is drawn to
+    // again after another one used eDRAM.
+    uint32_t textureId = 0;
+    bool textureValid = false;
+};
+
+class GfxWindowBackendXenos final : public GfxWindowBackend {
+  public:
+    GfxWindowBackendXenos() = default;
+    ~GfxWindowBackendXenos() override = default;
+
+    void Init(const char* gameName, const char* apiName, bool startFullScreen, uint32_t width, uint32_t height,
+              int32_t posX, int32_t posY) override;
+    void Close() override;
+    void SetKeyboardCallbacks(bool (*onKeyDown)(int scancode), bool (*onKeyUp)(int scancode),
+                              void (*onAllKeysUp)()) override;
+    void SetMouseCallbacks(bool (*onMouseButtonDown)(int btn), bool (*onMouseButtonUp)(int btn)) override;
+    void SetFullscreenChangedCallback(void (*onFullscreenChanged)(bool is_now_fullscreen)) override;
+    void SetFullscreen(bool fullscreen) override;
+    void GetActiveWindowRefreshRate(uint32_t* refreshRate) override;
+    void SetCursorVisibility(bool visibility) override;
+    void SetMousePos(int32_t posX, int32_t posY) override;
+    void GetMousePos(int32_t* x, int32_t* y) override;
+    void GetMouseDelta(int32_t* x, int32_t* y) override;
+    void GetMouseWheel(float* x, float* y) override;
+    bool GetMouseState(uint32_t btn) override;
+    void SetMouseCapture(bool capture) override;
+    bool IsMouseCaptured() override;
+    void GetDimensions(uint32_t* width, uint32_t* height, int32_t* posX, int32_t* posY) override;
+    void SetDimensions(uint32_t width, uint32_t height, int32_t posX, int32_t posY) override;
+    Ship::WindowRect GetPrimaryMonitorRect() override;
+    void HandleEvents() override;
+    bool IsFrameReady() override;
+    void SwapBuffersBegin() override;
+    void SwapBuffersEnd() override;
+    double GetTime() override;
+    int GetTargetFps() override;
+    void SetTargetFps(int fps) override;
+    void SetMaxFrameLatency(int latency) override;
+    const char* GetKeyName(int scancode) override;
+    bool CanDisableVsync() override;
+    bool IsRunning() override;
+    void Destroy() override;
+    bool IsFullscreen() override;
+
+    uint32_t DisplayWidth() const {
+        return mWidth;
+    }
+    uint32_t DisplayHeight() const {
+        return mHeight;
+    }
+
+  private:
+    uint32_t mWidth = 1280;
+    uint32_t mHeight = 720;
+    bool mOpen = false;
+    uint32_t mQuitHeldFrames = 0;
+    int mLoggedPads = -1;
+    bool mCaptureHeld = false;
+};
+
+class GfxRenderingAPIXenos final : public GfxRenderingAPI {
+  public:
+    explicit GfxRenderingAPIXenos(GfxWindowBackendXenos* window);
+    ~GfxRenderingAPIXenos() override;
+
+    const char* GetName() override;
+    int GetMaxTextureSize() override;
+    GfxClipParameters GetClipParameters() override;
+    void UnloadShader(ShaderProgram* oldPrg) override;
+    void LoadShader(ShaderProgram* newPrg) override;
+    void ClearShaderCache() override;
+    ShaderProgram* CreateAndLoadNewShader(uint64_t shaderId0, uint64_t shaderId1) override;
+    ShaderProgram* LookupShader(uint64_t shaderId0, uint64_t shaderId1) override;
+    void ShaderGetInfo(ShaderProgram* prg, uint8_t* numInputs, bool usedTextures[2]) override;
+    uint32_t NewTexture() override;
+    void SelectTexture(int tile, uint32_t textureId) override;
+    void UploadTexture(const uint8_t* rgba32Buf, uint32_t width, uint32_t height) override;
+    void SetSamplerParameters(int sampler, bool linear_filter, uint32_t cms, uint32_t cmt) override;
+    void SetDepthTestAndMask(bool depth_test, bool z_upd) override;
+    void SetZmodeDecal(bool decal) override;
+    void SetViewport(int x, int y, int width, int height) override;
+    void SetScissor(int x, int y, int width, int height) override;
+    void SetUseAlpha(bool useAlpha) override;
+    void DrawTriangles(float buf_vbo[], size_t buf_vbo_len, size_t buf_vbo_num_tris) override;
+    void Init() override;
+    void OnResize() override;
+    void StartFrame() override;
+    void EndFrame() override;
+    void FinishRender() override;
+    int CreateFramebuffer() override;
+    void UpdateFramebufferParameters(int fb_id, uint32_t width, uint32_t height, uint32_t msaa_level,
+                                     bool opengl_invertY, bool render_target, bool has_depth_buffer,
+                                     bool can_extract_depth) override;
+    void StartDrawToFramebuffer(int fbId, float noiseScale) override;
+    void CopyFramebuffer(int fbDstId, int fbSrcId, int srcX0, int srcY0, int srcX1, int srcY1, int dstX0, int dstY0,
+                         int dstX1, int dstY1) override;
+    void ClearFramebuffer(bool color, bool depth) override;
+    void ReadFramebufferToCPU(int fbId, uint32_t width, uint32_t height, uint16_t* rgba16Buf) override;
+    void ResolveMSAAColorBuffer(int fbIdTarget, int fbIdSrc) override;
+    std::unordered_map<std::pair<float, float>, uint16_t, hash_pair_ff>
+    GetPixelDepth(int fb_id, const std::set<std::pair<float, float>>& coordinates) override;
+    void* GetFramebufferTextureId(int fbId) override;
+    void SelectTextureFb(int fbId) override;
+    void DeleteTexture(uint32_t texId) override;
+    void SetTextureFilter(FilteringMode mode) override;
+    FilteringMode GetTextureFilter() override;
+    void SetSrgbMode() override;
+    ImTextureID GetTextureById(int id) override;
+    void SetCurrentPrimDepth(float depth) override;
+
+    // Dear ImGui on Xenos (Fast3dGui calls these for WindowBackend::FAST3D_XENOS).
+    void ImGuiInit();
+    void ImGuiNewFrame();
+    void ImGuiShutdown();
+    void ImGuiRenderDrawData(ImDrawData* data);
+
+    // zeldaMM: FXAA over the game's picture (gOot360.Fxaa), when the frame's display list is done and before the
+    // menu draws (interpreter.cpp through ZeldaMM_XenosPostProcessGame).
+    void PostProcessGame();
+
+  private:
+    struct GpuBlock {
+        volatile uint32_t* memory;
+        uint32_t bytes;
+        uint64_t frame;
+    };
+
+    // GPU memory: textures come from pools carved in 4 KB steps, since xsdk_gpu_alloc hands out 64 KB pages;
+    // what the GPU may still read waits for its frame's fence before it is reused.
+    volatile uint32_t* GpuAlloc(uint32_t bytes);
+    volatile uint32_t* GpuTakeFree(uint32_t bytes);                    // zeldaMM: out of a free range, or null
+    volatile uint32_t* GpuNewPool(uint32_t poolBytes, uint32_t bytes); // zeldaMM: a pool more, bytes taken from it
+    void GpuFreeLater(volatile uint32_t* memory, uint32_t bytes);
+    void GpuReclaim();
+    void GpuReturn(const GpuBlock& b); // zeldaMM: back into its pool's free ranges, merged with its neighbours
+
+    XenosTexture& Texture(uint32_t id);
+    void ApplySampler(XenosTexture& t);
+    bool CreateTextureStorage(XenosTexture& t, uint32_t format, uint32_t width, uint32_t height, bool resolveTarget,
+                              uint32_t levels = 1);
+
+    // eDRAM: one framebuffer at a time; its colour goes to its texture when another takes eDRAM.
+    void BindTarget(int fbId);
+    void ResolveBound(bool keepBound);
+    void RestoreIfNeeded();
+    void ResetDrawState();
+    void DrawTexturedRect(const XenosTexture& tex, float u0, float v0, float u1, float v1, float x0, float y0,
+                          float x1, float y1);
+
+    volatile uint32_t* VertexSpace(uint32_t bytes, uint32_t* address);
+
+    // The first frames are traced: each step logged, then the GPU waited for, so a hang names the step before it.
+    bool Tracing() const {
+        return mFrame < kTraceFrames || mCapture != nullptr;
+    }
+    void Trace(const char* format, ...) __attribute__((format(printf, 2, 3)));
+    bool TraceSync(const char* step);
+    static constexpr uint64_t kTraceFrames = 3;
+    bool mGpuHung = false;
+
+    // A frame capture (docs: tools/xenoscap): every draw with its constants, vertices and textures, the trace, and
+    // the picture, into game:\oot360_capture_<frame>.bin, for working out drawing faults away from the console.
+    void CaptureRecord(uint32_t type, const void* a, uint32_t aBytes, const void* b = nullptr, uint32_t bBytes = 0);
+    void CaptureTexture(uint32_t id, uint32_t kind);
+    void CaptureFinish();
+    FILE* mCapture = nullptr;
+    std::vector<uint32_t> mCaptureTextures;
+
+    XsdkShader* VertexShaderFor(const CCFeatures& cc, uint8_t* numFloats);
+    void BuildCombinerConstants(const CCFeatures& cc, ShaderProgram& prg);
+
+    GfxWindowBackendXenos* mWindow;
+
+    std::map<std::pair<uint64_t, uint64_t>, ShaderProgram> mShaderPool;
+    std::map<uint64_t, XsdkShader*> mVertexShaders;
+    XsdkShader mPixelShaders[XENOS_PS_VARIANTS] = {};
+    XsdkShader mBlitVertex = {};
+    XsdkShader mBlitPixel = {};
+    XsdkShader mFxaaPixel = {}; // zeldaMM: xenos/fxaa.frag
+    bool mFxaaLoaded = false;
+    XsdkShader mClearVertex = {};
+    XsdkShader mClearPixel = {};
+    XsdkShader mImGuiVertex = {};
+    XsdkShader mImGuiPixel = {};
+    ShaderProgram* mCurrentShader = nullptr;
+
+    std::vector<XenosTexture> mTextures;
+    std::vector<uint32_t> mFreeTextureIds;
+    uint32_t mCurrentTextureIds[SHADER_MAX_TEXTURES] = {};
+    int mCurrentTile = 0;
+    FilteringMode mFilterMode = FILTER_THREE_POINT;
+    std::vector<uint8_t> mMipScratch[2]; // zeldaMM: UploadTexture's mip levels
+
+    std::vector<XenosFramebuffer> mFramebuffers;
+    int mCurrentFb = 0;   // the framebuffer Fast3D draws to
+    int mBoundFb = -1;    // the one in eDRAM, its target set
+    bool mBoundDirty = false;
+    bool mNeedsRestore = false;
+    uint32_t mTargetHeight = 720;
+
+    // GPU state as last set, so draws only set what changed; a target change or resolve forgets it.
+    bool mStateValid = false;
+    bool mUseAlpha = false;
+    int8_t mLastDepthKey = -1;
+    int8_t mLastBlend = -1;
+    int8_t mLastDecal = -1;
+    const XsdkShader* mLastVertex = nullptr;
+    const XsdkShader* mLastPixel = nullptr;
+    // The program whose combiner constants the GPU holds, and the variant they went in with.
+    const ShaderProgram* mConstProgram = nullptr;
+    uint32_t mConstVariant = 0;
+    XsdkDepthStencilState mDepthStates[8] = {};
+    XsdkBlendState mBlendOff = {};
+    XsdkBlendState mBlendAlpha = {};
+    XsdkRasterState mRasterNormal = {};
+    XsdkRasterState mRasterDecal = {};
+    XsdkSamplerState mBlitSampler = {};
+    XsdkSamplerState mCopySampler = {}; // zeldaMM: point sampling, for copies and restores (DrawTexturedRect)
+    int mViewport[4] = { 0, 0, 1280, 720 };
+    int mScissor[4] = { 0, 0, 1280, 720 };
+    bool mViewportDirty = true;
+    bool mScissorDirty = true;
+
+    // Vertices: a ring per frame in flight, each frame's part freed by its fence.
+    static constexpr uint32_t kFramesInFlight = 2;
+    static constexpr uint32_t kVertexRingBytes = 6u << 20;
+    volatile uint32_t* mVertexRing[kFramesInFlight] = {};
+    uint32_t mVertexOffset = 0;
+    uint32_t mRingIndex = 0;
+    uint32_t mFrameFence[kFramesInFlight] = {};
+    uint64_t mFrame = 0;
+    uint32_t mOverflowDraws = 0;
+
+    struct Pool {
+        volatile uint32_t* base;
+        uint32_t bytes;
+        std::map<uint32_t, uint32_t> freeRanges; // offset -> size
+    };
+    std::vector<Pool> mPools;
+    uint64_t mBigPoolRetryFrame = 0;  // zeldaMM: no 16 MB pool tried before this frame (one failed lately)
+    uint64_t mReclaimFrame = ~0ull;   // zeldaMM: the frame GpuAlloc last waited for the GPU to take pending blocks back
+    std::vector<GpuBlock> mPendingFrees;
+    std::map<uint64_t, uint32_t> mFenceOfFrame;
+
+    // Frame pacing: each frame shows for 60 / the game's fps vblanks (SoH runs at 20 unless interpolating).
+    void PaceFrame();
+
+    // GPU time of a frame (oot360, test 13): every kTimingEvery frames the GPU waits at the frame's start for a word
+    // the CPU writes once the whole frame is queued, so the clocks around it time the GPU's work alone, not the CPU
+    // feeding it. A wait for the GPU inside the frame opens the gate early and drops that sample.
+    static constexpr uint32_t kTimingEvery = 240;
+    void TimingOpenGate();
+    void TimingRead();
+    volatile uint32_t* mTimingMem = nullptr;
+    uint32_t mTimingTag = 0;
+    bool mTimingGateClosed = false;
+    bool mTimingValid = false;
+    bool mTimingPending = false;
+    uint32_t mTimingFence = 0;
+    uint32_t mTimingSamples = 0;
+    double mTimingSumMs = 0.0;
+    double mTimingMaxMs = 0.0;
+    uint32_t mTimingDraws = 0;
+    uint32_t mNextFlipVblank = 0;
+    uint64_t mWaitUs = 0;
+    XsdkPresentStats mLastStats = {};
+    double mLastLogTime = 0.0;
+
+    float mNoiseScale = 1.0f;
+    uint32_t mFrameCount = 0;
+    uint32_t mFontTexture = 0;
+    uint32_t mWhiteTexture = 0;
+    uint64_t mDrawsThisFrame = 0;
+};
+
+} // namespace Fast
+
+#endif
