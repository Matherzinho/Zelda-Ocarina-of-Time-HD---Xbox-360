 void SDLAudioPlayer::DoPlay(const uint8_t* buf, size_t len) {
+#ifdef __XSDK__
+    // Every 5 s or so: how full SDL's queue is (stuck at the top means the device doesn't play it) and the loudest
+    // sample the game made (0 means the game makes silence).
+    static uint32_t calls, dropped;
+    static int peak;
+    const int16_t* samples = (const int16_t*)buf;
+    for (size_t i = 0; i < len / 2; i++) {
+        peak = std::max(peak, std::abs((int)samples[i]));
+    }
+    if (++calls % 300 == 0) {
+        SPDLOG_INFO("oot360: audio {} plays, queue {} frames, {} dropped, loudest {}, device status {}", calls,
+                    Buffered(), dropped, peak, (int)SDL_GetAudioDeviceStatus(mDevice));
+        peak = 0;
+    }
+    if (Buffered() >= 6000) {
+        dropped++;
+    }
+#endif
     if (Buffered() < 6000) {
         // Don't fill the audio buffer too much in case this happens
-        SDL_QueueAudio(mDevice, buf, len);
