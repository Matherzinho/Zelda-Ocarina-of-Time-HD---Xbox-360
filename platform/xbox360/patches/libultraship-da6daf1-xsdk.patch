+// ---------------------------------------------------------------------------------------------------------------
+// Drawing
+
+volatile uint32_t* GfxRenderingAPIXenos::VertexSpace(uint32_t bytes, uint32_t* address) {
+    bytes = (bytes + 63) & ~63u;
+    volatile uint32_t* ring = mVertexRing[mRingIndex];
+    if (!ring) {
+        return nullptr;
+    }
+    if (mVertexOffset + bytes > kVertexRingBytes) {
+        // This frame filled its part: wait for the GPU to finish what it queued, then start the part over.
+        mOverflowDraws++;
+        if (mTimingGateClosed) {
+            mTimingValid = false;
+            TimingOpenGate();
+        }
+        xsdk_gpu_wait(xsdk_gpu_fence(), kFenceTimeoutMs);
+        mVertexOffset = 0;
+    }
+    volatile uint32_t* mem = ring + mVertexOffset / 4;
+    *address = xsdk_gpu_address(mem);
+    mVertexOffset += bytes;
+    return mem;
+}
+
+void GfxRenderingAPIXenos::Trace(const char* format, ...) {
+    if (!Tracing()) {
+        return;
+    }
+    char line[256];
+    va_list args;
+    va_start(args, format);
+    vsnprintf(line, sizeof line, format, args);
+    va_end(args);
+    if (mCapture) {
+        CaptureRecord(1, line, (uint32_t)strlen(line));
+        return;
+    }
+    xsdk_log_write("xenos[f%llu]: %s", (unsigned long long)mFrame, line);
+}
+
+bool GfxRenderingAPIXenos::TraceSync(const char* step) {
+    if (mGpuHung) {
+        return false;
+    }
+    if (!Tracing()) {
+        return true;
+    }
+    if (mTimingGateClosed) {
+        mTimingValid = false;
+        TimingOpenGate();
+    }
+    const NTSTATUS s = xsdk_gpu_wait(xsdk_gpu_fence(), 1000);
+    if (!NT_SUCCESS(s)) {
+        mGpuHung = true;
+        xsdk_log_write("xenos[f%llu]: GPU HUNG after %s (0x%08X); no more GPU work this run, Back+Start quits",
+                       (unsigned long long)mFrame, step, (unsigned)s);
+        return false;
+    }
+    return true;
+}
+
+void GfxRenderingAPIXenos::DrawTriangles(float buf_vbo[], size_t buf_vbo_len, size_t buf_vbo_num_tris) {
+    if (mGpuHung) {
+        return;
+    }
+    ShaderProgram* prg = mCurrentShader;
+    if (!prg || !prg->vertex || buf_vbo_num_tris == 0) {
+        return;
+    }
+    if (mBoundFb < 0) {
+        BindTarget(mCurrentFb);
+    }
+    RestoreIfNeeded();
+
+    // Textures and the pixel shader variant they call for.
+    XenosTexture* tex[2] = { nullptr, nullptr };
+    uint32_t variant = prg->variant;
+    for (int t = 0; t < 2; t++) {
+        if (!prg->usedTextures[t]) {
+            continue;
+        }
+        XenosTexture& x = Texture(mCurrentTextureIds[t]);
+        if (!x.memory) {
+            continue;
+        }
+        ApplySampler(x);
+        tex[t] = &x;
+        if (x.threePoint) {
+            variant |= t == 0 ? XENOS_PS_TP0 : XENOS_PS_TP1;
+        }
+    }
+    // Texture 0's mask (tile 2) and blend (tile 4), as the interpreter imports them.
+    XenosTexture* mask0 = nullptr;
+    XenosTexture* blend0 = nullptr;
+    if (variant & XENOS_PS_MASK0) {
+        XenosTexture& m = Texture(mCurrentTextureIds[SHADER_FIRST_MASK_TEXTURE]);
+        XenosTexture& b = Texture(mCurrentTextureIds[SHADER_FIRST_REPLACEMENT_TEXTURE]);
+        if (m.memory && tex[0]) {
+            ApplySampler(m);
+            mask0 = &m;
+            if (b.memory) {
+                ApplySampler(b);
+                blend0 = &b;
+            }
+        } else {
+            variant &= ~XENOS_PS_MASK0;
+        }
+    }
+    const XsdkShader* pixel = &mPixelShaders[variant];
+
+    if (prg->vertex != mLastVertex || pixel != mLastPixel) {
+        xsdk_gpu_set_shaders(prg->vertex, pixel);
+        xsdk_built_shader_set_literals(&fast3d_vert);
+        xsdk_built_shader_set_literals(kPixelVariants[variant]);
+        mLastVertex = prg->vertex;
+        mLastPixel = pixel;
+    }
+
+    const int depthKey = (mCurrentDepthTest ? 4 : 0) | (mCurrentDepthMask ? 2 : 0) | (mCurrentZmodeDecal ? 1 : 0);
+    if (depthKey != mLastDepthKey) {
+        xsdk_gpu_set_depth_stencil(&mDepthStates[depthKey]);
+        mLastDepthKey = depthKey;
+    }
+    if ((int8_t)mUseAlpha != mLastBlend) {
+        xsdk_gpu_set_blend(mUseAlpha ? &mBlendAlpha : &mBlendOff);
+        mLastBlend = mUseAlpha;
+    }
+    if ((int8_t)mCurrentZmodeDecal != mLastDecal) {
+        xsdk_gpu_set_raster(mCurrentZmodeDecal ? &mRasterDecal : &mRasterNormal);
+        mLastDecal = mCurrentZmodeDecal;
+    }
+    if (mViewportDirty) {
+        xsdk_gpu_set_viewport((float)mViewport[0], (float)(mTargetHeight - mViewport[1] - mViewport[3]),
+                              (float)mViewport[2], (float)mViewport[3], 0.0f, 1.0f);
+        mViewportDirty = false;
+    }
+    if (mScissorDirty) {
+        int x = std::max(mScissor[0], 0);
+        int y = std::max((int)mTargetHeight - mScissor[1] - mScissor[3], 0);
+        int w = std::max(std::min(mScissor[0] + mScissor[2], (int)mFramebuffers[mBoundFb].width) - x, 0);
+        int h = std::max(std::min((int)mTargetHeight - mScissor[1], (int)mTargetHeight) - y, 0);
+        xsdk_gpu_set_scissor(x, y, w, h);
+        mScissorDirty = false;
+    }
+
+    // Constants: the combiner's, set once while draws keep to one program, then what this draw's textures and
+    // frame add (the first two pixel registers, the first vertex one).
+    if (prg != mConstProgram || variant != mConstVariant) {
+        xsdk_gpu_set_pixel_constants(FAST3D_V0_FRAG_PUSH + 2, prg->pixelConstants.opts0,
+                                     FAST3D_V0_FRAG_PUSH_REGISTERS - 2);
+        xsdk_gpu_set_vertex_constants(FAST3D_VERT_PUSH + 1, &prg->vertexConstants.w[0][0],
+                                      FAST3D_VERT_PUSH_REGISTERS - 1);
+        mConstProgram = prg;
+        mConstVariant = variant;
+    }
+    float perDraw[2][4];
+    for (int t = 0; t < 2; t++) {
+        perDraw[0][t * 2] = tex[t] ? (float)tex[t]->width : 1.0f;
+        perDraw[0][t * 2 + 1] = tex[t] ? (float)tex[t]->height : 1.0f;
+    }
+    perDraw[1][0] = (float)(mFrameCount % 150);
+    perDraw[1][1] = mNoiseScale;
+    perDraw[1][2] = prg->pixelConstants.misc[2];
+    perDraw[1][3] = prg->pixelConstants.misc[3];
+    xsdk_gpu_set_pixel_constants(FAST3D_V0_FRAG_PUSH, &perDraw[0][0], 2);
+    const float prim[4] = { prg->primDepth ? 1.0f : 0.0f, mCurrentPrimDepth, 0.0f, 0.0f };
+    xsdk_gpu_set_vertex_constants(FAST3D_VERT_PUSH, prim, 1);
+
+    // Each sampler gets a texture, the font's white where the combiner reads none (weighted by 0 then).
+    for (int t = 0; t < 2; t++) {
+        const XenosTexture* x = tex[t] ? tex[t] : &Texture(mWhiteTexture);
+        if (x->memory) {
+            xsdk_gpu_set_texture(t == 0 ? FAST3D_V0_FRAG_SAMPLER_0_0 : FAST3D_V0_FRAG_SAMPLER_0_1, &x->texture,
+                                 &x->sampler);
+        }
+    }
+    if (mask0) {
+        xsdk_gpu_set_texture(FAST3D_V0_FRAG_SAMPLER_0_2, &mask0->texture, &mask0->sampler);
+        // Without a blend the shader weighs it by 0 (opts1.w).
+        const XenosTexture* b = blend0 ? blend0 : &Texture(mWhiteTexture);
+        xsdk_gpu_set_texture(FAST3D_V0_FRAG_SAMPLER_0_3, &b->texture, &b->sampler);
+    }
+
+    const uint32_t bytes = (uint32_t)(buf_vbo_len * sizeof(float));
+    uint32_t address;
+    volatile uint32_t* mem = VertexSpace(bytes, &address);
+    if (!mem) {
+        return;
+    }
+    WriteWords(mem, buf_vbo, bytes);
+    xsdk_gpu_invalidate(address, bytes);
+    xsdk_gpu_set_vertices(0, address, bytes);
+    Trace("draw %llu: shader %08llx:%08llx variant %u floats %u tris %u tex %ux%u %ux%u depth %d alpha %d "
+          "viewport %d,%d %dx%d scissor %d,%d %dx%d fb %d",
+          (unsigned long long)mDrawsThisFrame, (unsigned long long)(prg->shaderId0 & 0xFFFFFFFF),
+          (unsigned long long)(prg->shaderId1 & 0xFFFFFFFF), (unsigned)variant, (unsigned)prg->numFloats,
+          (unsigned)buf_vbo_num_tris, tex[0] ? tex[0]->width : 0, tex[0] ? tex[0]->height : 0,
+          tex[1] ? tex[1]->width : 0, tex[1] ? tex[1]->height : 0, depthKey, (int)mUseAlpha, mViewport[0],
+          mViewport[1], mViewport[2], mViewport[3], mScissor[0], mScissor[1], mScissor[2], mScissor[3], mBoundFb);
+    if (mCapture) {
+        struct {
+            uint32_t index, id0hi, id0lo, id1hi, id1lo, variant, numFloats, numTris, numInputs;
+            uint32_t used[2], texId[2], texW[2], texH[2], linear[2], threePoint[2], addrU[2], addrV[2];
+            int32_t depthKey, useAlpha, decal, fb, viewport[4], scissor[4];
+            uint32_t twoCycle, mayKill, vboFloats;
+        } d = {};
+        d.index = (uint32_t)mDrawsThisFrame;
+        d.id0hi = (uint32_t)(prg->shaderId0 >> 32);
+        d.id0lo = (uint32_t)prg->shaderId0;
+        d.id1hi = (uint32_t)(prg->shaderId1 >> 32);
+        d.id1lo = (uint32_t)prg->shaderId1;
+        d.variant = variant;
+        d.numFloats = prg->numFloats;
+        d.numTris = (uint32_t)buf_vbo_num_tris;
+        d.numInputs = prg->numInputs;
+        for (int t = 0; t < 2; t++) {
+            d.used[t] = prg->usedTextures[t];
+            d.texId[t] = tex[t] ? mCurrentTextureIds[t] : 0xFFFFFFFFu;
+            d.texW[t] = tex[t] ? tex[t]->width : 0;
+            d.texH[t] = tex[t] ? tex[t]->height : 0;
+            d.linear[t] = tex[t] ? tex[t]->linear : 0;
+            d.threePoint[t] = tex[t] ? tex[t]->threePoint : 0;
+            d.addrU[t] = tex[t] ? tex[t]->addressU : 0;
+            d.addrV[t] = tex[t] ? tex[t]->addressV : 0;
+            if (tex[t] && std::find(mCaptureTextures.begin(), mCaptureTextures.end(), mCurrentTextureIds[t]) ==
+                              mCaptureTextures.end()) {
+                mCaptureTextures.push_back(mCurrentTextureIds[t]);
+            }
+        }
+        d.depthKey = depthKey;
+        d.useAlpha = mUseAlpha;
+        d.decal = mCurrentZmodeDecal;
+        d.fb = mBoundFb;
+        memcpy(d.viewport, mViewport, sizeof d.viewport);
+        memcpy(d.scissor, mScissor, sizeof d.scissor);
+        d.twoCycle = prg->twoCycle;
+        d.mayKill = prg->mayKill;
+        // Up to 4096 triangles of vertices a draw.
+        d.vboFloats = (uint32_t)std::min<size_t>(buf_vbo_len, (size_t)prg->numFloats * 3 * 4096);
+        XenosPixelConstants k = prg->pixelConstants;
+        memcpy(k.sizes, perDraw[0], sizeof k.sizes);
+        memcpy(k.misc, perDraw[1], sizeof k.misc);
+        XenosVertexConstants kv = prg->vertexConstants;
+        memcpy(kv.prim, prim, sizeof kv.prim);
+        std::vector<uint8_t> rec(sizeof d + sizeof k + sizeof kv);
+        memcpy(rec.data(), &d, sizeof d);
+        memcpy(rec.data() + sizeof d, &k, sizeof k);
+        memcpy(rec.data() + sizeof d + sizeof k, &kv, sizeof kv);
+        CaptureRecord(2, rec.data(), (uint32_t)rec.size(), buf_vbo, d.vboFloats * 4);
+    }
+    xsdk_gpu_draw(XSDK_PRIMITIVE_TRIANGLE_LIST, (uint32_t)(3 * buf_vbo_num_tris));
+    mBoundDirty = true;
+    mDrawsThisFrame++;
+    TraceSync("a Fast3D draw");
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// Frames
+
+void GfxRenderingAPIXenos::TimingOpenGate() {
+    if (!mTimingGateClosed) {
+        return;
+    }
+    mTimingMem[0] = mTimingTag;
+    __asm__ volatile("sync" ::: "memory");
+    mTimingGateClosed = false;
+}
+
+void GfxRenderingAPIXenos::TimingRead() {
+    if (!mTimingPending || !xsdk_gpu_fence_done(mTimingFence)) {
+        return;
+    }
+    mTimingPending = false;
+    const uint64_t start = xsdk_gpu_clock_value(mTimingMem + 4);
+    const uint64_t end = xsdk_gpu_clock_value(mTimingMem + 8);
+    if (end <= start) {
+        return;
+    }
+    const double ms = (double)(end - start) / 498.75 / 1000.0;
+    mTimingSamples++;
+    mTimingSumMs += ms;
+    mTimingMaxMs = std::max(mTimingMaxMs, ms);
+}
+
+void GfxRenderingAPIXenos::StartFrame() {
+    mFrameCount++;
+    mDrawsThisFrame = 0;
+    // Off unless gOot360.GpuTiming is set: holding the GPU back costs the timed frame its overlap with the CPU.
+    if (mTimingMem && !mTimingPending && !mTimingGateClosed && !Tracing() && mFrame % kTimingEvery == kTimingEvery / 2 &&
+        Ship::Context::GetRawInstance()->GetConsoleVariables()->GetInteger("gOot360.GpuTiming", 0)) {
+        mTimingTag++;
+        for (int i = 4; i < 12; i++) {
+            mTimingMem[i] = 0;
+        }
+        __asm__ volatile("sync" ::: "memory");
+        xsdk_gpu_wait_word(xsdk_gpu_address(mTimingMem), mTimingTag);
+        xsdk_gpu_write_clock(xsdk_gpu_address(mTimingMem + 4), false);
+        mTimingGateClosed = true;
+        mTimingValid = true;
+    }
+    // Frames 1500 and 3000 (the title screen) capture themselves; Back+LB captures any other.
+    if (mFrame == 1500 || mFrame == 3000) {
+        gXenosCaptureRequest = true;
+    }
+    if (gXenosCaptureRequest.exchange(false) && !mCapture && !mGpuHung) {
+        char path[96];
+        snprintf(path, sizeof path, "game:\\oot360_capture_%llu.bin", (unsigned long long)mFrame);
+        mCapture = fopen(path, "wb");
+        xsdk_log_write("xenos: capturing frame %llu into %s: %s", (unsigned long long)mFrame, path,
+                       mCapture ? "open" : "could not open the file");
+        if (mCapture) {
+            static const char magic[8] = { 'O', 'O', 'T', 'C', 'A', 'P', '0', '1' };
+            fwrite(magic, 1, sizeof magic, mCapture);
+            // Version 2: a draw's pixel constants, then its vertex constants (XenosVertexConstants).
+            const uint32_t sizes[4] = { (uint32_t)sizeof(XenosPixelConstants), (uint32_t)mFrame, 2,
+                                        (uint32_t)sizeof(XenosVertexConstants) };
+            CaptureRecord(0, sizes, sizeof sizes);
+            mCaptureTextures.clear();
+        }
+    }
+}
+
+void GfxRenderingAPIXenos::CaptureRecord(uint32_t type, const void* a, uint32_t aBytes, const void* b,
+                                         uint32_t bBytes) {
+    if (!mCapture) {
+        return;
+    }
+    const uint32_t header[2] = { type, aBytes + bBytes };
+    fwrite(header, sizeof header, 1, mCapture);
+    if (aBytes) {
+        fwrite(a, 1, aBytes, mCapture);
+    }
+    if (bBytes) {
+        fwrite(b, 1, bBytes, mCapture);
+    }
+}
+
+// kind 0: a texture as uploaded (bytes R, G, B, A), 1: a framebuffer's resolve (A8R8G8B8).
+void GfxRenderingAPIXenos::CaptureTexture(uint32_t id, uint32_t kind) {
+    if (id >= mTextures.size()) {
+        return;
+    }
+    const XenosTexture& t = mTextures[id];
+    if (!t.memory || !t.width || !t.height) {
+        return;
+    }
+    std::vector<uint8_t> pixels((size_t)t.width * t.height * 4);
+    xsdk_texture_download_rows(&t.texture, 0, 0, t.height, pixels.data(), t.width * 4);
+    const uint32_t head[4] = { id, t.width, t.height, kind };
+    CaptureRecord(3, head, sizeof head, pixels.data(), (uint32_t)pixels.size());
+}
+
+void GfxRenderingAPIXenos::CaptureFinish() {
+    if (!mCapture) {
+        return;
+    }
+    xsdk_gpu_wait(xsdk_gpu_fence(), kFenceTimeoutMs);
+    for (uint32_t id : mCaptureTextures) {
+        CaptureTexture(id, 0);
+    }
+    if (!mFramebuffers.empty()) {
+        CaptureTexture(mFramebuffers[0].textureId, 1);
+    }
+    fclose(mCapture);
+    mCapture = nullptr;
+    xsdk_log_write("xenos: capture written (%u textures)", (unsigned)mCaptureTextures.size());
+}
+
+void GfxRenderingAPIXenos::EndFrame() {
+    Trace("end frame: %llu draws", (unsigned long long)mDrawsThisFrame);
+    if (mGpuHung) {
+        mFrame++;
+        return;
+    }
+    // The screen into the front buffer.
+    if (mBoundFb != 0) {
+        BindTarget(0);
+    }
+    RestoreIfNeeded();
+    if (mCapture && mBoundFb == 0) {
+        // The picture as drawn, into framebuffer 0's texture, eDRAM kept for the present.
+        mBoundDirty = true;
+        ResolveBound(true);
+    }
+    bool timed = false;
+    if (mTimingGateClosed) {
+        // Everything the frame draws is queued: the clock once the GPU has done it, then let the GPU go.
+        xsdk_gpu_write_clock(xsdk_gpu_address(mTimingMem + 8), true);
+        timed = mTimingValid;
+        mTimingDraws = (uint32_t)mDrawsThisFrame;
+        TimingOpenGate();
+    }
+    uint32_t address = 0;
+    // Waits for a front buffer to come off screen: at 60 fps, the vblank.
+    Oot360_Phase("xenos: present wait");
+    if (NT_SUCCESS(xsdk_present_begin(&address, kBeginTimeoutMs))) {
+        Trace("present into 0x%08X", (unsigned)address);
+        xsdk_gpu_resolve(address, mFramebuffers[0].width, mFramebuffers[0].height, 0xFF000000);
+        Oot360_Phase("xenos: pacing wait");
+        PaceFrame();
+        xsdk_present_end();
+        Oot360_Phase("xenos: after present");
+        TraceSync("the present resolve");
+    } else {
+        xsdk_log_write("xenos: no front buffer came free");
+        xsdk_gpu_resolve(xsdk_present_buffer_address(0), mFramebuffers[0].width, mFramebuffers[0].height,
+                         0xFF000000);
+    }
+    mBoundFb = -1;
+    mBoundDirty = false;
+    mFramebuffers[0].textureValid = false;
+    ResetDrawState();
+
+    const uint32_t fence = xsdk_gpu_fence();
+    if (timed) {
+        mTimingPending = true;
+        mTimingFence = fence;
+    }
+    TimingRead();
+    mFrameFence[mRingIndex] = fence;
+    mFenceOfFrame[mFrame] = fence;
+    mFrame++;
+    mRingIndex = (mRingIndex + 1) % kFramesInFlight;
+    // The ring part this frame takes was last used kFramesInFlight frames ago.
+    Oot360_Phase("xenos: wait for the GPU");
+    if (mFrameFence[mRingIndex]) {
+        xsdk_gpu_wait(mFrameFence[mRingIndex], kFenceTimeoutMs);
+    }
+    Oot360_Phase("xenos: frame end");
+    mVertexOffset = 0;
+    CaptureFinish();
+    GpuReclaim();
+
+    if ((mFrame % 600) == 0) {
+        XsdkPresentStats ps;
+        xsdk_present_stats(&ps);
+        const double now = mWindow->GetTime();
+        const double seconds = mLastLogTime > 0.0 ? now - mLastLogTime : 0.0;
+        const uint32_t vblanks = ps.vblanks - mLastStats.vblanks;
+        const uint32_t flips = ps.flips - mLastStats.flips;
+        // Busy: the time a frame took on the CPU and GPU, without the pacing wait.
+        const double busyMs = seconds > 0.0 ? (seconds * 1e6 - (double)mWaitUs) / 600.0 / 1000.0 : 0.0;
+        xsdk_log_write("xenos: frame %llu draws %llu shaders %u layouts %u pools %u overflows %u | %.1f fps "
+                       "(%u flips in %u vblanks), target %u fps, busy %.1f ms a frame, late %u",
+                       (unsigned long long)mFrame, (unsigned long long)mDrawsThisFrame, (unsigned)mShaderPool.size(),
+                       (unsigned)mVertexShaders.size(), (unsigned)mPools.size(), (unsigned)mOverflowDraws,
+                       seconds > 0.0 ? 600.0 / seconds : 0.0, (unsigned)flips, (unsigned)vblanks,
+                       (unsigned)mWindow->GetTargetFps(), busyMs, (unsigned)(ps.late - mLastStats.late));
+        // The interpreter's own split (interpreter.cpp, OOT360_PROF), ms a frame; nested slots overlap.
+        static const char* const names[7] = { "run", "vertices", "triangles", "draws", "textures", "matrices", "rects" };
+        char line[256];
+        int n = 0;
+        for (int i = 0; i < 7; i++) {
+            n += snprintf(line + n, sizeof line - n, " %s %.2f", names[i], (double)gOot360Prof[i] / 49875.0 / 600.0);
+            gOot360Prof[i] = 0;
+        }
+        xsdk_log_write("xenos: interpreter ms a frame:%s", line);
+        // The display list opcodes that took longest, ms a frame and calls a frame.
+        {
+            int order[256];
+            for (int i = 0; i < 256; i++) {
+                order[i] = i;
+            }
+            std::sort(order, order + 256, [](int a, int b) { return gOot360OpTicks[a] > gOot360OpTicks[b]; });
+            int m = 0;
+            for (int k = 0; k < 10 && gOot360OpTicks[order[k]]; k++) {
+                const int op = order[k];
+                m += snprintf(line + m, sizeof line - m, " %02X %.2f/%u", op,
+                              (double)gOot360OpTicks[op] / 49875.0 / 600.0, (unsigned)(gOot360OpCount[op] / 600));
+            }
+            xsdk_log_write("xenos: opcodes, ms/calls a frame:%s", line);
+            static uint32_t lastGeneration;
+            const uint32_t generation = Oot360_ResourceGeneration();
+            xsdk_log_write("xenos: resource lookups missed %u, resource cache changed %u times (600 frames)",
+                           (unsigned)gOot360ResourceMisses, (unsigned)(generation - lastGeneration));
+            // How long the CPU waited for the GPU to free command stream space: the GPU behind the render thread.
+            static XsdkGpuStats lastGpu;
+            XsdkGpuStats gpu;
+            xsdk_gpu_stats(&gpu);
+            xsdk_log_write("xenos: CPU waited for the GPU %u times, %.2f ms a frame",
+                           (unsigned)(gpu.waits - lastGpu.waits),
+                           (double)(gpu.waited_us - lastGpu.waited_us) / 1000.0 / 600.0);
+            lastGpu = gpu;
+            gOot360ResourceMisses = 0;
+            lastGeneration = generation;
+            memset(gOot360OpTicks, 0, sizeof gOot360OpTicks);
+            memset(gOot360OpCount, 0, sizeof gOot360OpCount);
+        }
+        if (mTimingSamples) {
+            xsdk_log_write("xenos: GPU ms a frame (the GPU alone, %u frames): %.2f average, %.2f most; %u draws in the "
+                           "last one timed",
+                           (unsigned)mTimingSamples, mTimingSumMs / mTimingSamples, mTimingMaxMs,
+                           (unsigned)mTimingDraws);
+            mTimingSamples = 0;
+            mTimingSumMs = 0.0;
+            mTimingMaxMs = 0.0;
+        }
+        mLastStats = ps;
+        mLastLogTime = now;
+        mWaitUs = 0;
+    }
+}
+
+void GfxRenderingAPIXenos::PaceFrame() {
+    const uint32_t fps = mWindow->GetTargetFps();
+    // A frame shows from the vblank after xsdk_present_end for interval vblanks; 20 fps is 3, 30 is 2, 60 is 1.
+    uint32_t interval = fps > 0 ? (60 + fps / 2) / fps : 1;
+    interval = std::clamp<uint32_t>(interval, 1, 6);
+    XsdkPresentStats ps;
+    xsdk_present_stats(&ps);
+    if (mNextFlipVblank == 0 || ps.vblanks + 1 > mNextFlipVblank) {
+        // Late (or the first frame): show at the next vblank, as the N64 drops a frame when it can't keep up.
+        mNextFlipVblank = ps.vblanks + 1;
+    }
+    const auto start = std::chrono::steady_clock::now();
+    while (ps.vblanks + 1 < mNextFlipVblank) {
+        struct timespec ts = { 0, 1000000 };
+        nanosleep(&ts, nullptr);
+        xsdk_present_stats(&ps);
+    }
+    mWaitUs += (uint64_t)std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() -
+                                                                              start)
+                   .count();
+    mNextFlipVblank += interval;
+}
+
+void GfxRenderingAPIXenos::FinishRender() {
+}
