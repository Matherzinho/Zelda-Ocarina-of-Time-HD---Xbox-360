+void GfxRenderingAPIXenos::DeleteTexture(uint32_t texId) {
+    if (texId == 0 || texId >= mTextures.size()) {
+        return;
+    }
+    XenosTexture& t = mTextures[texId];
+    GpuFreeLater(t.memory, t.bytes);
+    t = XenosTexture();
+    mFreeTextureIds.push_back(texId);
+}
