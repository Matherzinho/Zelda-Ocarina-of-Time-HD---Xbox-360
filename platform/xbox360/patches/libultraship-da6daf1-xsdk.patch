+// Window: the display, the controller's quit combination, time.
+
+void GfxWindowBackendXenos::Init(const char* gameName, const char* apiName, bool startFullScreen, uint32_t width,
+                                 uint32_t height, int32_t posX, int32_t posY) {
+    NTSTATUS s = xsdk_gpu_open();
+    if (!NT_SUCCESS(s)) {
+        xsdk_log_write("xenos: xsdk_gpu_open failed: 0x%08X", (unsigned)s);
+        mIsRunning = false;
+        return;
+    }
+    s = xsdk_present_open(XSDK_DISPLAY_720P, 2, 1, &mWidth, &mHeight);
+    if (!NT_SUCCESS(s)) {
+        xsdk_log_write("xenos: xsdk_present_open failed: 0x%08X", (unsigned)s);
+        mIsRunning = false;
+        return;
+    }
+    mOpen = true;
+    mFullScreen = true;
+    xsdk_log_write("xenos: display %ux%u", (unsigned)mWidth, (unsigned)mHeight);
+
+    Fast::GuiWindowInitData windowImpl = {};
+    windowImpl.Backend = WindowBackend::FAST3D_XENOS;
+    std::dynamic_pointer_cast<Fast::Fast3dGui>(Ship::Context::GetRawInstance()->GetWindow()->GetGui())->Init(windowImpl);
+}
