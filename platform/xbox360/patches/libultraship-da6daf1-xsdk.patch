+
+void GfxWindowBackendXenos::HandleEvents() {
+    // SDL (SDL-xenon through sdl2-compat) keeps the controllers; pumping its events notices hot-plugging.
+    // Controller add/remove events are left in the queue: LUS's SDLAddRemoveDeviceEventHandler takes them and opens
+    // the pads (taking them here, as SDL_PollEvent did in test 5, left the game with no controller at all).
+    SDL_Event event;
+    SDL_PumpEvents();
+    while (SDL_PeepEvents(&event, 1, SDL_GETEVENT, SDL_FIRSTEVENT, SDL_CONTROLLERDEVICEADDED - 1) > 0) {
+        if (event.type == SDL_QUIT) {
+            mIsRunning = false;
+        }
+    }
+    while (SDL_PeepEvents(&event, 1, SDL_GETEVENT, SDL_CONTROLLERDEVICEREMOVED + 1, SDL_LASTEVENT) > 0) {
+    }
+    if (SDL_NumJoysticks() != mLoggedPads) {
+        mLoggedPads = SDL_NumJoysticks();
+        SPDLOG_INFO("oot360: SDL sees {} joystick(s)", mLoggedPads);
+        for (int i = 0; i < SDL_NumJoysticks(); i++) {
+            char guid[64];
+            SDL_JoystickGetGUIDString(SDL_JoystickGetDeviceGUID(i), guid, sizeof(guid));
+            SPDLOG_INFO("oot360: joystick {} \"{}\" guid {} gamecontroller {}", i, SDL_JoystickNameForIndex(i), guid,
+                        SDL_IsGameController(i) ? "yes" : "no");
+        }
+    }
+    // Back and Start held for a second leaves the title, as the zelda3 port does.
+    INPUT_STATE input = {};
+    if (XamInputGetState(0, 0, &input) == ERROR_SUCCESS &&
+        (input.gamepad.buttons & (INPUT_GAMEPAD_BACK | INPUT_GAMEPAD_START)) ==
+            (INPUT_GAMEPAD_BACK | INPUT_GAMEPAD_START)) {
+        if (++mQuitHeldFrames >= 60) {
+            mIsRunning = false;
+        }
+    } else {
+        mQuitHeldFrames = 0;
+    }
+    // Both sticks clicked in capture the next frame for debugging (gfx_xenos.h, CaptureRecord); Back alone opens
+    // Ship of Harkinian's menu now.
+    const bool captureHeld = (input.gamepad.buttons & (INPUT_GAMEPAD_LEFT_THUMB | INPUT_GAMEPAD_RIGHT_THUMB)) ==
+                             (INPUT_GAMEPAD_LEFT_THUMB | INPUT_GAMEPAD_RIGHT_THUMB);
+    if (captureHeld && !mCaptureHeld) {
+        gXenosCaptureRequest = true;
+    }
+    mCaptureHeld = captureHeld;
+}
