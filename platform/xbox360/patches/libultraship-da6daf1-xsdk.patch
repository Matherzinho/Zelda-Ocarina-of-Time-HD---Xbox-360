+void* GfxRenderingAPIXenos::GetFramebufferTextureId(int fbId) {
+    if (fbId < 0 || fbId >= (int)mFramebuffers.size()) {
+        return nullptr;
+    }
+    return (void*)(uintptr_t)mFramebuffers[fbId].textureId;
+}
+
+void GfxRenderingAPIXenos::SelectTextureFb(int fbId) {
+    if (fbId < 0 || fbId >= (int)mFramebuffers.size()) {
+        return;
+    }
+    if (mBoundFb == fbId && mBoundDirty) {
+        ResolveBound(true);
+    }
+    SelectTexture(0, mFramebuffers[fbId].textureId);
+}
