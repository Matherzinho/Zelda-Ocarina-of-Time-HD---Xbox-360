 void* ResourceManager::GetResourceRawPointer(uint64_t crc) {
+#ifdef __XSDK__
+    // oot360: what each hash resolved to, per thread, until the cache changes. The interpreter asks this for most
+    // display lists, vertices and matrices of every frame, and each ask went through LoadResource: the path's
+    // string, its alternate asset's, two locked map lookups and a promise, which cost the Xbox 360 milliseconds a
+    // frame. A raw pointer is no more owned than before: the resource stays cached as long as it was.
+    struct Resolved {
+        uint32_t generation = ~0u;
+        std::unordered_map<uint64_t, void*> pointers;
+    };
+    static __thread Resolved* resolvedOfThread = nullptr;
+    if (resolvedOfThread == nullptr) {
+        resolvedOfThread = new Resolved();
+    }
+    Resolved& resolved = *resolvedOfThread;
+    const uint32_t generation = gResourceGeneration.load(std::memory_order_acquire);
+    if (resolved.generation != generation) {
+        resolved.pointers.clear();
+        resolved.generation = generation;
+    }
+    auto found = resolved.pointers.find(crc);
+    if (found != resolved.pointers.end()) {
+        return found->second;
+    }
+    gOot360ResourceMisses++;
+    void* pointer = GetResourceRawPointer(LoadResource(crc));
+    // Only once nothing changed meanwhile: the load may itself have cached things. Missing ones too.
+    if (gResourceGeneration.load(std::memory_order_acquire) == generation) {
+        resolved.pointers[crc] = pointer;
+    }
+    return pointer;
+#else
     auto resource = LoadResource(crc);
 
     return GetResourceRawPointer(resource);
+#endif
 }
 
