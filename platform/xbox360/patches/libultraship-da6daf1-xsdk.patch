+namespace Fast {
+void GfxRenderingAPIXenos::UploadTexture(const uint8_t* rgba32Buf, uint32_t width, uint32_t height) {
+    const bool hd = sNextUploadHd;
+    sNextUploadHd = false;
+    if (width == 0 || height == 0) {
+        return;
+    }
+    XenosTexture& t = Texture(mCurrentTextureIds[mCurrentTile]);
+    // zeldaMM: mip levels for textures of 64 texels a side and more, an HD pack's always (SetSamplerParameters filters
+    // them smoothly), the N64's with the bilinear filter (the three-point and nearest ones read the base level only).
+    // Drawn smaller than they are (a 4x heart at a third of its size, a floor going off into the distance), one level
+    // read a texel here and there: jagged icons and shimmering ground. oot360 tried levels with nearest-level sampling
+    // and no bias (test 17) and its HUD came out blurred; here the levels blend (trilinear) a level sharper than the
+    // GPU would pick (ApplySampler), and alpha-weighted (HalveRgba). gOot360.Mipmaps 0 turns them off.
+    uint32_t levels = 1;
+    if ((hd || mFilterMode == FILTER_LINEAR) && width >= 64 && height >= 64 &&
+        Ship::Context::GetRawInstance()->GetConsoleVariables()->GetInteger("gOot360.Mipmaps", 1)) {
+        while ((std::max(width, height) >> (levels - 1)) > 1) {
+            levels++;
+        }
+    }
+    // Bytes red, green, blue, alpha: as a big-endian word, R8G8B8A8.
+    if (!CreateTextureStorage(t, XSDK_FORMAT_R8G8B8A8, width, height, false, levels)) {
+        return;
+    }
+    t.hd = hd;
+    xsdk_texture_upload(&t.texture, 0, rgba32Buf, width * 4);
+    if (levels > 1) {
+        // Level 1 straight from the image, then each from the one before, in the two scratch buffers.
+        const uint8_t* from = rgba32Buf;
+        uint32_t w = width, h = height;
+        for (uint32_t level = 1; level < levels; level++) {
+            const uint32_t nw = std::max(w / 2, 1u), nh = std::max(h / 2, 1u);
+            std::vector<uint8_t>& to = mMipScratch[level & 1];
+            to.resize((size_t)nw * nh * 4);
+            HalveRgba(from, w, h, to.data(), nw, nh);
+            xsdk_texture_upload(&t.texture, level, to.data(), nw * 4);
+            from = to.data();
+            w = nw;
+            h = nh;
+        }
+    }
+    xsdk_gpu_invalidate(t.texture.address, t.texture.size_bytes);
+    Trace("upload texture %u (tile %d): %ux%u", (unsigned)mCurrentTextureIds[mCurrentTile], mCurrentTile,
+          (unsigned)width, (unsigned)height);
+}
+
+void GfxRenderingAPIXenos::SetSamplerParameters(int tile, bool linear_filter, uint32_t cms, uint32_t cmt) {
+    XenosTexture& t = Texture(mCurrentTextureIds[tile]);
+    // zeldaMM: an HD pack's texture filtered smoothly (bilinear, its mip levels blended) whatever the filter setting:
+    // the three-point filter, the default, copies the N64's look on its own small textures, and on one four times
+    // their size, mostly drawn smaller than it is, reads its base level only (test 1e's jagged icons).
+    const bool linear = linear_filter && (mFilterMode == FILTER_LINEAR || (t.hd && mFilterMode == FILTER_THREE_POINT));
+    const bool threePoint = linear_filter && mFilterMode == FILTER_THREE_POINT && !t.hd;
+    const uint32_t u = AddressMode(cms);
+    const uint32_t v = AddressMode(cmt);
+    if (t.linear != linear || t.threePoint != threePoint || t.addressU != u || t.addressV != v) {
+        t.linear = linear;
+        t.threePoint = threePoint;
+        t.addressU = u;
+        t.addressV = v;
+        t.samplerDirty = true;
+    }
+}
+
+void GfxRenderingAPIXenos::ApplySampler(XenosTexture& t) {
+    if (!t.samplerDirty) {
+        return;
+    }
+    XsdkSampler s = {};
+    s.mag_filter = t.linear ? XSDK_FILTER_LINEAR : XSDK_FILTER_POINT;
+    s.min_filter = s.mag_filter;
+    s.mip_filter = XSDK_FILTER_POINT;
+    s.address_u = t.addressU;
+    s.address_v = t.addressV;
+    XsdkSampler base = s;
+    if (t.levels > 1) {
+        base.level_count = 1;
+    }
+    if (t.levels > 1 && t.linear) {
+        // zeldaMM: the two nearest levels blended, half a level sharper than the GPU's choice (a 4x icon drawn at
+        // three quarters of its size keeps its base level), and anisotropy for surfaces seen at a slant (floors and
+        // walls going into the distance keep their detail). The slider's 0 to 16; a hand-edited setting past that
+        // would trip the SDK's assert.
+        s.mip_filter = XSDK_FILTER_LINEAR;
+        s.lod_bias = -0.5f;
+        s.max_anisotropy = (uint32_t)std::clamp(
+            Ship::Context::GetRawInstance()->GetConsoleVariables()->GetInteger("gOot360.Anisotropy", 4), 0, 16);
+    } else if (t.levels > 1) {
+        s.level_count = 1; // point or three-point filtering: the base level only, as before
+    }
+    xsdk_texture_sampler_state(&t.sampler, &s);
+    xsdk_texture_sampler_state(&t.samplerBase, &base);
+    t.samplerDirty = false;
+}
