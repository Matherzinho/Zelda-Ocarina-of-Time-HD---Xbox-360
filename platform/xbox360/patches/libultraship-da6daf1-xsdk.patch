+
+bool GfxRenderingAPIXenos::CreateTextureStorage(XenosTexture& t, uint32_t format, uint32_t width, uint32_t height,
+                                                bool resolveTarget, uint32_t levels) {
+    // Memory the GPU may still read from goes back only once this frame's fence lands.
+    GpuFreeLater(t.memory, t.bytes);
+    t.memory = nullptr;
+    XsdkTexture tex = {};
+    if (!NT_SUCCESS(xsdk_texture_init(&tex, format, width, height, levels, true))) {
+        return false;
+    }
+    if (resolveTarget) {
+        // A resolve writes the base at the corner; a small texture's base would otherwise sit in the packed tail.
+        xsdk_texture_base_at_corner(&tex);
+    }
+    volatile uint32_t* mem = GpuAlloc(tex.size_bytes);
+    if (!mem) {
+        return false;
+    }
+    xsdk_texture_attach(&tex, mem);
+    t.texture = tex;
+    t.memory = mem;
+    t.bytes = tex.size_bytes;
+    t.width = (uint16_t)width;
+    t.height = (uint16_t)height;
+    t.samplerDirty = true;
+    return true;
+}
+
+void GfxRenderingAPIXenos::UploadTexture(const uint8_t* rgba32Buf, uint32_t width, uint32_t height) {
+    if (width == 0 || height == 0) {
+        return;
+    }
+    XenosTexture& t = Texture(mCurrentTextureIds[mCurrentTile]);
+    // One level: mip levels for the packs' textures (test 17) blurred the HUD's and text's high-resolution textures,
+    // drawn a little smaller than they are, and gained nothing measurable.
+    const uint32_t levels = 1;
+    // Bytes red, green, blue, alpha: as a big-endian word, R8G8B8A8.
+    if (!CreateTextureStorage(t, XSDK_FORMAT_R8G8B8A8, width, height, false, levels)) {
+        return;
+    }
+    xsdk_texture_upload(&t.texture, 0, rgba32Buf, width * 4);
+    xsdk_gpu_invalidate(t.texture.address, t.texture.size_bytes);
+    Trace("upload texture %u (tile %d): %ux%u", (unsigned)mCurrentTextureIds[mCurrentTile], mCurrentTile,
+          (unsigned)width, (unsigned)height);
+}
+
+void GfxRenderingAPIXenos::SetSamplerParameters(int tile, bool linear_filter, uint32_t cms, uint32_t cmt) {
+    XenosTexture& t = Texture(mCurrentTextureIds[tile]);
+    const bool linear = linear_filter && mFilterMode == FILTER_LINEAR;
+    const bool threePoint = linear_filter && mFilterMode == FILTER_THREE_POINT;
+    const uint32_t u = AddressMode(cms);
+    const uint32_t v = AddressMode(cmt);
+    if (t.linear != linear || t.threePoint != threePoint || t.addressU != u || t.addressV != v) {
+        t.linear = linear;
+        t.threePoint = threePoint;
+        t.addressU = u;
+        t.addressV = v;
+        t.samplerDirty = true;
+    }
+}
+
+void GfxRenderingAPIXenos::ApplySampler(XenosTexture& t) {
+    if (!t.samplerDirty) {
+        return;
+    }
+    XsdkSampler s = {};
+    s.mag_filter = t.linear ? XSDK_FILTER_LINEAR : XSDK_FILTER_POINT;
+    s.min_filter = s.mag_filter;
+    s.mip_filter = XSDK_FILTER_POINT;
+    s.address_u = t.addressU;
+    s.address_v = t.addressV;
+    xsdk_texture_sampler_state(&t.sampler, &s);
+    t.samplerDirty = false;
+}
