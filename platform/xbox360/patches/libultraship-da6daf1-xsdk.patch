 void* ResourceManager::GetResourceRawPointer(const char* name) {
+#ifdef __XSDK__
+    // oot360: what each path resolved to, per thread, until the resource cache changes, as for hashes below. Mods'
+    // display lists (Djipi's 3DS Experience) name their vertices and display lists by path, a few hundred a frame,
+    // and each went through LoadResource: 20 ms a frame of a 33 (test 15b).
+    if (name == nullptr) {
+        return nullptr;
+    }
+    auto& resolved = ResolvedOfThread<void*>();
+    const uint32_t generation = resolved.generation;
+    auto found = resolved.items.find(std::string_view(name));
+    if (found != resolved.items.end()) {
+        return found->second;
+    }
+    gOot360ResourceMisses++;
+    void* pointer = GetResourceRawPointer(LoadResource(name));
+    // Kept when missing too: a missing path asked for every frame cost a whole LoadResource each time.
+    if (gResourceGeneration.load(std::memory_order_acquire) == generation) {
+        resolved.items.emplace(name, pointer);
+    }
+    return pointer;
+#else
     auto resource = LoadResource(name);
 
     return GetResourceRawPointer(resource);
+#endif
