+// ---------------------------------------------------------------------------------------------------------------
+// Dear ImGui
+
+void GfxRenderingAPIXenos::ImGuiInit() {
+    ImGuiIO& io = ImGui::GetIO();
+    io.BackendRendererName = "xenos";
+    io.BackendFlags |= ImGuiBackendFlags_RendererHasVtxOffset;
+    // The font texture is made at the first new frame, once the game has added its fonts (ImGuiNewFrame).
+}
+
+void GfxRenderingAPIXenos::ImGuiNewFrame() {
+    ImGuiIO& io = ImGui::GetIO();
+    if (mFontTexture && io.Fonts->IsBuilt()) {
+        return;
+    }
+    if (mFontTexture) {
+        DeleteTexture(mFontTexture);
+        mFontTexture = 0;
+    }
+    xsdk_log_write("xenos: building the ImGui font atlas (%d fonts)", io.Fonts->Fonts.Size);
+    // As bytes R, G, B, A, white with the glyphs' coverage in alpha. Not GetTexDataAsRGBA32: it writes each pixel as
+    // an ImU32, IM_COL32(255, 255, 255, a), whose bytes on this big-endian CPU are a, 255, 255, 255, so the glyphs'
+    // coverage landed in red and every glyph came out a solid box (test 11's unreadable menu).
+    unsigned char* alpha = nullptr;
+    int width = 0, height = 0;
+    io.Fonts->GetTexDataAsAlpha8(&alpha, &width, &height);
+    std::vector<uint8_t> pixels((size_t)width * height * 4);
+    for (size_t i = 0; i < (size_t)width * height; i++) {
+        pixels[i * 4 + 0] = 255;
+        pixels[i * 4 + 1] = 255;
+        pixels[i * 4 + 2] = 255;
+        pixels[i * 4 + 3] = alpha[i];
+    }
+    mFontTexture = NewTexture();
+    SelectTexture(0, mFontTexture);
+    UploadTexture(pixels.data(), width, height);
+    SetSamplerParameters(0, true, G_TX_CLAMP, G_TX_CLAMP);
+    XenosTexture& f = Texture(mFontTexture);
+    f.linear = true;
+    f.threePoint = false;
+    f.samplerDirty = true;
+    io.Fonts->SetTexID((ImTextureID)(uintptr_t)mFontTexture);
+    xsdk_log_write("xenos: ImGui font atlas %dx%d", width, height);
+}
+
+void GfxRenderingAPIXenos::ImGuiShutdown() {
+}
+
+void GfxRenderingAPIXenos::ImGuiRenderDrawData(ImDrawData* data) {
+    if (mGpuHung) {
+        return;
+    }
+    if (!data || data->CmdListsCount == 0 || data->DisplaySize.x <= 0 || data->DisplaySize.y <= 0) {
+        return;
+    }
+    if (mBoundFb != 0) {
+        BindTarget(0);
+    }
+    RestoreIfNeeded();
+    const XenosFramebuffer& fb = mFramebuffers[0];
+    // Pixels from DisplayPos, y down, into clip space.
+    const float sx = 2.0f / data->DisplaySize.x;
+    const float sy = -2.0f / data->DisplaySize.y;
+    const float push[8] = { sx, sy, -1.0f - data->DisplayPos.x * sx, 1.0f - data->DisplayPos.y * sy, 0, 0, 0, 0 };
+
+    xsdk_gpu_set_shaders(&mBlitVertex, &mBlitPixel);
+    xsdk_built_shader_set_literals(&ui_vert);
+    xsdk_built_shader_set_literals(&ui_frag);
+    xsdk_gpu_set_vertex_constants(UI_VERT_PUSH, push, UI_VERT_PUSH_REGISTERS);
+    xsdk_gpu_set_depth_stencil(&mDepthStates[0]);
+    xsdk_gpu_set_blend(&mBlendAlpha);
+    xsdk_gpu_set_raster(&mRasterNormal);
+    ZeldaMM_SetViewport(0, 0, (float)fb.width, (float)fb.height);
+
+    for (int n = 0; n < data->CmdListsCount; n++) {
+        const ImDrawList* list = data->CmdLists[n];
+        const uint32_t vbytes = list->VtxBuffer.Size * sizeof(ImDrawVert);
+        uint32_t vaddr;
+        volatile uint32_t* vmem = VertexSpace(vbytes, &vaddr);
+        if (!vmem) {
+            break;
+        }
+        WriteWords(vmem, list->VtxBuffer.Data, vbytes);
+        xsdk_gpu_invalidate(vaddr, vbytes);
+
+        for (const ImDrawCmd& cmd : list->CmdBuffer) {
+            if (cmd.UserCallback) {
+                if (cmd.UserCallback != ImDrawCallback_ResetRenderState) {
+                    cmd.UserCallback(list, &cmd);
+                }
+                continue;
+            }
+            const float cx0 = cmd.ClipRect.x - data->DisplayPos.x, cy0 = cmd.ClipRect.y - data->DisplayPos.y;
+            const float cx1 = cmd.ClipRect.z - data->DisplayPos.x, cy1 = cmd.ClipRect.w - data->DisplayPos.y;
+            if (cx1 <= cx0 || cy1 <= cy0) {
+                continue;
+            }
+            const uint32_t x = (uint32_t)std::max(cx0, 0.0f), y = (uint32_t)std::max(cy0, 0.0f);
+            const uint32_t w = (uint32_t)std::min(cx1, (float)fb.width) - x;
+            const uint32_t h = (uint32_t)std::min(cy1, (float)fb.height) - y;
+            xsdk_gpu_set_scissor(x, y, w, h);
+            const uint32_t id = (uint32_t)(uintptr_t)cmd.GetTexID();
+            XenosTexture& t = Texture(id);
+            if (!t.memory) {
+                continue;
+            }
+            ApplySampler(t);
+            // Each command's indices in a list of their own, starting on 4 bytes as Xenos needs (xsdk
+            // docs/PITFALLS.md): an ImDrawCmd's IdxOffset can be odd. Padded to whole words.
+            const uint32_t ibytes = (cmd.ElemCount * sizeof(ImDrawIdx) + 3) & ~3u;
+            uint32_t iaddr;
+            volatile uint32_t* imem = VertexSpace(ibytes, &iaddr);
+            if (!imem) {
+                break;
+            }
+            std::vector<ImDrawIdx> idx(list->IdxBuffer.Data + cmd.IdxOffset,
+                                       list->IdxBuffer.Data + cmd.IdxOffset + cmd.ElemCount);
+            idx.resize(ibytes / sizeof(ImDrawIdx), 0);
+            WriteWords(imem, idx.data(), ibytes);
+            xsdk_gpu_invalidate(iaddr, ibytes);
+            xsdk_gpu_set_texture(UI_FRAG_SAMPLER_0_0, &t.texture, &t.sampler);
+            xsdk_gpu_set_vertices(0, vaddr + cmd.VtxOffset * sizeof(ImDrawVert),
+                                  vbytes - cmd.VtxOffset * sizeof(ImDrawVert));
+            Trace("imgui: %u indices, texture %u (%ux%u), scissor %u,%u %ux%u", (unsigned)cmd.ElemCount, (unsigned)id,
+                  (unsigned)t.width, (unsigned)t.height, (unsigned)x, (unsigned)y, (unsigned)w, (unsigned)h);
+            xsdk_gpu_draw_indexed(XSDK_PRIMITIVE_TRIANGLE_LIST, iaddr, cmd.ElemCount, sizeof(ImDrawIdx) == 4);
+            if (!TraceSync("an ImGui draw")) {
+                return;
+            }
+        }
+    }
+    ResetDrawState();
+    mBoundDirty = true;
+}
+
+} // namespace Fast
+
+#endif
diff --git a/src/fast/backends/xenos/fast3d.frag b/src/fast/backends/xenos/fast3d.frag
new file mode 100644
index 00000000..6166f185
--- /dev/null
+++ b/src/fast/backends/xenos/fast3d.frag
@@ -0,0 +1,165 @@
+#version 450
+// Fast3D pixel shader template for the Xenos backend (gfx_xenos.cpp). CMake writes variants of it with defines
+// after the #version line (src/fast/CMakeLists.txt):
+//   TP0, TP1  three-point filtering of texture 0, 1      CYC2   the second combiner cycle
+//   KILL      texture edge / alpha threshold may discard  NOISE  the combiner reads noise or dithers alpha
+//   T0, T1    the combiner reads texture 0, 1             MASK0  texture 0 has a mask (and maybe a blend) over it
+// It follows libultraship's default.shader.glsl: per cycle, (a - b) * c + d for colour and alpha, then fog, texture
+// edge, noise, grayscale, alpha threshold and invisible. xost lowers no function calls and no discard beside another
+// branch, so the shader is branch-free, each of a - b, c and d a weighted sum of the combiner's sources with the
+// weights worked out on the CPU from the combiner's mode (BuildCombinerConstants in gfx_xenos.cpp).
+//
+// The sources a vertex carries (the combiner's inputs 1-7 and the constants 0 and 1) are summed in the vertex
+// shader, which hands each operand's part over as one interpolant (v_ab0 to v_d1): a weighted sum of interpolated
+// values is the interpolated weighted sum, and it costs a vertex what it would cost every pixel. Here each operand
+// adds what only a pixel has, the texels, the first cycle's result and the noise. Each weight is a vec4: rgb the
+// colour combiner's, a the alpha combiner's, so one sum serves both.
+layout(location = 0) in vec4 v_uv;
+layout(location = 1) in vec4 v_clamp;
+layout(location = 2) in vec4 v_fog;
+layout(location = 3) in vec4 v_gray;
+layout(location = 4) in vec4 v_ab0;
+layout(location = 5) in vec4 v_c0;
+layout(location = 6) in vec4 v_d0;
+#ifdef CYC2
+// Last, so a one-cycle variant is drawn with three interpolators fewer (xsdk:docs/HARDWARE.md, "Interpolators a pixel
+// shader doesn't read").
+layout(location = 7) in vec4 v_ab1;
+layout(location = 8) in vec4 v_c1;
+layout(location = 9) in vec4 v_d1;
+#endif
+layout(location = 0) out vec4 o_color;
+
+layout(set = 0, binding = 0) uniform sampler2D u_tex0;
+layout(set = 0, binding = 1) uniform sampler2D u_tex1;
+// Ship of Harkinian's blended textures (Gfx_RegisterBlendedTexture): where the mask's alpha is set, texture 0 shows
+// the blend texture, or nothing (libultraship's default.shader.glsl, o_masks and o_blend). The pause screen's dungeon
+// maps colour the rooms seen this way.
+layout(set = 0, binding = 2) uniform sampler2D u_mask0;
+layout(set = 0, binding = 3) uniform sampler2D u_blend0;
+
+// XenosPixelConstants in gfx_xenos.h. sizes and misc change a draw, the rest with the combiner.
+layout(push_constant) uniform Push {
+	vec4 sizes;    // texture 0 width, height, texture 1 width, height
+	vec4 misc;     // frame count, noise scale, cycle 2 alpha wrap (0 narrow, 1 wide), cycle 2 colour wrap
+	vec4 opts0;    // alpha, fog, texture edge, noise
+	vec4 opts1;    // alpha threshold, invisible, grayscale, texture 0's blend (1) or none (0) under its mask
+	vec4 clamps;   // clamp s0, t0, s1, t1: 0 or 1
+	// Operand o (0 a - b, 1 c, 2 d of cycle 1; 3 to 5 cycle 2's), source s: w[o * 6 + s], s 0 texel0, 1 texel0
+	// alpha, 2 texel1, 3 texel1 alpha, 4 the first cycle's result, 5 noise.
+	vec4 w[36];
+} pc;
+
+#define WRAP(x, lo, hi) (mod((x) - (lo), (hi) - (lo)) + (lo))
+
+// Three-point filtering as libultraship's filter3point; every value named once, as xost wants with a discard. The
+// second and third texels sit one texel from the first, towards the triangle the sample is in: sign(o) is 1 - 2s
+// there, where |o| isn't 0 (oot360: 15 fewer instructions a texture than computing each coordinate apart).
+#define THREE_POINT(P_, tex, uv, size) \
+	vec2 P_##i = vec2(1.0) / (size); \
+	vec2 P_##f = fract((uv) * (size) - vec2(0.5)); \
+	float P_##s = step(1.0, P_##f.x + P_##f.y); \
+	vec2 P_##o = P_##f - vec2(P_##s); \
+	vec2 P_##b = (uv) - P_##o * P_##i; \
+	vec2 P_##d = (1.0 - 2.0 * P_##s) * P_##i; \
+	vec4 P_##c0 = texture(tex, P_##b); \
+	vec4 P_##c1 = texture(tex, vec2(P_##b.x + P_##d.x, P_##b.y)); \
+	vec4 P_##c2 = texture(tex, vec2(P_##b.x, P_##b.y + P_##d.y)); \
+	vec2 P_##w = abs(P_##o); \
+	vec4 P_ = P_##c0 + P_##w.x * (P_##c1 - P_##c0) + P_##w.y * (P_##c2 - P_##c0);
+
+// Each operand's pixel terms, only those the variant can weigh. The second cycle reads texel0 and texel1 swapped, as
+// libultraship does, so there texel0's weights take t1.
+#ifdef T0
+#define TEX0_C1(o) + t0 * pc.w[(o) * 6] + vec4(t0.a) * pc.w[(o) * 6 + 1]
+#define TEX0_C2(o) + t0 * pc.w[(o) * 6 + 2] + vec4(t0.a) * pc.w[(o) * 6 + 3]
+#else
+#define TEX0_C1(o)
+#define TEX0_C2(o)
+#endif
+#ifdef T1
+#define TEX1_C1(o) + t1 * pc.w[(o) * 6 + 2] + vec4(t1.a) * pc.w[(o) * 6 + 3]
+#define TEX1_C2(o) + t1 * pc.w[(o) * 6] + vec4(t1.a) * pc.w[(o) * 6 + 1]
+#else
+#define TEX1_C1(o)
+#define TEX1_C2(o)
+#endif
+#ifdef NOISE
+#define NOISE_T(o) + vec4(noise) * pc.w[(o) * 6 + 5]
+#else
+#define NOISE_T(o)
+#endif
+#define OP1(v, o) ((v) TEX0_C1(o) TEX1_C1(o) NOISE_T(o))
+#define OP2(v, o) ((v) TEX0_C2(o) TEX1_C2(o) + comb * pc.w[(o) * 6 + 4] NOISE_T(o))
+
+void main()
+{
+#ifdef T0
+	vec2 size0 = pc.sizes.xy;
+	// clamp() takes constant bounds on xost; min and max take any.
+	vec2 uv0 = mix(v_uv.xy, min(max(v_uv.xy, vec2(0.5) / size0), v_clamp.xy), pc.clamps.xy);
+#ifdef TP0
+	THREE_POINT(t0, u_tex0, uv0, size0)
+#else
+	vec4 t0 = texture(u_tex0, uv0);
+#endif
+#ifdef MASK0
+	t0 = mix(t0, texture(u_blend0, uv0) * pc.opts1.w, texture(u_mask0, uv0).a);
+#endif
+#endif
+#ifdef T1
+	vec2 size1 = pc.sizes.zw;
+	vec2 uv1 = mix(v_uv.zw, min(max(v_uv.zw, vec2(0.5) / size1), v_clamp.zw), pc.clamps.zw);
+#ifdef TP1
+	THREE_POINT(t1, u_tex1, uv1, size1)
+#else
+	vec4 t1 = texture(u_tex1, uv1);
+#endif
+#endif
+
+#ifdef NOISE
+	// A hash without sin, whose range on Xenos is about -pi to pi (xsc.md, "Approximate builtins").
+	vec3 np0 = fract(vec3(floor(gl_FragCoord.xy * pc.misc.y), pc.misc.x) * vec3(0.1031, 0.1030, 0.0973));
+	vec3 np = np0 + vec3(dot(np0, np0.yzx + vec3(33.33)));
+	float noise = fract((np.x + np.y) * np.z);
+#endif
+
+	// Cycle 1: colour in rgb, alpha in a.
+	vec4 r1 = OP1(v_ab0, 0) * OP1(v_c0, 1) + OP1(v_d0, 2);
+
+#ifdef CYC2
+	// Cycle 2 reads the first cycle's result wrapped.
+	vec4 comb = vec4(mix(WRAP(r1.rgb, vec3(-0.51), vec3(1.51)), WRAP(r1.rgb, vec3(-1.01), vec3(1.01)), pc.misc.w),
+		mix(WRAP(r1.a, -0.51, 1.51), WRAP(r1.a, -1.01, 1.01), pc.misc.z));
+	vec4 combined = OP2(v_ab1, 3) * OP2(v_c1, 4) + OP2(v_d1, 5);
+#else
+	vec4 combined = r1;
+#endif
+
+	vec4 texel = clamp(WRAP(combined, vec4(-0.51), vec4(1.51)), 0.0, 1.0);
+	float use_alpha = pc.opts0.x;
+	float alpha0 = mix(1.0, texel.a, use_alpha);
+	vec3 fogged = mix(texel.rgb, mix(texel.rgb, v_fog.rgb, v_fog.a), pc.opts0.y);
+
+	float edge = pc.opts0.z * use_alpha;
+	float edge_kill = edge * step(alpha0, 0.19);
+	float alpha1 = mix(alpha0, 1.0, edge);
+
+#ifdef NOISE
+	float noisy = floor(clamp(noise + alpha1, 0.0, 1.0));
+	float alpha2 = mix(alpha1, alpha1 * noisy, pc.opts0.w * use_alpha);
+#else
+	float alpha2 = alpha1;
+#endif
+
+	float intensity = (fogged.r + fogged.g + fogged.b) / 3.0;
+	vec3 shaded = mix(fogged, mix(fogged, v_gray.rgb * intensity, v_gray.a), pc.opts1.z);
+
+	float threshold_kill = pc.opts1.x * use_alpha * step(alpha2, 8.0 / 256.0 - 0.0001);
+	float alpha3 = mix(alpha2, 0.0, pc.opts1.y * use_alpha);
+	o_color = vec4(shaded, alpha3);
+#ifdef KILL
+	if (edge_kill + threshold_kill > 0.5)
+		discard;
+#endif
+}
diff --git a/src/fast/backends/xenos/fast3d.vert b/src/fast/backends/xenos/fast3d.vert
new file mode 100644
index 00000000..44dd2b31
--- /dev/null
+++ b/src/fast/backends/xenos/fast3d.vert
@@ -0,0 +1,71 @@
+#version 450
+// Fast3D vertex shader for the Xenos backend (gfx_xenos.cpp). The interpreter packs each vertex as its shader needs
+// (position, then per texture its coordinates and clamp limits, fog, grayscale, then the combiner inputs); the backend
+// points each input below at its place in that packing, or at the position for one the shader doesn't use, so one
+// vertex shader serves every combiner. xost maps location 0 to POSITION, 1 to COLOR and 2 on to TEXCOORD0 on.
+layout(location = 0) in vec4 a_pos;
+layout(location = 1) in vec4 a_in1;
+layout(location = 2) in vec2 a_uv0;
+layout(location = 3) in vec2 a_uv1;
+layout(location = 4) in float a_clamp_s0;
+layout(location = 5) in float a_clamp_t0;
+layout(location = 6) in float a_clamp_s1;
+layout(location = 7) in float a_clamp_t1;
+layout(location = 8) in vec4 a_fog;
+layout(location = 9) in vec4 a_gray;
+layout(location = 10) in vec4 a_in2;
+layout(location = 11) in vec4 a_in3;
+layout(location = 12) in vec4 a_in4;
+layout(location = 13) in vec4 a_in5;
+layout(location = 14) in vec4 a_in6;
+layout(location = 15) in vec4 a_in7;
+
+layout(location = 0) out vec4 v_uv;     // uv0.xy, uv1.xy
+layout(location = 1) out vec4 v_clamp;  // clamp limits s0, t0, s1, t1
+layout(location = 2) out vec4 v_fog;
+layout(location = 3) out vec4 v_gray;
+// The vertex's part of each combiner operand (fast3d.frag): cycle 1's a - b, c and d, then cycle 2's.
+layout(location = 4) out vec4 v_ab0;
+layout(location = 5) out vec4 v_c0;
+layout(location = 6) out vec4 v_d0;
+layout(location = 7) out vec4 v_ab1;
+layout(location = 8) out vec4 v_c1;
+layout(location = 9) out vec4 v_d1;
+
+// XenosVertexConstants in gfx_xenos.h.
+layout(push_constant) uniform Push {
+	// x: 1 to draw at prim_depth (G_ZS_PRIM), y: that depth, 0 to 1.
+	vec4 prim;
+	// Operand o's weight of input s (0 to 6) and its constant term (7): w[o * 8 + s], rgb colour, a alpha.
+	vec4 w[48];
+} pc;
+
+#define SEL(o) (a_in1 * pc.w[(o) * 8] + a_in2 * pc.w[(o) * 8 + 1] + a_in3 * pc.w[(o) * 8 + 2] + \
+	a_in4 * pc.w[(o) * 8 + 3] + a_in5 * pc.w[(o) * 8 + 4] + a_in6 * pc.w[(o) * 8 + 5] + a_in7 * pc.w[(o) * 8 + 6] + \
+	pc.w[(o) * 8 + 7])
+
+void main()
+{
+	vec4 p = a_pos;
+	// Prim depth is one depth for the whole draw: set in clip space, as the pixel shader writing depth would keep
+	// the GPU's hierarchical depth off.
+	p.z = mix(p.z, pc.prim.y * p.w, pc.prim.x);
+	// Libultraship's other backends clamp depth instead of clipping at the near plane (GL_DEPTH_CLAMP, D3D11's
+	// DepthClipEnable off, Metal's DepthClipModeClamp), so Link's hand and the slingshot in first person, nearer than
+	// the near plane, still draw. Xenos has no such switch, and holding each vertex's z to 0 (test 14) bent the depth
+	// of floors reaching under the camera, letting what's below them flicker through. Instead depth is remapped, z/w
+	// to (z/w + 3) / 4: the near plane moves to where z/w was -3, a quarter of its distance, far stays at 1, and as a
+	// linear change of clip space it clips and interpolates exactly; the depth buffer's 24 bits lose 2 of precision.
+	p.z = (p.z + 3.0 * p.w) * 0.25;
+	gl_Position = p;
+	v_uv = vec4(a_uv0, a_uv1);
+	v_clamp = vec4(a_clamp_s0, a_clamp_t0, a_clamp_s1, a_clamp_t1);
+	v_fog = a_fog;
+	v_gray = a_gray;
+	v_ab0 = SEL(0);
+	v_c0 = SEL(1);
+	v_d0 = SEL(2);
+	v_ab1 = SEL(3);
+	v_c1 = SEL(4);
+	v_d1 = SEL(5);
+}
diff --git a/src/fast/backends/xenos/fxaa.frag b/src/fast/backends/xenos/fxaa.frag
new file mode 100644
index 00000000..71f23954
--- /dev/null
+++ b/src/fast/backends/xenos/fxaa.frag
@@ -0,0 +1,49 @@
+#version 450
+// zeldaMM: anti-aliasing over the game's picture for the Xenos backend (gfx_xenos.cpp, PostProcessGame), drawn from
+// the screen's texture back into eDRAM before the menu draws: the console pass of FXAA (Timothy Lottes, NVIDIA, FXAA
+// 3.11), green standing for luma. Four samples half a texel off the pixel's corners find the edge's direction; two
+// and two more along it blend the pixel, the wider pair kept only where it stays within the corners' luma range. Where
+// the corners' contrast is low the pixel stays as it was. xost lowers no function calls and no branches beside each
+// other, so the choices are steps and mixes (fast3d.frag does the same).
+layout(location = 0) in vec2 v_uv;
+layout(location = 1) in vec4 v_color;
+layout(location = 0) out vec4 o_color;
+layout(set = 0, binding = 0) uniform sampler2D u_tex;
+layout(push_constant) uniform Push {
+	vec4 texel; // 1 / width, 1 / height of the picture, 0, 0
+} pc;
+
+void main()
+{
+	vec2 h = pc.texel.xy * 0.5;
+	float nw = texture(u_tex, v_uv - h).g;
+	float se = texture(u_tex, v_uv + h).g;
+	float ne = texture(u_tex, v_uv + vec2(h.x, -h.y)).g + 1.0 / 384.0;
+	float sw = texture(u_tex, v_uv + vec2(-h.x, h.y)).g;
+	vec4 m = texture(u_tex, v_uv);
+
+	float lmax = max(max(nw, sw), max(ne, se));
+	float lmin = min(min(nw, sw), min(ne, se));
+	// 1 where the contrast around the pixel is an edge's (FXAA's console thresholds: 1/8 of the brightest, and a floor
+	// of 0.02: FXAA 3.11 says to take its 0.05 towards zero with green as luma, as reds and blues read dark in green;
+	// lower still touched half of a gameplay frame's pixels, softening textures, for little more smoothing)
+	float edge = step(max(0.02, lmax * 0.125), max(lmax, m.g) - min(lmin, m.g));
+
+	float swne = sw - ne;
+	float senw = se - nw;
+	vec2 dir = vec2(swne + senw, swne - senw);
+	vec2 d1 = dir * inversesqrt(max(dot(dir, dir), 1.0e-8));
+	vec4 n1 = texture(u_tex, v_uv - d1 * h);
+	vec4 p1 = texture(u_tex, v_uv + d1 * h);
+	// The far pair, up to four texels out along the edge, further the more it runs along an axis (sharpness 8)
+	vec2 d2 = clamp(d1 / max(min(abs(d1.x), abs(d1.y)) * 8.0, 1.0e-4), -2.0, 2.0) * pc.texel.xy * 2.0;
+	vec4 n2 = texture(u_tex, v_uv - d2);
+	vec4 p2 = texture(u_tex, v_uv + d2);
+
+	vec4 a = (n1 + p1) * 0.5;
+	vec4 b = (n2 + p2) * 0.25 + a * 0.5;
+	// The four taps' luma outside the corners' range: they crossed another edge, the near pair alone then
+	float outside = max(1.0 - step(lmin, b.g), 1.0 - step(b.g, lmax));
+	vec3 aa = mix(b.rgb, a.rgb, outside);
+	o_color = vec4(mix(m.rgb, aa, edge), m.a);
+}
diff --git a/src/fast/backends/xenos/ui.frag b/src/fast/backends/xenos/ui.frag
new file mode 100644
index 00000000..05528e91
--- /dev/null
+++ b/src/fast/backends/xenos/ui.frag
@@ -0,0 +1,10 @@
+#version 450
+layout(location = 0) in vec2 v_uv;
+layout(location = 1) in vec4 v_color;
