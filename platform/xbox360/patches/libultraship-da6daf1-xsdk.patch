diff --git a/src/fast/CMakeLists.txt b/src/fast/CMakeLists.txt
index 66bf70d0..3de27100 100644
--- a/src/fast/CMakeLists.txt
+++ b/src/fast/CMakeLists.txt
@@ -39,5 +39,71 @@ if (CMAKE_SYSTEM_NAME STREQUAL "iOS")
     list(FILTER Source_Files__Graphic EXCLUDE REGEX "graphic/Fast3D/backends/gfx_opengl*")
 endif()
 
+if (XSDK)
+    # Xbox 360: no OpenGL/SDL video; the Xenos backend (gfx_xenos*) replaces them.
+    list(FILTER Source_Files__Graphic EXCLUDE REGEX "backends/gfx_(opengl|sdl2|dxgi|direct3d|metal)")
+endif()
+
+if (XSDK)
+    # The Xenos backend's shaders: fast3d.frag in 16 variants, one define per bit of XenosPixelVariant
+    # (gfx_xenos.h), compiled with xsdk's GLSL toolchain into libultraship_shaders.h.
+    set(XENOS_SHADER_DIR ${CMAKE_CURRENT_SOURCE_DIR}/backends/xenos)
+    file(READ ${XENOS_SHADER_DIR}/fast3d.frag XENOS_FAST3D_FRAG)
+    string(REGEX REPLACE "^#version 450\n" "" XENOS_FAST3D_BODY "${XENOS_FAST3D_FRAG}")
+    set(XENOS_SHADERS ${XENOS_SHADER_DIR}/fast3d.vert ${XENOS_SHADER_DIR}/ui.vert ${XENOS_SHADER_DIR}/ui.frag
+                      ${XENOS_SHADER_DIR}/fxaa.frag)
+    # One X(n) per variant, for gfx_xenos.cpp's tables of them.
+    set(XENOS_VARIANT_LIST "")
+    foreach(variant RANGE 0 255)
+        string(APPEND XENOS_VARIANT_LIST "XENOS_VARIANT(${variant})\n")
+        set(defines "")
+        foreach(bit_name IN ITEMS "1;TP0" "2;TP1" "4;CYC2" "8;KILL" "16;NOISE" "32;T0" "64;T1" "128;MASK0")
+            list(GET bit_name 0 bit)
+            list(GET bit_name 1 name)
+            math(EXPR has "${variant} & ${bit}")
+            if(has)
+                string(APPEND defines "#define ${name} 1\n")
+            endif()
+        endforeach()
+        set(out ${CMAKE_CURRENT_BINARY_DIR}/xenos/fast3d_v${variant}.frag)
+        set(content "#version 450\n${defines}${XENOS_FAST3D_BODY}")
+        if(EXISTS ${out})
+            file(READ ${out} old)
+        else()
+            set(old "")
+        endif()
+        if(NOT old STREQUAL content)
+            file(WRITE ${out} "${content}")
+        endif()
+        list(APPEND XENOS_SHADERS ${out})
+    endforeach()
+    set(XENOS_VARIANT_INC ${CMAKE_CURRENT_BINARY_DIR}/fast3d_variants.inc)
+    if(EXISTS ${XENOS_VARIANT_INC})
+        file(READ ${XENOS_VARIANT_INC} old)
+    else()
+        set(old "")
+    endif()
+    if(NOT old STREQUAL XENOS_VARIANT_LIST)
+        file(WRITE ${XENOS_VARIANT_INC} "${XENOS_VARIANT_LIST}")
+    endif()
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${XENOS_SHADER_DIR}/fast3d.frag)
+    # As xsdk_add_shaders does, but through a target of its own: libultraship is defined in the parent directory,
+    # which wouldn't see a custom command's output from here.
+    set(XENOS_SHADER_HEADER ${CMAKE_CURRENT_BINARY_DIR}/libultraship_shaders.h)
+    set(XENOS_GLSLANG "")
+    if(EXISTS "${XSDK_GLSLANG}")
+        set(XENOS_GLSLANG --glslang "${XSDK_GLSLANG}")
+    endif()
+    add_custom_command(OUTPUT ${XENOS_SHADER_HEADER}
+        COMMAND python3 "${XSDK_ROOT}/tools/build_shaders.py" ${XENOS_GLSLANG} --output ${XENOS_SHADER_HEADER}
+                ${XENOS_SHADERS}
+        DEPENDS ${XENOS_SHADERS} "${XSDK_ROOT}/tools/build_shaders.py"
+        COMMENT "Compiling the Xenos shaders"
+        VERBATIM)
+    add_custom_target(libultraship_xenos_shaders DEPENDS ${XENOS_SHADER_HEADER})
+    add_dependencies(libultraship libultraship_xenos_shaders)
+    target_include_directories(libultraship PRIVATE ${CMAKE_CURRENT_BINARY_DIR})
+endif()
+
 source_group("graphic" FILES ${Source_Files__Graphic})
 target_sources(libultraship PRIVATE ${Source_Files__Graphic})
