+#ifdef __XSDK__
+#include <mutex>
+#include <sched.h>
+
+// zeldaMM: the game, render and audio threads all read console variables, and the game thread also sets them during
+// play. An insert can rehash the map under a reader, an erase can free a node a reader is on. One recursive lock
+// around the map; it is held for a hash lookup, so a waiting thread spins (a kernel wait would cost far more) and
+// yields now and then in case the holder was preempted.
+namespace {
+__thread char sCVarThreadToken;
+uintptr_t sCVarLockOwner;
+uint32_t sCVarLockDepth;
+
+class CVarLock {
+  public:
+    CVarLock() {
+        const uintptr_t self = (uintptr_t)&sCVarThreadToken;
+        // Only this thread ever stores its own token, so seeing it means this thread holds the lock.
+        if (__atomic_load_n(&sCVarLockOwner, __ATOMIC_RELAXED) == self) {
+            sCVarLockDepth++;
+            return;
+        }
+        for (uint32_t spins = 1;; spins++) {
+            uintptr_t expected = 0;
+            if (__atomic_load_n(&sCVarLockOwner, __ATOMIC_RELAXED) == 0 &&
+                __atomic_compare_exchange_n(&sCVarLockOwner, &expected, self, false, __ATOMIC_ACQUIRE,
+                                            __ATOMIC_RELAXED)) {
+                break;
+            }
+            if ((spins & 1023) == 0) {
+                sched_yield();
+            }
+        }
+        sCVarLockDepth = 1;
+    }
+    ~CVarLock() {
+        if (--sCVarLockDepth == 0) {
+            __atomic_store_n(&sCVarLockOwner, (uintptr_t)0, __ATOMIC_RELEASE);
+        }
+    }
+    CVarLock(const CVarLock&) = delete;
+    CVarLock& operator=(const CVarLock&) = delete;
+};
+
+// The config's json: taken after the variables' lock when both are needed (the order everywhere), and alone while a
+// save writes the file. A kernel lock: a save holds it for the disk.
+std::recursive_mutex& ConfigMutex() {
+    static std::recursive_mutex mutex;
+    return mutex;
+}
+} // namespace
+#define CVAR_LOCK() CVarLock cvarLock
+#define CONFIG_LOCK() std::lock_guard<std::recursive_mutex> configLock(ConfigMutex())
+#else
+#define CVAR_LOCK() \
+    do {            \
+    } while (0)
+#define CONFIG_LOCK() \
+    do {              \
+    } while (0)
+#endif
