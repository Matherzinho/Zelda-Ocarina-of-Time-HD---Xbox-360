+volatile uint32_t* GfxRenderingAPIXenos::GpuTakeFree(uint32_t bytes) {
+    for (Pool& pool : mPools) {
+        for (auto it = pool.freeRanges.begin(); it != pool.freeRanges.end(); ++it) {
+            if (it->second >= bytes) {
+                const uint32_t offset = it->first;
+                const uint32_t size = it->second;
+                pool.freeRanges.erase(it);
+                if (size > bytes) {
+                    pool.freeRanges[offset + bytes] = size - bytes;
+                }
+                return pool.base + offset / 4;
+            }
+        }
+    }
+    return nullptr;
+}
+
+// A pool of poolBytes (in the SDK's 64 KB pages: what it takes anyway), the allocation straight out of it.
+volatile uint32_t* GfxRenderingAPIXenos::GpuNewPool(uint32_t poolBytes, uint32_t bytes) {
+    poolBytes = (poolBytes + 0xFFFFu) & ~0xFFFFu;
+    volatile uint32_t* base = xsdk_gpu_alloc(poolBytes);
+    if (!base) {
+        return nullptr;
+    }
+    Pool pool = { base, poolBytes, {} };
+    if (poolBytes > bytes) {
+        pool.freeRanges[bytes] = poolBytes - bytes;
+    }
+    mPools.push_back(std::move(pool));
+    if (poolBytes >= (1u << 20) || mPools.size() % 16 == 0) {
+        xsdk_log_write("xenos: GPU pool %u: %u KB", (unsigned)mPools.size(), (unsigned)(poolBytes >> 10));
+    }
+    if (poolBytes >= kPoolBytes) {
+        Oot360_LogMemory("after a GPU pool");
+    }
+    return base;
+}
+
+volatile uint32_t* GfxRenderingAPIXenos::GpuAlloc(uint32_t bytes) {
+    bytes = (bytes + kTextureAlign - 1) & ~(kTextureAlign - 1);
+    if (volatile uint32_t* p = GpuTakeFree(bytes)) {
+        return p;
+    }
+    // None free: a pool more, 16 MB (a big allocation gets one of its own size), unless that failed lately (the SDK
+    // logs each failure, a hitch). Short of that, first take back what waits to be freed (pools are never freed,
+    // so growing before taking it back kept the memory for good): wait until the GPU has done everything queued so
+    // far (this frame's draws too, which no frame fence covers yet), once a frame at most (a texture cache emptied
+    // uploads hundreds a frame), the GPU held back for timing let go first as for the other waits in a frame, and
+    // only if the GPU got there. Then smaller pools, down to the request's own size. zeldaMM: this used to queue each
+    // block again while walking the queue (a block came back twice, the second time while a new texture had it), and
+    // then to drop a pool made on its last attempt, and to make pools of the request's size before taking anything
+    // back (reviews of test 1f's and 1g's changes).
+    if (mFrame >= mBigPoolRetryFrame) {
+        if (volatile uint32_t* p = GpuNewPool(std::max(kPoolBytes, bytes), bytes)) {
+            return p;
+        }
+        mBigPoolRetryFrame = mFrame + 600;
+    }
+    if (!mPendingFrees.empty() && mReclaimFrame != mFrame) {
+        mReclaimFrame = mFrame;
+        if (mTimingGateClosed) {
+            mTimingValid = false;
+            TimingOpenGate();
+        }
+        if (NT_SUCCESS(xsdk_gpu_wait(xsdk_gpu_fence(), kFenceTimeoutMs))) {
+            for (const GpuBlock& b : mPendingFrees) {
+                GpuReturn(b);
+            }
+            mPendingFrees.clear();
+            if (volatile uint32_t* p = GpuTakeFree(bytes)) {
+                return p;
+            }
+        }
+    }
+    static const uint32_t kSmallerPools[] = { 4u << 20, 1u << 20, 256u << 10 };
+    for (uint32_t poolBytes : kSmallerPools) {
+        if (poolBytes > bytes) {
+            if (volatile uint32_t* p = GpuNewPool(poolBytes, bytes)) {
+                return p;
+            }
+        }
+    }
+    if (volatile uint32_t* p = GpuNewPool(bytes, bytes)) {
+        return p;
+    }
+    static unsigned sOutOfMemory;
+    if (sOutOfMemory++ < 16) {
+        xsdk_log_write("xenos: out of GPU memory for %u bytes", (unsigned)bytes);
+    }
+    return nullptr;
+}
+
+void GfxRenderingAPIXenos::GpuFreeLater(volatile uint32_t* memory, uint32_t bytes) {
+    if (!memory) {
+        return;
+    }
+    bytes = (bytes + kTextureAlign - 1) & ~(kTextureAlign - 1);
+    mPendingFrees.push_back({ memory, bytes, mFrame });
+}
+
+void GfxRenderingAPIXenos::GpuReturn(const GpuBlock& b) {
+    for (Pool& pool : mPools) {
+        const uintptr_t start = (uintptr_t)pool.base;
+        const uintptr_t at = (uintptr_t)b.memory;
+        if (at >= start && at < start + pool.bytes) {
+            uint32_t offset = (uint32_t)(at - start);
+            uint32_t size = b.bytes;
+            // Merge with the neighbours.
+            auto next = pool.freeRanges.lower_bound(offset);
+            if (next != pool.freeRanges.end() && offset + size == next->first) {
+                size += next->second;
+                next = pool.freeRanges.erase(next);
+            }
+            if (next != pool.freeRanges.begin()) {
+                auto prev = std::prev(next);
+                if (prev->first + prev->second == offset) {
+                    prev->second += size;
+                    return;
+                }
+            }
+            pool.freeRanges[offset] = size;
+            return;
+        }
+    }
+}
+
+void GfxRenderingAPIXenos::GpuReclaim() {
+    // A block freed in frame f is free once frame f's fence has landed (or frame f had no fence yet).
+    auto done = [&](uint64_t frame) {
+        auto it = mFenceOfFrame.find(frame);
+        if (it == mFenceOfFrame.end()) {
+            return frame < mFrame; // no draw used it in a frame not yet fenced
+        }
+        return xsdk_gpu_fence_done(it->second);
+    };
+    auto keep = std::remove_if(mPendingFrees.begin(), mPendingFrees.end(), [&](const GpuBlock& b) {
+        if (!done(b.frame)) {
+            return false;
+        }
+        GpuReturn(b);
+        return true;
+    });
+    mPendingFrees.erase(keep, mPendingFrees.end());
+    for (auto it = mFenceOfFrame.begin(); it != mFenceOfFrame.end();) {
+        it = (it->first + 8 < mFrame) ? mFenceOfFrame.erase(it) : std::next(it);
+    }
+}
+
+void GfxRenderingAPIXenos::Init() {
+    NTSTATUS s = xsdk_shader_load(&mBlitVertex, ui_vert.container, ui_vert.container_bytes);
+    if (NT_SUCCESS(s)) {
+        s = xsdk_shader_set_vertex_layout(&mBlitVertex, kUiLayout, 3, (const uint32_t[]){ sizeof(UiVertex) });
+    }
+    if (NT_SUCCESS(s)) {
+        s = xsdk_shader_load(&mBlitPixel, ui_frag.container, ui_frag.container_bytes);
+    }
+    for (uint32_t v = 0; v < XENOS_PS_VARIANTS && NT_SUCCESS(s); v++) {
+        s = xsdk_shader_load(&mPixelShaders[v], kPixelVariants[v]->container, kPixelVariants[v]->container_bytes);
+    }
+    if (!NT_SUCCESS(s)) {
+        xsdk_log_write("xenos: loading shaders failed: 0x%08X", (unsigned)s);
+    }
+    {
+        // zeldaMM: the anti-aliasing pass's; without it the option does nothing.
+        const NTSTATUS f = xsdk_shader_load(&mFxaaPixel, fxaa_frag.container, fxaa_frag.container_bytes);
+        mFxaaLoaded = NT_SUCCESS(f) && NT_SUCCESS(s); // drawn with the blit vertex shader, loaded above
+        if (!mFxaaLoaded) {
+            xsdk_log_write("xenos: loading the FXAA shader failed: 0x%08X", (unsigned)f);
+        }
+    }
+
+    for (uint32_t i = 0; i < kFramesInFlight; i++) {
+        mVertexRing[i] = xsdk_gpu_alloc(kVertexRingBytes);
+        if (i == 0) {
+            mTimingMem = xsdk_gpu_alloc(0x10000);
+        }
+        if (!mVertexRing[i]) {
+            xsdk_log_write("xenos: no GPU memory for the vertex ring");
+        }
+    }
+
+    for (int test = 0; test < 2; test++) {
+        for (int write = 0; write < 2; write++) {
+            for (int decal = 0; decal < 2; decal++) {
+                XsdkDepthStencil d = {};
+                d.depth_test = test || write;
+                d.depth_write = write;
+                d.depth_compare = test ? (decal ? XSDK_COMPARE_LESS_EQUAL : XSDK_COMPARE_LESS) : XSDK_COMPARE_ALWAYS;
+                xsdk_gpu_depth_stencil_state(&mDepthStates[test * 4 + write * 2 + decal], &d);
+            }
+        }
+    }
+    const XsdkBlend off = { XSDK_BLEND_ONE, XSDK_BLEND_ZERO, XSDK_BLEND_OP_ADD, XSDK_BLEND_ONE, XSDK_BLEND_ZERO,
+                            XSDK_BLEND_OP_ADD, XSDK_WRITE_ALL, false };
+    const XsdkBlend alpha = { XSDK_BLEND_SRC_ALPHA, XSDK_BLEND_ONE_MINUS_SRC_ALPHA, XSDK_BLEND_OP_ADD,
+                              XSDK_BLEND_SRC_ALPHA, XSDK_BLEND_ONE_MINUS_SRC_ALPHA, XSDK_BLEND_OP_ADD,
+                              XSDK_WRITE_ALL, false };
+    xsdk_gpu_blend_state(&mBlendOff, &off);
+    xsdk_gpu_blend_state(&mBlendAlpha, &alpha);
+    // Decals as libultraship's OpenGL backend (glPolygonOffset(-2, -2)). Xenos's offset is in normalized depth, as
+    // Direct3D 9's DEPTHBIAS (xenia: poly_offset_front_offset), not GL's resolvable steps: -2 there pulled every
+    // decal (paths, Link's shadow) in front of everything, over Link's feet and through walls (console test 8).
+    // Two steps of the 24-bit depth buffer it is.
+    const XsdkRaster normal = { XSDK_CULL_NONE, false, 0.0f, 0.0f, XSDK_FILL_SOLID };
+    const XsdkRaster decal = { XSDK_CULL_NONE, false, -2.0f / 16777216.0f, -2.0f, XSDK_FILL_SOLID };
+    xsdk_gpu_raster_state(&mRasterNormal, &normal);
+    xsdk_gpu_raster_state(&mRasterDecal, &decal);
+    const XsdkSampler blit = { .mag_filter = XSDK_FILTER_LINEAR,
+                               .min_filter = XSDK_FILTER_LINEAR,
+                               .mip_filter = XSDK_FILTER_POINT,
+                               .address_u = XSDK_ADDRESS_CLAMP,
+                               .address_v = XSDK_ADDRESS_CLAMP };
+    xsdk_texture_sampler_state(&mBlitSampler, &blit);
+    // zeldaMM: framebuffer copies and restores read texel for texel, as the PC's do (OpenGL's glBlitFramebuffer with
+    // GL_NEAREST, Direct3D 11's CopySubresourceRegion). The bilinear filter isn't exact at texel centres on Xenos (up
+    // to 8/255 towards the texel above or to the left, xsdk docs/HARDWARE.md), so each restore through mBlitSampler
+    // moved sharp edges a little.
+    const XsdkSampler copy = { .mag_filter = XSDK_FILTER_POINT,
+                               .min_filter = XSDK_FILTER_POINT,
+                               .mip_filter = XSDK_FILTER_POINT,
+                               .address_u = XSDK_ADDRESS_CLAMP,
+                               .address_v = XSDK_ADDRESS_CLAMP };
+    xsdk_texture_sampler_state(&mCopySampler, &copy);
+
+    mTextures.resize(1); // id 0 is no texture
+    // A white texel: clears draw with it, and samplers the combiner doesn't read point at it.
+    mWhiteTexture = NewTexture();
+    {
+        XenosTexture& w = Texture(mWhiteTexture);
+        const uint8_t white[4] = { 0xFF, 0xFF, 0xFF, 0xFF };
+        if (CreateTextureStorage(w, XSDK_FORMAT_R8G8B8A8, 1, 1, false, 1)) {
+            xsdk_texture_upload(&w.texture, 0, white, 4);
+            xsdk_gpu_invalidate(w.texture.address, w.texture.size_bytes);
+        }
+        ApplySampler(w);
+    }
+    mFramebuffers.resize(1); // the screen
+    mFramebuffers[0].width = mWindow->DisplayWidth();
+    mFramebuffers[0].height = mWindow->DisplayHeight();
+    mFramebuffers[0].hasDepth = true;
+    mFramebuffers[0].textureId = NewTexture();
+    sZeldaMMXenos = this;
+    xsdk_log_write("xenos: renderer ready");
+    Oot360_LogMemory("xenos renderer ready");
+}
