+// ---------------------------------------------------------------------------------------------------------------
+// Shaders
+
+XsdkShader* GfxRenderingAPIXenos::VertexShaderFor(const CCFeatures& cc, uint8_t* numFloats) {
+    // The interpreter's packing (interpreter.cpp, the vertex loop) in fast3d.vert's input locations.
+    struct Input {
+        bool present;
+        uint32_t format;
+        uint32_t offset;
+    } in[16] = {};
+    const uint32_t vec4Format[5] = { 0, XSDK_VERTEX_FLOAT1, XSDK_VERTEX_FLOAT2, XSDK_VERTEX_FLOAT3,
+                                     XSDK_VERTEX_FLOAT4 };
+    uint32_t pos = 0;
+    in[0] = { true, XSDK_VERTEX_FLOAT4, 0 };
+    pos += 4;
+    for (int t = 0; t < 2; t++) {
+        if (!cc.usedTextures[t]) {
+            continue;
+        }
+        in[2 + t] = { true, XSDK_VERTEX_FLOAT2, pos * 4 };
+        pos += 2;
+        for (int j = 0; j < 2; j++) {
+            if (cc.clamp[t][j]) {
+                in[4 + t * 2 + j] = { true, XSDK_VERTEX_FLOAT1, pos * 4 };
+                pos += 1;
+            }
+        }
+    }
+    if (cc.opt_fog) {
+        in[8] = { true, XSDK_VERTEX_FLOAT4, pos * 4 };
+        pos += 4;
+    }
+    if (cc.opt_grayscale) {
+        in[9] = { true, XSDK_VERTEX_FLOAT4, pos * 4 };
+        pos += 4;
+    }
+    const uint32_t inputFloats = cc.opt_alpha ? 4 : 3;
+    for (int i = 0; i < cc.numInputs && i < 7; i++) {
+        const int location = i == 0 ? 1 : 10 + (i - 1);
+        in[location] = { true, vec4Format[inputFloats], pos * 4 };
+        pos += inputFloats;
+    }
+    *numFloats = (uint8_t)pos;
+
+    const uint64_t key = LayoutKey(cc);
+    auto found = mVertexShaders.find(key);
+    if (found != mVertexShaders.end()) {
+        return found->second;
+    }
+
+    // Inputs the combiner doesn't use read the position: the pixel shader weighs them by 0.
+    const uint32_t declared[16] = { XSDK_VERTEX_FLOAT4, XSDK_VERTEX_FLOAT4, XSDK_VERTEX_FLOAT2, XSDK_VERTEX_FLOAT2,
+                                    XSDK_VERTEX_FLOAT1, XSDK_VERTEX_FLOAT1, XSDK_VERTEX_FLOAT1, XSDK_VERTEX_FLOAT1,
+                                    XSDK_VERTEX_FLOAT4, XSDK_VERTEX_FLOAT4, XSDK_VERTEX_FLOAT4, XSDK_VERTEX_FLOAT4,
+                                    XSDK_VERTEX_FLOAT4, XSDK_VERTEX_FLOAT4, XSDK_VERTEX_FLOAT4, XSDK_VERTEX_FLOAT4 };
+    XsdkVertexElement layout[16] = {};
+    for (int l = 0; l < 16; l++) {
+        layout[l].usage = l == 0 ? XSDK_USAGE_POSITION : l == 1 ? XSDK_USAGE_COLOR : XSDK_USAGE_TEXCOORD;
+        layout[l].usage_index = l < 2 ? 0 : l - 2;
+        layout[l].format = in[l].present ? in[l].format : declared[l];
+        layout[l].stream = 0;
+        layout[l].offset_bytes = in[l].present ? in[l].offset : 0;
+    }
+    auto* shader = new XsdkShader();
+    NTSTATUS s = xsdk_shader_load(shader, fast3d_vert.container, fast3d_vert.container_bytes);
+    if (NT_SUCCESS(s)) {
+        s = xsdk_shader_set_vertex_layout(shader, layout, 16, (const uint32_t[]){ pos * 4 });
+    }
+    if (!NT_SUCCESS(s)) {
+        xsdk_log_write("xenos: vertex shader for layout %llx failed: 0x%08X", (unsigned long long)key, (unsigned)s);
+    }
+    mVertexShaders[key] = shader;
+    return shader;
+}
+
+void GfxRenderingAPIXenos::BuildCombinerConstants(const CCFeatures& cc, ShaderProgram& prg) {
+    XenosVertexConstants& v = prg.vertexConstants;
+    XenosPixelConstants& out = prg.pixelConstants;
+    memset(&v, 0, sizeof v);
+    memset(&out, 0, sizeof out);
+    bool noise = cc.opt_noise;
+    for (int cyc = 0; cyc < (cc.opt_2cyc ? 2 : 1); cyc++) {
+        int colorItems[4], alphaItems[4];
+        for (int k = 0; k < 4; k++) {
+            colorItems[k] = cc.c[cyc][0][k];
+            // Where colour and alpha share their formula, the alpha comes from the colour's sources' alphas.
+            alphaItems[k] = (cc.color_alpha_same[cyc] || !cc.opt_alpha) ? cc.c[cyc][0][k] : cc.c[cyc][1][k];
+            noise = noise || colorItems[k] == SHADER_NOISE || alphaItems[k] == SHADER_NOISE;
+        }
+        CycleWeights(v, out, cyc, colorItems, 0, 3);
+        CycleWeights(v, out, cyc, alphaItems, 3, 1);
+    }
+    out.opts0[0] = cc.opt_alpha;
+    out.opts0[1] = cc.opt_fog;
+    out.opts0[2] = cc.opt_texture_edge;
+    out.opts0[3] = cc.opt_noise;
+    out.opts1[0] = cc.opt_alpha_threshold;
+    out.opts1[1] = cc.opt_invisible;
+    out.opts1[2] = cc.opt_grayscale;
+    out.opts1[3] = cc.used_masks[0] && cc.used_blend[0];
+    out.clamps[0] = cc.usedTextures[0] && cc.clamp[0][0];
+    out.clamps[1] = cc.usedTextures[0] && cc.clamp[0][1];
+    out.clamps[2] = cc.usedTextures[1] && cc.clamp[1][0];
+    out.clamps[3] = cc.usedTextures[1] && cc.clamp[1][1];
+    out.misc[2] = cc.c[1][1][2] == SHADER_COMBINED;
+    out.misc[3] = cc.c[1][0][2] == SHADER_COMBINED;
+
+    prg.variant = 0;
+    if (cc.opt_2cyc) {
+        prg.variant |= XENOS_PS_CYC2;
+    }
+    if (cc.opt_alpha && (cc.opt_texture_edge || cc.opt_alpha_threshold)) {
+        prg.variant |= XENOS_PS_KILL;
+    }
+    if (noise) {
+        prg.variant |= XENOS_PS_NOISE;
+    }
+    if (cc.usedTextures[0]) {
+        prg.variant |= XENOS_PS_T0;
+    }
+    if (cc.usedTextures[1]) {
+        prg.variant |= XENOS_PS_T1;
+    }
+    if (cc.used_masks[0]) {
+        prg.variant |= XENOS_PS_MASK0;
+    }
+}
+
+ShaderProgram* GfxRenderingAPIXenos::CreateAndLoadNewShader(uint64_t shaderId0, uint64_t shaderId1) {
+    CCFeatures cc;
+    gfx_cc_get_features(shaderId0, shaderId1, &cc);
+    ShaderProgram& prg = mShaderPool[std::make_pair(shaderId0, shaderId1)];
+    prg.shaderId0 = shaderId0;
+    prg.shaderId1 = shaderId1;
+    prg.numInputs = cc.numInputs;
+    prg.usedTextures[0] = cc.usedTextures[0];
+    prg.usedTextures[1] = cc.usedTextures[1];
+    prg.twoCycle = cc.opt_2cyc;
+    prg.mayKill = cc.opt_alpha && (cc.opt_texture_edge || cc.opt_alpha_threshold);
+    prg.primDepth = cc.opt_prim_depth;
+    prg.vertex = VertexShaderFor(cc, &prg.numFloats);
+    BuildCombinerConstants(cc, prg);
+    if (cc.used_masks[1]) {
+        static bool warned = false;
+        if (!warned) {
+            warned = true;
+            xsdk_log_write("xenos: a mask over texture 1 is not drawn yet (texture 0's is)");
+        }
+    }
+    LoadShader(&prg);
+    return &prg;
+}
+
+ShaderProgram* GfxRenderingAPIXenos::LookupShader(uint64_t shaderId0, uint64_t shaderId1) {
+    auto it = mShaderPool.find(std::make_pair(shaderId0, shaderId1));
+    return it == mShaderPool.end() ? nullptr : &it->second;
+}
