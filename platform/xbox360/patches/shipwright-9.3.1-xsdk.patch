+// oot360: whether a mod's name says it's in Brazilian Portuguese: "PT-BR", "pt_br", "Pt Br", "PTBR"..., in any case,
+// not inside a word ("Script Brush" isn't).
+static bool Oot360_IsPortugueseMod(const std::string& name) {
+    std::string s(name);
+    for (char& c : s) {
+        c = (char)std::tolower((unsigned char)c);
+    }
+    for (size_t at = s.find("pt"); at != std::string::npos; at = s.find("pt", at + 1)) {
+        if (at > 0 && std::isalpha((unsigned char)s[at - 1])) {
+            continue;
+        }
+        size_t br = at + 2;
+        if (br < s.size() && (s[br] == '-' || s[br] == '_' || s[br] == ' ' || s[br] == '.')) {
+            br++;
+        }
+        if (s.compare(br, 2, "br") == 0 && (br + 2 >= s.size() || !std::isalpha((unsigned char)s[br + 2]))) {
+            return true;
+        }
+    }
+    return false;
+}
