+static void* XboxMainThread(void* arg) {
+    // xsdk starts a thread on its creator's hardware thread, so everything ran on hardware thread 0. The game takes
+    // core 1 (hardware thread 2), its audio mixing core 2 (4, OTRAudio_Thread), SDL's audio feeder 5; loading
+    // threads stay with the main thread on core 0.
+    NTSTATUS moved = xsdk_thread_move(2);
