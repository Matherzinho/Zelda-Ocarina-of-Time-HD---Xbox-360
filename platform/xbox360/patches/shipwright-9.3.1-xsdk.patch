+// The mods are mounted (the mod menu's InitElement): the archives' files indexed by directory now (Oot360_Prefetch,
+// Oot360_SceneResources), and the directories whose display lists a mod brings told apart by the files' names (the
+// mods' display lists and their vertices and triangles carry "DL" or "vtx", the game's textures don't). Their
+// textures are drawn with the mod's own UVs, so the game's own can't stand in for them while their HD versions load
+// (libultraship's Oot360_LoadTextureNoWait): Djipi's 3DS Experience has 3DS models for most objects and many scenes.
+extern "C" void Oot360_FindModelDirectories(void) {
+    const uint64_t start = __builtin_ppc_get_timebase();
+    for (const auto& [directory, files] : DirectoryIndex()) {
+        if (!directory.starts_with("alt/")) {
+            continue;
+        }
+        for (const auto& f : files) {
+            const std::string_view name = std::string_view(f).substr(f.rfind('/') + 1);
+            if (name.find("DL") != std::string_view::npos || name.find("vtx") != std::string_view::npos ||
+                name.find("Vtx") != std::string_view::npos || name.find("VTX") != std::string_view::npos) {
+                sModelDirectories.insert(directory.substr(4));
+                break;
+            }
+        }
+    }
+    Ship::Oot360_SetOwnTextureTest(Oot360_IsModelDirectory);
+    SPDLOG_INFO("oot360: {} directories with a mod's models, found in {} ms", sModelDirectories.size(),
+                (unsigned)((__builtin_ppc_get_timebase() - start) / 49875));
+}
