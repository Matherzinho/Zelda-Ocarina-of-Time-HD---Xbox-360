+        mTimeSplitsWindow,
+        mTimeSplitSettingsWindow,
+        mPlandomizerWindow,
+        gui->GetGuiWindow("Configure Controller"),
+    };
+    for (const auto& window : windows) {
+        if (window != nullptr && window->IsVisible()) {
+            return true;
+        }
+    }
+    return mModalWindow != nullptr && mModalWindow->PopupsQueued() > 0;
+}
+#endif
 } // namespace SohGui
