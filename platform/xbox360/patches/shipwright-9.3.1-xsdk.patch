+#define OOT360_ACTOR_IDS 0x200
+static u64 sOot360ActorUpdateTicks[OOT360_ACTOR_IDS];
+static u64 sOot360ActorDrawTicks[OOT360_ACTOR_IDS];
+static u32 sOot360ActorUpdates[OOT360_ACTOR_IDS];
+
+static void Oot360_LogTopActors(const char* what, u64* ticks, u32 frames) {
+    char line[400];
+    u64 total = 0;
+    s32 id;
+    s32 k;
+    s32 n;
+    u32 totalHundredths;
+
+    for (id = 0; id < OOT360_ACTOR_IDS; id++) {
+        total += ticks[id];
+    }
+    // the time base runs at 49.875 MHz; hundredths of a millisecond
+    totalHundredths = (u32)(total * 100 / 49875 / frames);
+    n = snprintf(line, sizeof(line), "oot360: actors' %s, ms a game frame: all %u.%02u;", what,
+                 (unsigned)(totalHundredths / 100), (unsigned)(totalHundredths % 100));
+    for (k = 0; k < 6; k++) {
+        s32 best = -1;
+        u32 hundredths;
+
+        for (id = 0; id < OOT360_ACTOR_IDS; id++) {
+            if (ticks[id] != 0 && (best < 0 || ticks[id] > ticks[best])) {
+                best = id;
+            }
+        }
+        if (best < 0) {
+            break;
+        }
+        hundredths = (u32)(ticks[best] * 100 / 49875 / frames);
+        if (n < (s32)sizeof(line) - 40) {
+            n += snprintf(line + n, sizeof(line) - n, " 0x%03X %u.%02u (%u)", (unsigned)best,
+                          (unsigned)(hundredths / 100), (unsigned)(hundredths % 100),
+                          (unsigned)(sOot360ActorUpdates[best] / frames));
+        }
+        ticks[best] = 0;
+    }
+    xsdk_log_write("%s", line);
+}
