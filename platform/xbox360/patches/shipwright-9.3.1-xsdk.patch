+    Oot360_LogTopActors("draws", sOot360ActorDrawTicks, frames);
+    memset(sOot360ActorUpdateTicks, 0, sizeof(sOot360ActorUpdateTicks));
+    memset(sOot360ActorDrawTicks, 0, sizeof(sOot360ActorDrawTicks));
+    memset(sOot360ActorUpdates, 0, sizeof(sOot360ActorUpdates));
