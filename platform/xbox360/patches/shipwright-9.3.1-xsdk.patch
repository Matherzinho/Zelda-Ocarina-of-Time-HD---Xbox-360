+// directory -> its files, every archive's (alt/ ones under their alt/ directory)
+std::unordered_map<std::string, std::vector<std::string>>& DirectoryIndex() {
+    static std::unordered_map<std::string, std::vector<std::string>> index;
+    static bool built = false;
+    if (!built) {
+        built = true;
+        const uint64_t start = __builtin_ppc_get_timebase();
+        auto files = Ship::Context::GetRawInstance()->GetResourceManager()->GetArchiveManager()->ListFiles("*");
+        for (const auto& f : *files) {
+            const size_t slash = f.rfind('/');
+            if (slash != std::string::npos) {
+                index[f.substr(0, slash)].push_back(f);
+            }
+        }
+        SPDLOG_INFO("oot360: {} files in {} directories indexed in {} ms", files->size(), index.size(),
+                    (unsigned)((__builtin_ppc_get_timebase() - start) / 49875));
+    }
+    return index;
+}
+
+const std::vector<std::string>& FilesOf(const std::string& directory) {
+    static const std::vector<std::string> none;
+    auto& index = DirectoryIndex();
+    auto it = index.find(directory);
+    return it == index.end() ? none : it->second;
+}
