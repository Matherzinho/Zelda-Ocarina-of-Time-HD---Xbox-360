+#ifdef __XSDK__
+// oot360: the Fast3D interpreter and the GPU run on a thread of their own, a frame behind the game: while the
+// render thread draws frame N (its display list in one of OoT's two graphics pools, its interpolated matrices worked
+// out here first), the game thread runs frame N+1's logic. Before handing over the next frame, and before anything
+// the interpreter shares with the game changes (game state changes, texture cache edits, resource directories),
+// the game thread waits for the render (Oot360_RenderWait). With a menu open, frames draw on the game thread as
+// before, since the menus' callbacks change game state.
+namespace {
+struct Oot360RenderFrame {
+    float t;
+    std::unordered_map<Mtx*, MtxF> replacements;
+};
+std::mutex sRenderMutex;
+std::condition_variable sRenderCv;
+uint64_t sRenderSubmitted = 0;
+uint64_t sRenderCompleted = 0;
+bool sRenderThreadStarted = false;
+Gfx* sRenderCommands = nullptr;
+std::vector<Oot360RenderFrame> sRenderFrames;
+
+void Oot360_DrawFrames(Gfx* commands, std::vector<Oot360RenderFrame>& frames) {
+    auto wnd = std::dynamic_pointer_cast<Fast::Fast3dWindow>(OTRGlobals::Instance->context->GetWindow());
+    if (wnd == nullptr) {
+        return;
+    }
+    auto intp = wnd->GetInterpreterWeak().lock().get();
+    intp->mInterpolationIndex = 0;
+    UIWidgets::Colors themeColor =
+        static_cast<UIWidgets::Colors>(CVarGetInteger(CVAR_SETTING("Menu.Theme"), UIWidgets::Colors::LightBlue));
+    ImGui::PushStyleColor(ImGuiCol_TitleBgActive, UIWidgets::ColorValues.at(themeColor));
+    for (auto& frame : frames) {
+        intp->mInterpolationT = frame.t;
+        wnd->DrawAndRunGraphicsCommands(commands, frame.replacements);
+        intp->mInterpolationIndex++;
+    }
+    ImGui::PopStyleColor();
+}
+
+void Oot360_RenderThread() {
+    Oot360_ProfileAsRender();
+    NTSTATUS moved = xsdk_thread_move(1);
+    xsdk_log_write("soh: render thread on hardware thread 1: 0x%08X", (unsigned)moved);
+    for (;;) {
+        Gfx* commands;
+        std::vector<Oot360RenderFrame> frames;
+        uint64_t job;
+        OOT360_PHASE("render thread: idle");
+        {
+            std::unique_lock<std::mutex> lock(sRenderMutex);
+            sRenderCv.wait(lock, [] { return sRenderSubmitted != sRenderCompleted; });
+            commands = sRenderCommands;
+            frames.swap(sRenderFrames);
+            job = sRenderSubmitted;
+        }
+        OOT360_PHASE("render thread: draw");
+        Oot360_DrawFrames(commands, frames);
+        {
+            std::lock_guard<std::mutex> lock(sRenderMutex);
+            sRenderCompleted = job;
+        }
+        sRenderCv.notify_all();
+    }
+}
+} // namespace
+
+extern "C" void Oot360_RenderWait(void) {
+    std::unique_lock<std::mutex> lock(sRenderMutex);
+    sRenderCv.wait(lock, [] { return sRenderSubmitted == sRenderCompleted; });
+}
+#endif
