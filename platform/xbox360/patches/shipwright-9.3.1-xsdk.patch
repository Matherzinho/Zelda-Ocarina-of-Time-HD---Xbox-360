diff --git a/soh/soh/platform/xbox360/AudioTrace.c b/soh/soh/platform/xbox360/AudioTrace.c
new file mode 100644
index 00000000..60178a3c
--- /dev/null
+++ b/soh/soh/platform/xbox360/AudioTrace.c
@@ -0,0 +1,36 @@
+// Xbox 360 audio diagnostics: what the game's audio engine is doing, logged now and then from the audio thread
+// (OTRGlobals.cpp, OTRAudio_Thread), to tell a silent engine (no sequence, no notes, volume 0) from a silent output.
+#ifdef __XSDK__
+#include "z64.h"
+#include <xsdk/log.h>
+
+extern AudioContext gAudioContext;
+
+float AudioSettings_GetMasterVolume(void);
+
+void Oot360_AudioTrace(void) {
+    static unsigned calls;
+    if (++calls % 300 != 0) {
+        return;
+    }
+    int enabledNotes = 0, playingNotes = 0;
+    for (int i = 0; i < gAudioContext.numNotes; i++) {
+        Note* note = &gAudioContext.notes[i];
+        if (note->noteSubEu.bitField0.enabled) {
+            enabledNotes++;
+            if (note->noteSubEu.targetVolLeft || note->noteSubEu.targetVolRight) {
+                playingNotes++;
+            }
+        }
+    }
+    xsdk_log_write("audio: tasks %u reset %u notes %d enabled %d audible %d master %.2f | players %d:%04x %d:%04x "
+                   "%d:%04x %d:%04x vol %.2f fade %.2f",
+                   (unsigned)gAudioContext.totalTaskCnt, (unsigned)gAudioContext.resetStatus,
+                   (int)gAudioContext.numNotes, enabledNotes, playingNotes, AudioSettings_GetMasterVolume(),
+                   gAudioContext.seqPlayers[0].enabled, gAudioContext.seqPlayers[0].seqId,
+                   gAudioContext.seqPlayers[1].enabled, gAudioContext.seqPlayers[1].seqId,
+                   gAudioContext.seqPlayers[2].enabled, gAudioContext.seqPlayers[2].seqId,
+                   gAudioContext.seqPlayers[3].enabled, gAudioContext.seqPlayers[3].seqId,
+                   gAudioContext.seqPlayers[0].volume, gAudioContext.seqPlayers[0].appliedFadeVolume);
+}
+#endif
diff --git a/soh/soh/platform/xbox360/MemTrace.c b/soh/soh/platform/xbox360/MemTrace.c
new file mode 100644
index 00000000..84fe7e32
--- /dev/null
+++ b/soh/soh/platform/xbox360/MemTrace.c
@@ -0,0 +1,400 @@
+#ifdef __XSDK__
+// Memory diagnostics for the Xbox 360 build: the link wraps malloc, calloc, realloc and memalign
+// (soh/CMakeLists.txt, -Wl,--wrap=...) and this logs every allocation of 2 MB or more, and every failure, with the
+// callers' return addresses (map them with powerpc-xsdk-elf-addr2line -f -C -e soh), and the memory the title has.
+#include <malloc.h>
+#include <stdio.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <xsdk/kernel.h>
+#include <xsdk/log.h>
+
+void* __real_malloc(size_t size);
+void* __real_calloc(size_t count, size_t size);
+void* __real_realloc(void* ptr, size_t size);
+void* __real_memalign(size_t align, size_t size);
+
+#define OOT360_BIG_ALLOCATION (2u << 20)
+
+static int sInTrace;
+
+void Oot360_LogMemory(const char* where) {
+    MM_QUERY_STATISTICS_RESULT st = { .size = sizeof(st) };
+    struct mallinfo mi;
+    if (sInTrace) {
+        return;
+    }
+    sInTrace = 1;
+    mi = mallinfo();
+    if (NT_SUCCESS(MmQueryStatistics(&st))) {
+        xsdk_log_write("mem: %s: free %u KB, image %u KB, heap pages %u KB, physical %u KB; malloc arena %u KB, in use "
+                       "%u KB",
+                       where, (unsigned)(st.title.available_pages * 4), (unsigned)(st.title.image_pages * 4),
+                       (unsigned)(st.title.heap_pages * 4), (unsigned)(st.title.physical_pages * 4),
+                       (unsigned)(mi.arena >> 10), (unsigned)(mi.uordblks >> 10));
+    }
+    sInTrace = 0;
+}
+
+// oot360 (from zeldaMM): the title's free memory in KB (the pages the kernel has left: malloc's arena and the GPU's
+// pools both grow from them), or 0 if unknown. Scene changes evict resources below a threshold (OTRGlobals.cpp,
+// Oot360_SceneResources).
+// malloc keeps what it was given: memory freed in its arena (mallinfo's fordblks) is free for the game too, though the
+// kernel's count doesn't show it.
+unsigned Oot360_FreeMemoryKB(void) {
+    MM_QUERY_STATISTICS_RESULT st = { .size = sizeof(st) };
+    if (NT_SUCCESS(MmQueryStatistics(&st))) {
+        struct mallinfo mi = mallinfo();
+        return (unsigned)(st.title.available_pages * 4) + (unsigned)(mi.fordblks >> 10);
+    }
+    return 0;
+}
+
+static void NoteAllocation(const char* what, size_t size, void* result, void* r0, void* r1, void* r2, void* r3) {
+    if (sInTrace) {
+        return;
+    }
+    sInTrace = 1;
+    xsdk_log_write("mem: %s(%u) = %p from %p %p %p %p", what, (unsigned)size, result, r0, r1, r2, r3);
+    sInTrace = 0;
+    if (!result) {
+        Oot360_LogMemory("after a failed allocation");
+    }
+}
+
+// The heap's span as malloc has handed it out, so pointers into it can be told from N64 segment addresses
+// (Oot360_IsHeapAddress, used by the Fast3D interpreter in place of dladdr). Threads allocate at once, so the bounds
+// only ever move outwards, by compare-and-swap: a plain store could put back a narrower bound another thread had just
+// widened, and textures in between would be dropped until the next allocation there.
+static uintptr_t sHeapLow = UINTPTR_MAX;
+static uintptr_t sHeapHigh = 0;
+
+static inline void Span(void* p, size_t size) {
+    if (p) {
+        const uintptr_t a = (uintptr_t)p;
+        const uintptr_t end = a + size;
+        uintptr_t low = __atomic_load_n(&sHeapLow, __ATOMIC_RELAXED);
+        while (a < low && !__atomic_compare_exchange_n(&sHeapLow, &low, a, 1, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+        }
+        uintptr_t high = __atomic_load_n(&sHeapHigh, __ATOMIC_RELAXED);
+        while (end > high &&
+               !__atomic_compare_exchange_n(&sHeapHigh, &high, end, 1, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+        }
+    }
+}
+
+int Oot360_IsHeapAddress(uintptr_t address) {
+    return address >= __atomic_load_n(&sHeapLow, __ATOMIC_RELAXED) &&
+           address < __atomic_load_n(&sHeapHigh, __ATOMIC_RELAXED);
+}
+
+// PowerPC frames keep a back chain, so the callers a few frames up can be read.
+#define CALLERS __builtin_return_address(0), __builtin_return_address(1), __builtin_return_address(2), \
+                __builtin_return_address(3)
+
+void* __wrap_malloc(size_t size) {
+    void* p = __real_malloc(size);
+    Span(p, size);
+    if (size >= OOT360_BIG_ALLOCATION || !p) {
+        NoteAllocation("malloc", size, p, CALLERS);
+    }
+    return p;
+}
+
+void* __wrap_calloc(size_t count, size_t size) {
+    void* p = __real_calloc(count, size);
+    Span(p, count * size);
+    if (count * size >= OOT360_BIG_ALLOCATION || !p) {
+        NoteAllocation("calloc", count * size, p, CALLERS);
+    }
+    return p;
+}
+
+void* __wrap_realloc(void* ptr, size_t size) {
+    void* p = __real_realloc(ptr, size);
+    Span(p, size);
+    if (size >= OOT360_BIG_ALLOCATION || (!p && size)) {
+        NoteAllocation("realloc", size, p, CALLERS);
+    }
+    return p;
+}
+
+void* __wrap_memalign(size_t align, size_t size) {
+    void* p = __real_memalign(align, size);
+    Span(p, size);
+    if (size >= OOT360_BIG_ALLOCATION || !p) {
+        NoteAllocation("memalign", size, p, CALLERS);
+    }
+    return p;
+}
+#endif
+
+#ifdef __XSDK__
+// Hang diagnostics. Oot360_Phase records what the game thread is doing; a heartbeat thread logs it every 2 s with
+// the frame count, so a hang that leaves the CPU running names the step it stopped in, and a log that stops outright
+// points at the console locking up (a stack overflow, docs/HARDWARE.md in xsdk).
+#include <pthread.h>
+#include <time.h>
+
+static const char* volatile sPhase = "start";
+static volatile unsigned sPhaseCount;
+
+// Time per phase, from the CPU's time base (49.875 MHz), one table for the game thread and one for the render thread
+// (Oot360_ProfileAsRender): the heartbeat logs where each spent the last 10 s.
+#define OOT360_PHASES 32
+typedef struct {
+    const char* name;
+    uint64_t ticks;
+} PhaseTime;
+static PhaseTime sPhaseTime[2][OOT360_PHASES];
+static __thread int sProfileTable;
+static __thread int sPhaseIndex = -1;
+static __thread uint64_t sPhaseStart;
+
+void Oot360_ProfileAsRender(void) {
+    sProfileTable = 1;
+    sPhaseIndex = -1;
+}
+
+void Oot360_Phase(const char* phase) {
+    const uint64_t now = __builtin_ppc_get_timebase();
+    PhaseTime* table = sPhaseTime[sProfileTable];
+    if (sPhaseIndex >= 0) {
+        table[sPhaseIndex].ticks += now - sPhaseStart;
+    }
+    int i = 0;
+    while (i < OOT360_PHASES && table[i].name && table[i].name != phase) {
+        i++;
+    }
+    if (i < OOT360_PHASES) {
+        table[i].name = phase;
+    }
+    sPhaseIndex = i < OOT360_PHASES ? i : -1;
+    sPhaseStart = now;
+    sPhase = phase;
+    sPhaseCount++;
+}
+
+static void LogPhaseTimes(void) {
+    for (int t = 0; t < 2; t++) {
+        PhaseTime* table = sPhaseTime[t];
+        uint64_t total = 0;
+        for (int i = 0; i < OOT360_PHASES && table[i].name; i++) {
+            total += table[i].ticks;
+        }
+        if (!total) {
+            continue;
+        }
+        char line[512];
+        int n = snprintf(line, sizeof line, "profile %s:", t ? "render" : "game");
+        for (int i = 0; i < OOT360_PHASES && table[i].name; i++) {
+            const unsigned pct = (unsigned)(table[i].ticks * 1000 / total);
+            if (pct >= 5 && n < (int)sizeof line - 48) {
+                n += snprintf(line + n, sizeof line - n, " %s %u.%u%%;", table[i].name, pct / 10, pct % 10);
+            }
+            table[i].ticks = 0;
+        }
+        xsdk_log_write("%s", line);
+    }
+}
+
+static void* Heartbeat(void* arg) {
+    unsigned last = 0;
+    for (;;) {
+        struct timespec ts = { 2, 0 };
+        nanosleep(&ts, NULL);
+        const unsigned now = sPhaseCount;
+        xsdk_log_write("alive: phase \"%s\" (%u steps, %u since the last beat)", sPhase, now, now - last);
+        last = now;
+        static unsigned beats;
+        if (++beats % 5 == 0) {
+            LogPhaseTimes();
+        }
+        if (beats == 300) {
+            void Oot360_BootGuardClean(const char* why);
+            Oot360_BootGuardClean("ten minutes running");
+        }
+    }
+    return NULL;
+}
+
+void Oot360_StartHeartbeat(void) {
+    pthread_t t;
+    pthread_create(&t, NULL, Heartbeat, NULL);
+    pthread_detach(t);
+}
+
+// Threads get at least 4 MB of stack: xsdk's default is 1 MB, and a stack overflow locks the console up without a
+// word in the log. Each thread made is logged with its entry point.
+int __real_pthread_create(pthread_t* thread, const pthread_attr_t* attr, void* (*start)(void*), void* arg);
+
+int __wrap_pthread_create(pthread_t* thread, const pthread_attr_t* attr, void* (*start)(void*), void* arg) {
+    enum { MIN_STACK = 4u << 20 };
+    // xsdk has no attribute getters, so a caller's own attributes are kept as given; std::thread passes none.
+    if (attr) {
+        const int r = __real_pthread_create(thread, attr, start, arg);
+        xsdk_log_write("thread: %p with its own attributes: %d", (void*)start, r);
+        return r;
+    }
+    pthread_attr_t mine;
+    pthread_attr_init(&mine);
+    pthread_attr_setstacksize(&mine, MIN_STACK);
+    const int r = __real_pthread_create(thread, &mine, start, arg);
+    pthread_attr_destroy(&mine);
+    xsdk_log_write("thread: %p, %u KB of stack: %d", (void*)start, (unsigned)(MIN_STACK >> 10), r);
+    return r;
+}
+#endif
+
+#ifdef __XSDK__
+// oot360 test 23: a start-up guard. Test 22 closed on the console soon after starting, and a log doesn't always come
+// back, so the game remembers whether its last start got as far as playing: a count in game:\oot360-boot.txt
+// (cache:\ where game:\ can't be written, as in Xenia) goes up at every start and back to 0 once a file has been played
+// for a minute, after ten minutes running, or when Back+Start quits. A start that finds 1 there runs in safe mode 1
+// (no loading ahead); 2, safe mode 2 (also frames drawn on the game thread); 3 or more, safe mode 3 (also no mods, no
+// FXAA, no mip levels). Test 23's safe mode 1 turned both of the first two off at once, so a crash it avoided could
+// have been either's, and the frames on the game thread made it slow; one at a time now (test 24). Each step back says
+// so in the log and on screen (OTRGlobals.cpp), and the next clean run returns to normal.
+#include <string.h>
+
+static int sSafeLevel;
+static int sBootPrevious;
+static volatile int sBootClean;
+static const char* sBootPath;
+
+static int ReadBootCount(const char* path) {
+    FILE* f = fopen(path, "rb");
+    if (!f) {
+        return -1;
+    }
+    char text[16] = { 0 };
+    const size_t n = fread(text, 1, sizeof text - 1, f);
+    fclose(f);
+    int count = 0;
+    for (size_t i = 0; i < n && text[i] >= '0' && text[i] <= '9'; i++) {
+        count = count * 10 + (text[i] - '0');
+        if (count > 99) {
+            break;
+        }
+    }
+    return count;
+}
+
+static int WriteBootCount(const char* path, int count) {
+    FILE* f = fopen(path, "wb");
+    if (!f) {
+        return 0;
+    }
+    char text[16];
+    const int n = snprintf(text, sizeof text, "%d\r\n", count);
+    const size_t written = fwrite(text, 1, (size_t)n, f);
+    fclose(f);
+    return written == (size_t)n;
+}
+
+void Oot360_BootGuardStart(void) {
+    static const char* const kPaths[] = { "game:\\oot360-boot.txt", "cache:\\oot360-boot.txt" };
+    int previous = -1;
+    for (int i = 0; i < 2 && previous < 0; i++) {
+        previous = ReadBootCount(kPaths[i]);
+        if (previous >= 0) {
+            sBootPath = kPaths[i];
+        }
+    }
+    if (previous < 0) {
+        previous = 0;
+    }
+    sBootPrevious = previous;
+    sSafeLevel = previous >= 3 ? 3 : previous;
+    // Written where it was found, else the first place that takes it.
+    if (!sBootPath || !WriteBootCount(sBootPath, previous + 1)) {
+        sBootPath = NULL;
+        for (int i = 0; i < 2 && !sBootPath; i++) {
+            if (WriteBootCount(kPaths[i], previous + 1)) {
+                sBootPath = kPaths[i];
+            }
+        }
+    }
+    xsdk_log_write("boot: %d start(s) without a clean run before this one (%s): %s", previous,
+                   sBootPath ? sBootPath : "nowhere to write it",
+                   sSafeLevel == 0   ? "normal start"
+                   : sSafeLevel == 1 ? "SAFE MODE 1: no loading ahead"
+                   : sSafeLevel == 2 ? "SAFE MODE 2: no loading ahead, no render thread"
+                                     : "SAFE MODE 3: no loading ahead, no render thread, no mods, no FXAA, no mip levels");
+}
+
+void Oot360_BootGuardClean(const char* why) {
+    if (__atomic_exchange_n(&sBootClean, 1, __ATOMIC_ACQ_REL)) {
+        return;
+    }
+    const int ok = sBootPath != NULL && WriteBootCount(sBootPath, 0);
+    xsdk_log_write("boot: clean run (%s)%s", why, ok ? "" : ", but the count couldn't be written");
+}
+
+int Oot360_SafeLevel(void) {
+    return sSafeLevel;
+}
+
+// oot360 test 24: the last start's log, kept. xsdk's start-up opens the log (start.c) before anything of the game's
+// runs, and opening it empties it, so a start that closed the game left nothing to read once it was opened again: test
+// 23's safe mode came back with the log of the start after the crash, not of the crash. The linker sends start.c's call
+// here (soh/CMakeLists.txt, -Wl,--wrap=xsdk_log_open), which copies the log to soh-anterior.log first, where it opens
+// (game:\, else cache:\ as in Xenia). Kernel calls only, as log.c's own: this runs before the log's lock exists, and
+// the C library's open() logs its failures (file.c), which took the lock uninitialised and left test 24's first build
+// on a black screen. Nothing is logged here.
+NTSTATUS __real_xsdk_log_open(void);
+
+static NTSTATUS KeepLastLogOpen(HANDLE* handle, const char* path, int write) {
+    const ANSI_STRING name = {
+        .length = (uint16_t)strlen(path),
+        .maximum_length = (uint16_t)(strlen(path) + 1),
+        .pointer = path,
+    };
+    const OBJECT_ATTRIBUTES attributes = { .root_directory = OB_DOS_DEVICES, .name = &name };
+    IO_STATUS_BLOCK io_status;
+    return NtCreateFile(handle, (write ? GENERIC_WRITE : GENERIC_READ) | SYNCHRONIZE, &attributes, &io_status, NULL,
+                        FILE_ATTRIBUTE_NORMAL, FILE_SHARE_READ, write ? FILE_OVERWRITE_IF : FILE_OPEN,
+                        FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE);
+}
+
+static void KeepLastLog(void) {
+    static const char* const kPairs[][2] = {
+        { "game:\\soh.log", "game:\\soh-anterior.log" },
+        { "cache:\\soh.log", "cache:\\soh-anterior.log" },
+    };
+    static char buffer[64 << 10];
+    for (int i = 0; i < 2; i++) {
+        HANDLE in;
+        if (!NT_SUCCESS(KeepLastLogOpen(&in, kPairs[i][0], 0))) {
+            continue;
+        }
+        HANDLE out;
+        if (NT_SUCCESS(KeepLastLogOpen(&out, kPairs[i][1], 1))) {
+            // at most 64 MB, so a runaway log can't hold the start up
+            for (int chunk = 0; chunk < 1024; chunk++) {
+                IO_STATUS_BLOCK io_status;
+                if (!NT_SUCCESS(NtReadFile(in, 0, NULL, NULL, &io_status, buffer, sizeof buffer, NULL)) ||
+                    io_status.information == 0) {
+                    break;
+                }
+                const uint32_t n = io_status.information;
+                if (!NT_SUCCESS(NtWriteFile(out, 0, NULL, NULL, &io_status, buffer, n, NULL))) {
+                    break;
+                }
+            }
+            NtClose(out);
+        }
+        NtClose(in);
+        return;
+    }
+}
+
+NTSTATUS __wrap_xsdk_log_open(void) {
+    KeepLastLog();
+    return __real_xsdk_log_open();
+}
+
+int Oot360_BootFailures(void) {
+    return sBootPrevious;
+}
+#endif
