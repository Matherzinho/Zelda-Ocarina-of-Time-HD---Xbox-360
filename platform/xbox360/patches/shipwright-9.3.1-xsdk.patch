+    pthread_attr_init(&attr);
+    // The Windows build links with /STACK:16777216; give the game the same.
+    pthread_attr_setstacksize(&attr, 16u << 20);
+    if (pthread_create(&thread, &attr, XboxMainThread, NULL) != 0) {
+        xsdk_log_write("soh: no thread for the game; running it on the main thread");
+        return SohMain(argc, argv);
+    }
+    pthread_join(thread, NULL);
