 extern "C" void ResourceMgr_UnloadResource(const char* resName) {
     std::string path = resName;
     if (path.substr(0, 7) == "__OTR__") {
         path = path.substr(7);
     }
+#ifdef __XSDK__
+    // oot360: a loaded resource goes with the render thread idle (it may draw from it, a frame behind the game) and out
+    // of the interpreter's texture cache too, which has textures by their address: the N64 texture that stood in for an
+    // HD one while it loaded (libultraship's Oot360_LoadTextureNoWait), unloaded by UnloadOriginalWhenAltExists, would
+    // leave its entry behind for another texture at that address to hit. What isn't loaded costs no wait (the 2D rooms
+    // ask each frame).
+    {
+        auto manager = Ship::Context::GetRawInstance()->GetResourceManager();
+        auto resource = manager->GetCachedResource(path, true);
+        if (resource != nullptr) {
+            Oot360_RenderWait();
+            std::vector<std::pair<uintptr_t, uintptr_t>> memory;
+            const uintptr_t start = (uintptr_t)resource->GetRawPointer();
+            const size_t size = resource->GetPointerSize();
+            if (start != 0 && size != 0) {
+                memory.emplace_back(start, start + size);
+            }
+            resource.reset();
+            manager->UnloadResource(path);
+            ZeldaMM_TextureCacheDeleteRanges(memory);
+            return;
+        }
+    }
+#endif
     auto res = Ship::Context::GetRawInstance()->GetResourceManager()->UnloadResource(path);
 }
 
