+void OTRGlobals::RunExtract(int argc, char* argv[]) {
+    auto wnd = std::dynamic_pointer_cast<Fast::Fast3dWindow>(OTRGlobals::Instance->context->GetWindow());
+    auto gui = wnd->GetGui();
+    const OTRVersion vanillaVersion = DetectOTRVersion("oot.o2r", false);
+    const OTRVersion mqVersion = DetectOTRVersion("oot-mq.o2r", true);
+    const bool haveRom =
+        std::filesystem::exists(Ship::Context::LocateFileAcrossAppDirs("oot-mq.o2r", appShortName)) ||
+        std::filesystem::exists(Ship::Context::LocateFileAcrossAppDirs("oot.o2r", appShortName));
+    const std::string version = std::to_string(gBuildVersionMajor) + "." + std::to_string(gBuildVersionMinor) + "." +
+                                std::to_string(gBuildVersionPatch);
+    std::string problem;
+    if (!sohArchiveVersionMatch) {
+        problem = "soh.o2r is missing or from another version.\n\nCopy the soh.o2r of Ship of Harkinian " + version +
+                  "\nnext to the XEX.";
+    } else if (!haveRom) {
+        problem = "No oot.o2r found.\n\nRun Ship of Harkinian " + version +
+                  " on a PC once with your own\nOcarina of Time ROM, then copy oot.o2r next to the XEX.";
+    } else if (VerifyArchiveVersion(vanillaVersion) || VerifyArchiveVersion(mqVersion)) {
+        problem = "oot.o2r was made by another version of Ship of Harkinian.\n\nMake it again with version " +
+                  version + ".";
+    }
+    if (problem.empty()) {
+        return;
+    }
+    SPDLOG_ERROR("Game data: {}", problem);
+    SohGui::RegisterPopup("Game data needed", problem, "OK", "", []() { exit(1); });
+    while (WindowIsRunning()) {
+        wnd->HandleEvents();
+        if (!wnd->IsFrameReady()) {
+            continue;
+        }
+        gui->StartDraw();
+        sohFast3dWindow->StartFrame();
+        sohFast3dWindow->RunGuiOnly();
+        gui->EndDraw();
+        sohFast3dWindow->EndFrame();
+    }
+    exit(1);
+}
