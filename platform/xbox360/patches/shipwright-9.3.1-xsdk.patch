+// The directory's files (and their alt/ ones) unloaded, the memory each held added to `memory` ([start, end)), for the
+// interpreter's texture cache (ZeldaMM_TextureCacheDeleteRanges); how many were loaded.
+size_t Oot360_Evict(const std::string& directory, std::vector<std::pair<uintptr_t, uintptr_t>>& memory) {
+    auto manager = Ship::Context::GetRawInstance()->GetResourceManager();
+    size_t unloaded = 0;
+    for (const std::string& d : { directory, "alt/" + directory }) {
+        for (const auto& f : FilesOf(d)) {
+            auto resource = manager->GetCachedResource(f, true);
+            if (resource != nullptr) {
+                const uintptr_t start = (uintptr_t)resource->GetRawPointer();
+                const size_t size = resource->GetPointerSize();
+                if (start != 0 && size != 0) {
+                    memory.emplace_back(start, start + size);
+                }
+                resource.reset(); // before the unload, which may free it
+                unloaded++;
+            }
+            manager->UnloadResource(f);
+        }
+        sPrefetched.erase(d);
+    }
+    return unloaded;
+}
