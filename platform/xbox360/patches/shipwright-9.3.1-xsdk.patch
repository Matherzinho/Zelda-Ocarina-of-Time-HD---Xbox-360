+static void Oot360_Terminate() {
+    if (std::exception_ptr e = std::current_exception()) {
+        try {
+            std::rethrow_exception(e);
+        } catch (const std::exception& x) {
+            xsdk_log_write("terminate: %s: %s", typeid(x).name(), x.what());
+        } catch (...) {
+            xsdk_log_write("terminate: an exception that isn't a std::exception");
+        }
+    }
+    uintptr_t* sp;
+    __asm__ volatile("mr %0, 1" : "=r"(sp));
+    for (int i = 0; i < 32 && sp != nullptr; i++) {
+        uintptr_t* next = (uintptr_t*)sp[0]; // the back chain; the caller's LR is saved one word above it
+        if (next <= sp || (uintptr_t)next - (uintptr_t)sp > (16u << 20)) {
+            break;
+        }
+        xsdk_log_write("terminate: from 0x%08X", (unsigned)next[1]);
+        sp = next;
+    }
+    abort();
+}
+#endif
