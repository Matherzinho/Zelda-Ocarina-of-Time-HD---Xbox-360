+// Whether there's memory to load the next scene during the fade out, before the scene change evicts the old ones
+// (Oot360_SceneResources): short of it, the old ones go first.
+extern "C" bool Oot360_RoomToLoadAhead(void) {
+    const unsigned freeKB = Oot360_FreeMemoryKB();
+    return freeKB == 0 || freeKB >= kRoomKB;
+}
+
+extern "C" void Oot360_Prefetch(const char* directory) {
+    if (directory == nullptr || directory[0] == '\0' || (!CVarGetInteger("gOot360.Prefetch", 1) || Oot360_SafeLevel() > 0)) {
+        return;
+    }
+    auto manager = Ship::Context::GetRawInstance()->GetResourceManager();
+    const std::string dir = directory;
+    if (sPrefetched.insert(dir).second) {
+        TheLoader().Add(FilesOf(dir));
+    }
+    if (manager->IsAltAssetsEnabled()) {
+        const std::string alt = "alt/" + dir;
+        if (sPrefetched.insert(alt).second) {
+            TheLoader().Add(FilesOf(alt));
+        }
+    }
+}
+
+// A texture the game sets up by path a while before drawing it: the skies and the rooms painted on a sky's panels
+// (z_vr_box.c, as a scene loads and as the time of day changes the sky). Loaded ahead on the loader threads, and its
+// directory remembered, as Ship of Harkinian no longer unloads every HD texture at each scene change (game.c): the
+// scenes' eviction (Oot360_SceneResources) takes the skies no recent scene set up.
+extern "C" void Oot360_PrefetchTexture(const char* path) {
+    if (path == nullptr || path[0] == '\0') {
+        return;
+    }
+    std::string file = path;
+    if (file.starts_with("__OTR__")) {
+        file.erase(0, 7);
+    }
+    const size_t slash = file.rfind('/');
+    if (slash == std::string::npos) {
+        return;
+    }
+    sTextureDirLastUse[file.substr(0, slash)] = sSceneCount;
+    if ((!CVarGetInteger("gOot360.Prefetch", 1) || Oot360_SafeLevel() > 0)) {
+        return;
+    }
+    // its HD version and the N64 one that stands in while it uploads (the loader's own logic)
+    TheLoader().Add({ file });
+}
+
+static std::string Oot360_ObjectDirectory(s16 id) {
+    if (id > 0 && id < OBJECT_ID_MAX && gObjectTable[id].fileName != nullptr && gObjectTable[id].fileName[0] != '\0') {
+        return std::string("objects/") + gObjectTable[id].fileName;
+    }
+    return std::string();
+}
+
+extern "C" void Oot360_PrefetchObject(s16 id) {
+    const std::string directory = Oot360_ObjectDirectory(id);
+    if (!directory.empty()) {
+        sObjectLastUse[directory] = sSceneCount;
+        Oot360_Prefetch(directory.c_str());
+    }
+}
+
+// The scene's directory, as OTRPlay_SpawnScene (z_play_otr.cpp) names its files.
+static std::string Oot360_SceneDirectory(s32 sceneId) {
+    if (sceneId < 0 || sceneId >= SCENE_ID_MAX || gSceneTable[sceneId].sceneFile.fileName == nullptr) {
+        return std::string();
+    }
+    const bool hasMqVariant = (sceneId >= SCENE_DEKU_TREE && sceneId <= SCENE_ICE_CAVERN) ||
+                              sceneId == SCENE_GERUDO_TRAINING_GROUND || sceneId == SCENE_INSIDE_GANONS_CASTLE;
+    const char* version = !hasMqVariant ? "shared" : (ResourceMgr_IsSceneMasterQuest(sceneId) ? "mq" : "nonmq");
+    return StringHelper::Sprintf("scenes/%s/%s", version, gSceneTable[sceneId].sceneFile.fileName);
+}
+
+// A transition to another scene has begun (z_play.c, TRANS_MODE_SETUP): its fade out takes a third of a second or
+// more, time enough for the loaders to read much of the next scene before its first frame (zeldaMM's test 1c: 581
+// resources, 1.1 s, loaded by the render thread in the new scene's first frame).
+extern "C" void Oot360_PrefetchSceneOfEntrance(s32 entrance) {
+    // Short of memory, the old scenes go first, at the scene change, and the new one loads after.
+    if (entrance < 0 || entrance >= ENTR_MAX || !Oot360_RoomToLoadAhead()) {
+        return;
+    }
+    const std::string directory = Oot360_SceneDirectory(gEntranceTable[entrance].scene);
+    if (!directory.empty()) {
+        Oot360_Prefetch(directory.c_str());
+    }
+}
+
+// The objects a room (or the scene, or one of their alternate headers: child or adult, day or night, cutscenes) lists.
+static void Oot360_ListedObjects(const std::shared_ptr<SOH::Scene>& room, std::unordered_set<s16>& ids, int depth) {
+    if (room == nullptr || depth > 4) {
+        return;
+    }
+    for (const auto& cmd : room->commands) {
+        if (cmd == nullptr) {
+            continue;
+        }
+        if (cmd->cmdId == SOH::SceneCommandID::SetObjectList) {
+            for (s16 id : std::static_pointer_cast<SOH::SetObjectList>(cmd)->objects) {
+                ids.insert(id);
+            }
+        } else if (cmd->cmdId == SOH::SceneCommandID::SetAlternateHeaders) {
+            for (const auto& header : std::static_pointer_cast<SOH::SetAlternateHeaders>(cmd)->headers) {
+                Oot360_ListedObjects(header, ids, depth + 1);
+            }
+        }
+    }
+}
+
+// A scene is about to load (OTRPlay_SpawnScene, in the transition's black screen, before its object lists): evict what
+// the last scenes left, then load the new one: its directory, then the objects its rooms list, waited for. The render
+// thread is waited for before evicting, as it may still draw the last frame from the resources going, and what goes
+// leaves the texture cache with it, as its entries are keyed by the freed textures' addresses.
+extern "C" void Oot360_SceneResources(const char* sceneDirectory) {
+    const std::string scene = sceneDirectory;
+    sSceneCount++;
+    auto it = std::find(sRecentScenes.begin(), sRecentScenes.end(), scene);
+    if (it != sRecentScenes.end()) {
+        sRecentScenes.erase(it);
+    }
+    sRecentScenes.push_back(scene);
+
+    // Old scenes go while memory is short (below kRoomKB), oldest first, and beyond a dozen; when it's low (below
+    // kLowMemoryKB), the objects no scene asked for lately too.
+    const unsigned freeBefore = Oot360_FreeMemoryKB();
+    const unsigned freeKB = freeBefore;
+    const uint64_t evictStart = __builtin_ppc_get_timebase();
+    // What's unloaded is freed only once the render thread's own lookups let go (its next frame), so the count
+    // doesn't move here: one scene a change while short, all but the new one when low.
+    const bool shortOfMemory = freeKB != 0 && freeKB < kRoomKB;
+    const bool low = freeKB != 0 && freeKB < kLowMemoryKB;
+    size_t keep = low ? 1 : std::min(kScenesKept, shortOfMemory ? sRecentScenes.size() - 1 : sRecentScenes.size());
+    keep = std::max<size_t>(keep, 1);
+    std::vector<std::string> going;
+    while (sRecentScenes.size() > keep) {
+        const std::string old = sRecentScenes.front();
+        sRecentScenes.erase(sRecentScenes.begin());
+        if (!Oot360_AlwaysKept(old)) {
+            going.push_back(old);
+        }
+    }
+    // Scenes loaded during a fade out and never entered (an entrance the game changed after, or the randomizer's
+    // shuffled ones): no list above holds them.
+    for (const auto& d : sPrefetched) {
+        if (d.starts_with("scenes/") && std::find(sRecentScenes.begin(), sRecentScenes.end(), d) == sRecentScenes.end() &&
+            !Oot360_AlwaysKept(d) && std::find(going.begin(), going.end(), d) == going.end()) {
+            going.push_back(d);
+        }
+    }
+    if (low) {
+        // The objects of the scene just left were asked for at sSceneCount - 1; older ones go.
+        for (auto obj = sObjectLastUse.begin(); obj != sObjectLastUse.end();) {
+            if (obj->second + 1 < sSceneCount && !Oot360_AlwaysKept(obj->first)) {
+                going.push_back(obj->first);
+                obj = sObjectLastUse.erase(obj);
+            } else {
+                ++obj;
+            }
+        }
+    }
+    // The skies and painted rooms (a few megabytes each in HD) no scene set up lately: while memory is short, those the
+    // scene just left didn't use (the next one sets its own up after this, from its scene commands); else those of
+    // scenes beyond the dozen kept.
+    for (auto dir = sTextureDirLastUse.begin(); dir != sTextureDirLastUse.end();) {
+        if ((shortOfMemory && dir->second + 1 < sSceneCount) || dir->second + kScenesKept < sSceneCount) {
+            going.push_back(dir->first);
+            dir = sTextureDirLastUse.erase(dir);
+        } else {
+            ++dir;
+        }
+    }
+    if (shortOfMemory) {
+        // by the plain directory, which Oot360_Evict takes with its alt/ one (some exist in the packs only)
+        std::unordered_set<std::string> seen;
+        for (const auto& entry : DirectoryIndex()) {
+            const std::string d = entry.first.starts_with("alt/") ? entry.first.substr(4) : entry.first;
+            if (Oot360_ShownSometimes(d) && seen.insert(d).second) {
+                going.push_back(d);
+            }
+        }
+    }
+    const size_t evicted = going.size();
+    if (evicted != 0) {
+        // Nothing of these half-loaded behind our back: what the loaders haven't started of them is dropped, what
+        // they're loading waited for. Then the render thread, which may still draw from them.
+        std::unordered_set<std::string> dirs;
+        for (const auto& d : going) {
+            dirs.insert(d);
+            dirs.insert("alt/" + d);
+        }
+        auto inGoing = [&dirs](const std::string& path) {
+            const size_t slash = path.rfind('/');
+            return slash != std::string::npos && dirs.count(path.substr(0, slash)) != 0;
+        };
+        TheLoader().Drop(inGoing);
+        TheLoader().WaitRunning(inGoing);
+        Oot360_RenderWait();
+        // and the HD textures the render thread asked for in the background (libultraship's
+        // Oot360_LoadTextureNoWait), so the eviction finds them; after half a second, those not started are dropped
+        // and those under way finish and stay
+        const size_t texturesLoading =
+            Ship::Context::GetRawInstance()->GetResourceManager()->Oot360_SettleTextureLoads(500);
+        if (texturesLoading != 0) {
+            SPDLOG_INFO("oot360: {} HD textures still loading at the eviction", texturesLoading);
+        }
+        // What goes leaves the interpreter's texture cache with it; the rest stays there.
+        std::vector<std::pair<uintptr_t, uintptr_t>> memory;
+        size_t resources = 0;
+        for (const auto& d : going) {
+            resources += Oot360_Evict(d, memory);
+        }
+        ZeldaMM_TextureCacheDeleteRanges(memory);
+        // This thread's own lookups let what went go now, not after the next scene has loaded on top of it.
+        Oot360_SyncResourceCaches();
+        OOT360_MEM("after evicting");
+        SPDLOG_INFO("oot360: scene {}: {} resources of {} directories evicted in {} ms (free was {} KB)", scene,
+                    resources, evicted, (unsigned)((__builtin_ppc_get_timebase() - evictStart) / 49875), freeBefore);
+    }
+    // The scene's first second and a half, fading in from black: its HD textures go to the GPU then, up to 12 ms a
+    // frame (libultraship's interpreter.cpp; no frame is drawn while this waits below)
+    Oot360_BoostHdImports(90);
+    if ((!CVarGetInteger("gOot360.Prefetch", 1) || Oot360_SafeLevel() > 0)) {
+        return;
+    }
+    // Up to 1.2 s of the black screen: what isn't loaded by then goes on loading behind the first frames, and the
+    // render thread loads what they need itself, a stutter each time (zeldaMM's test 1h: 200-1600 files left at 0.7 s,
+    // frames of 30-540 ms after). The music goes on meanwhile (Oot360_KeepAudioGoing).
+    const uint64_t start = __builtin_ppc_get_timebase();
+    const uint64_t deadline = start + 1200ull * 49875ull;
+    Oot360_Prefetch(sceneDirectory);
+    TheLoader().WaitUntil(deadline, Oot360_KeepAudioGoing);
+    // The rooms are loaded now: their object lists, all of them, loaded too. A room a mod replaces is cached under its
+    // alt/ path alone (the lookup that isn't exact takes that one first), and a room only a mod has is listed under
+    // alt/ alone (review of test 22).
+    auto manager = Ship::Context::GetRawInstance()->GetResourceManager();
+    std::unordered_set<s16> ids;
+    const std::vector<std::string>& plainFiles = FilesOf(scene);
+    std::unordered_set<std::string> rooms(plainFiles.begin(), plainFiles.end());
+    if (manager->IsAltAssetsEnabled()) {
+        for (const auto& f : FilesOf("alt/" + scene)) {
+            rooms.insert(f.substr(4)); // without "alt/"
+        }
+    }
+    for (const auto& f : rooms) {
+        auto res = manager->GetCachedResource(f, false);
+        if (res != nullptr && res->GetInitData()->Type == static_cast<uint32_t>(SOH::ResourceType::SOH_Room)) {
+            Oot360_ListedObjects(std::static_pointer_cast<SOH::Scene>(res), ids, 0);
+        }
+    }
+    for (s16 id : ids) {
+        Oot360_PrefetchObject(id);
+    }
+    const size_t left = TheLoader().WaitUntil(deadline, Oot360_KeepAudioGoing);
+    SPDLOG_INFO("oot360: scene {} and {} objects loaded in {} ms ({} files still loading)", scene, ids.size(),
+                (unsigned)((__builtin_ppc_get_timebase() - start) / 49875), left);
+}
+#endif
