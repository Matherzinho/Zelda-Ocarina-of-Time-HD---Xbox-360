+// The loaders: three threads on the hardware threads nobody else uses (render 1, game 2, audio 4), a queue of files,
+// and a count of what's left that a scene change can wait for.
+struct Loader {
+    static constexpr size_t kThreads = 3;
+    std::mutex mutex;
+    std::condition_variable work, idle;
+    std::deque<std::string> queue;
+    std::string running[kThreads]; // what each thread is loading, empty when none
+    size_t pending = 0;            // queued or being loaded
+    bool started = false;
+
+    void Start() {
+        if (started) {
+            return;
+        }
+        started = true;
+        static const uint32_t kHardwareThreads[kThreads] = { 5, 3, 0 };
+        for (size_t slot = 0; slot < kThreads; slot++) {
+            const uint32_t hw = kHardwareThreads[slot];
+            std::thread([this, hw, slot] {
+                const NTSTATUS moved = xsdk_thread_move(hw);
+                xsdk_log_write("oot360: loader thread on hardware thread %u: 0x%08X", (unsigned)hw, (unsigned)moved);
+                Oot360_MarkBackgroundLoader(); // reads after the game's own threads' (libultraship's O2rArchive.cpp)
+                auto manager = Ship::Context::GetRawInstance()->GetResourceManager();
+                {
+                    std::lock_guard<std::mutex> lock(mutex);
+                    running[slot].reserve(512); // the copy below then never allocates, so never throws
+                }
+                for (;;) {
+                    std::string path;
+                    {
+                        std::unique_lock<std::mutex> lock(mutex);
+                        work.wait(lock, [this] { return !queue.empty(); });
+                        path = std::move(queue.front());
+                        queue.pop_front();
+                        if (path.size() < running[slot].capacity()) {
+                            running[slot] = path;
+                        }
+                    }
+                    // A plain path tries its alt/ one too, so that miss is known ahead. Out of memory (a bad_alloc
+                    // here would end the game, and with pending never back to 0 a scene change would wait for
+                    // good), the file is left to load when the game asks for it.
+                    try {
+                        auto loaded = manager->LoadResource(path);
+                        // A texture that came as its HD version, its N64 one too (a few kilobytes): what a frame past
+                        // its budget for HD imports draws meanwhile (libultraship's Oot360_LoadTextureNoWait), else
+                        // the whole scene's HD textures went in its first frame (zeldaMM's review of test 1i). Not
+                        // for the model mods' objects, which never stand in.
+                        if (loaded != nullptr && !path.starts_with("alt/") && loaded->GetInitData() != nullptr &&
+                            loaded->GetInitData()->Type == static_cast<uint32_t>(Fast::ResourceType::Texture) &&
+                            loaded->GetInitData()->Path.starts_with("alt/") && !Ship::Oot360_TextureNeedsItsOwn(path)) {
+                            loaded.reset();
+                            manager->LoadResourceProcess(path, true);
+                        }
+                    } catch (const std::exception& e) {
+                        SPDLOG_ERROR("oot360: loading {} ahead failed: {}", path, e.what());
+                    } catch (...) {
+                        SPDLOG_ERROR("oot360: loading {} ahead failed", path);
+                    }
+                    {
+                        std::lock_guard<std::mutex> lock(mutex);
+                        running[slot].clear();
+                        --pending;
+                    }
+                    idle.notify_all(); // WaitRunning waits for single files
+                }
+            }).detach();
+        }
+    }
+
+    // Takes out of the queue the files no thread has started that `drop` picks (their directory is about to go).
+    template <typename F> void Drop(F drop) {
+        std::lock_guard<std::mutex> lock(mutex);
+        const size_t before = queue.size();
+        queue.erase(std::remove_if(queue.begin(), queue.end(), drop), queue.end());
+        pending -= before - queue.size();
+        if (pending == 0) {
+            idle.notify_all();
+        }
+    }
+
+    // Waits until no thread is loading a file `which` picks.
+    template <typename F> void WaitRunning(F which) {
+        std::unique_lock<std::mutex> lock(mutex);
+        idle.wait(lock, [&] {
+            for (const std::string& r : running) {
+                if (!r.empty() && which(r)) {
+                    return false;
+                }
+            }
+            return true;
+        });
+    }
+
+    void Add(const std::vector<std::string>& files) {
+        if (files.empty()) {
+            return;
+        }
+        Start();
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            for (const auto& f : files) {
+                queue.push_back(f);
+            }
+            pending += files.size();
+        }
+        work.notify_all();
+    }
+
+    // Waits until everything queued so far has loaded, up to a deadline (timebase ticks); what's left then.
+    // tick, if given, runs at least every 16 ms of the wait (and as files finish), outside the lock (the audio,
+    // Oot360_KeepAudioGoing: cheap while the sound card's queue is full)
+    size_t WaitUntil(uint64_t deadline, void (*tick)(void) = nullptr) {
+        std::unique_lock<std::mutex> lock(mutex);
+        while (pending != 0) {
+            const uint64_t now = __builtin_ppc_get_timebase();
+            if (now >= deadline) {
+                break;
+            }
+            const uint64_t until = tick != nullptr ? std::min(deadline, now + 16ull * 49875ull) : deadline;
+            idle.wait_for(lock, std::chrono::microseconds((until - now) * 1000 / 49875));
+            if (tick != nullptr && pending != 0) {
+                lock.unlock();
+                tick();
+                lock.lock();
+            }
+        }
+        return pending;
+    }
+};
+
+Loader& TheLoader() {
+    static Loader* loader = new Loader(); // lives as long as the game: its threads never end
+    return *loader;
+}
